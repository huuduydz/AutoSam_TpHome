        print(f"[{C}4{RESET}] Thoát")
        
        try:
            fix_tty()
            choice = input(f"\n{M}HuDy > {RESET}").strip()
        except EOFError:
            fix_tty()
            continue
        
        if choice == '1': select_package_menu()
        elif choice == '2': settings_menu()
        elif choice == '3': start_auto_rejoin()
        elif choice == '4': 
