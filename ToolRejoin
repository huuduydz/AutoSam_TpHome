def is_app_running(pkg):
    """Kiểm tra nhanh process của package.
    Dùng _check_pkg_alive_once() — scope đúng pkg, không gây check chéo.
    None (timeout) → coi là đang chạy để tránh false restart."""
    r = _check_pkg_alive_once(pkg)
    return r is not False  # True hoặc None → còn sống

def monitor_package(pkg, states, last_ok_ping, stop_event):
    """Thread độc lập cho từng package - phát hiện Disconnect tức thì & kiểm tra mạng."""
    global kill_all_time, last_restart_time, CLAIMED_NAMES
    while not stop_event.is_set():
        try:
            current_time = time.time()
            state = states[pkg]
            session_uptime = current_time - state['session_start_time']

            # === KIỂM TRA KẾT NỐI MẠNG ===
            if not is_network_available():
                state['text'] = "Mất Mạng (Chờ Wifi/4G...)"
                state['color'] = R
                stop_event.wait(5)
                continue

            # === KIỂM TRA ĐANG TRONG TIẾN TRÌNH BOOT ===
            if pkg in _boot_threads and _boot_threads[pkg].is_alive():
                state['text'] = "Đang Khởi Động..."
                state['color'] = Y
                stop_event.wait(3)
                continue

            # === KIỂM TRA PROCESS CÒN SỐNG KHÔNG ===
            if not is_app_running(pkg):
                state['text'] = "Chờ Watchdog..."
                state['color'] = Y
                stop_event.wait(5)
                continue

            # === AUTO RESTART THEO THỜI GIAN (dùng session_uptime) ===
            if kill_all_time > 0 and session_uptime / 60 >= kill_all_time:
                with pkg_restart_locks[pkg]:
                    force_restart_app(pkg, states, current_time, f"Auto Restart ({kill_all_time}m)", M, ignore_cooldown=True)
                state['session_start_time'] = current_time
                last_ok_ping[pkg] = current_time
                stop_event.wait(5)
                continue

            # === TÌM TÊN NẾU CHƯA BIND ===
            if not state['bound_name']:
                found = discover_unbound_account(pkg, states)
                if found:
                    state['bound_name'] = found
                    state['display_name'] = found

            bound = state['bound_name']
            last_r = last_restart_time.get(pkg, state['rejoin_time'])
            elapsed = current_time - last_r

            # === CHƯA BIND ĐƯỢC TÊN ===
            if not bound:
                if elapsed >= 180:
                    with pkg_restart_locks[pkg]:
                        if is_app_running(pkg):
                            rejoin_in_game(pkg, states, current_time, "Chưa Load → Rejoin!", R)
                        else:
                            force_restart_app(pkg, states, current_time, "Pip tắt → Bật lại!", R, ignore_cooldown=True)
                    last_ok_ping[pkg] = current_time
                else:
                    wait_sec = int(180 - elapsed)
                    state['text'] = f"Đang Nạp Data ({wait_sec}s)"
                    state['color'] = Y
                stop_event.wait(5)
                continue

            # === CHECK HEARTBEAT & JSON DATA ===
            hb_data = get_heartbeat_data(bound, pkg)
            if not hb_data:
                state['heartbeat_misses'] = state.get('heartbeat_misses', 0) + 1
                misses = state['heartbeat_misses']
                if misses >= 3:
                    if elapsed >= 180:
                        with pkg_restart_locks[pkg]:
                            if is_app_running(pkg):
                                rejoin_in_game(pkg, states, current_time, "Treo Màn → Rejoin!", R)
                            else:
                                force_restart_app(pkg, states, current_time, "Pip tắt → Bật lại!", R, ignore_cooldown=True)
                        last_ok_ping[pkg] = current_time
                        state['heartbeat_misses'] = 0
                    else:
                        wait_sec = int(180 - elapsed)
                        state['text'] = f"Mất HB - Chờ ({wait_sec}s)"
                        state['color'] = R
                else:
                    state['text'] = f"Mất HB ({misses}/3 lần)..."
                    state['color'] = Y
            else:
                state['heartbeat_misses'] = 0  # Reset khi có heartbeat
                last_ping = hb_data.get('timestamp', 0)
                status = hb_data.get('status', 'farming')
                err_code = hb_data.get('errorCode', 0)
                job_id = hb_data.get('jobId', '')
                place_id = hb_data.get('placeId', '')

                # 1) BẮT LỖI DISCONNECT TỨC THÌ (<3s)
                if status == "disconnected" or err_code > 0:
                    with pkg_restart_locks[pkg]:
                        rejoin_in_game(pkg, states, current_time, f"Bắt Lỗi ({err_code}) → Rejoin!", R, place_id=place_id, job_id=job_id)
                    last_ok_ping[pkg] = current_time
                    stop_event.wait(5)
                    continue

                diff = current_time - last_ping
                if diff <= 120:
                    last_ok_ping[pkg] = current_time
                real_diff = current_time - last_ok_ping.get(pkg, current_time)

                if diff > 120 or real_diff >= 120:
                    if elapsed >= 180:
                        with pkg_restart_locks[pkg]:
                            if is_app_running(pkg):
                                rejoin_in_game(pkg, states, current_time, f"Văng Game ({int(diff)}s)", R, place_id=place_id, job_id=job_id)
                            else:
                                force_restart_app(pkg, states, current_time, "Pip tắt → Bật lại!", R, ignore_cooldown=True)
                        last_ok_ping[pkg] = current_time
                    else:
                        wait_sec = int(180 - elapsed)
                        state['text'] = f"Văng Game - Chờ ({wait_sec}s)"
                        state['color'] = R
                else:
                    state['text'] = f"Đang Farm ({int(diff)}s trước)"
                    state['color'] = G
        except Exception as e:
            try:
                states[pkg]['text'] = f"Lỗi ({str(e)[:15]})"
                states[pkg]['color'] = R
            except:
                pass
        stop_event.wait(5)


