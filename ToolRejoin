# MAIN
# =====================================================================
def main():
    fix_tty()
    while True:
        clear_screen()
        print_banner()
        print(f"[{C}1{RESET}] Quét và Chọn Package Roblox")
        print(f"[{C}2{RESET}] Cài đặt Game ID & Time Kill All")
        print(f"[{C}3{RESET}] Bắt đầu Auto Rejoin (Live Dashboard)")
        print(f"[{C}4{RESET}] Login via Cookie (Nạp trực tiếp vào App)")
        print(f"[{C}5{RESET}] Thoát")
        try:
            fix_tty()
            choice = input(f"\n{M}HuDy > {RESET}").strip()
        except EOFError:
            fix_tty()
            continue
        if choice == '1':
            select_package_menu()
        elif choice == '2':
            settings_menu()
        elif choice == '3':
            start_auto_rejoin()
        elif choice == '4':
            login_via_cookie()
        elif choice == '5':
            clear_screen()
            print(f"{G}Tạm biệt!{RESET}")
            fix_tty()
            break

if __name__ == "__main__":
    fix_tty()
    main()
