def force_restart_app(pkg, states, current_time, reason, color):
    global last_restart_time
    if pkg in last_restart_time and current_time - last_restart_time[pkg] < 180:
        return
    last_restart_time[pkg] = current_time

    states[pkg]['text'] = reason
    states[pkg]['color'] = color
    safe_root(f"su -c 'am force-stop {pkg}'")
    bound_name = states[pkg].get('bound_name')
    if bound_name:
        safe_root(f"su -c 'find /sdcard -type f -name \"*_{bound_name}_checkhudyhub.json\" -delete 2>/dev/null'")
        if pkg in json_path_cache and bound_name in json_path_cache[pkg]:
            del json_path_cache[pkg][bound_name]
        if pkg in heartbeat_last_check and bound_name in heartbeat_last_check[pkg]:
            del heartbeat_last_check[pkg][bound_name]
        CLAIMED_NAMES.discard(bound_name)
    time.sleep(0.5)
    trigger_boot_step_1(pkg)
    time.sleep(2)
    trigger_boot_step_2(pkg)  # bắn deep link ngay
    states[pkg]['rejoin_time'] = current_time
    states[pkg]['warmup_until'] = current_time + 60

