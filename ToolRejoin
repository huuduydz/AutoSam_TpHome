        res_cp = subprocess.run(f"su -c 'cp \"{webview_db}\" \"{local_db}\" && chmod 666 \"{local_db}\"'", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        if not os.path.exists(local_db):
            continue

        try:
            conn = sqlite3.connect(local_db)
            c = conn.cursor()
            c.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='cookies'")
            if not c.fetchone():
                conn.close()
                os.remove(local_db)
                continue

            c.execute("PRAGMA table_info(cookies)")
            columns = [col[1] for col in c.fetchall()]

            # Epoch 1601 của Chromium (Microseconds kể từ 1601-01-01 UTC)
            now_epoch_1601 = (int(time.time()) + 11644473600) * 1000000
            expires_epoch_1601 = (int(time.time()) + 10 * 365 * 86400 + 11644473600) * 1000000

            # Các host keys phổ biến
            hosts = ['.roblox.com', 'www.roblox.com', 'roblox.com', '.www.roblox.com']
            for hk in hosts:
                data = {
                    'creation_utc': now_epoch_1601,
                    'top_frame_site_key': 'https://roblox.com',
                    'host_key': hk,
                    'name': '.ROBLOSECURITY',
                    'value': cookie,
                    'encrypted_value': b'',
                    'path': '/',
                    'expires_utc': expires_epoch_1601,
                    'is_secure': 1,
                    'is_httponly': 1,
                    'last_access_utc': now_epoch_1601,
                    'has_expires': 1,
                    'is_persistent': 1,
                    'priority': 1,
                    'samesite': -1,
                    'source_scheme': 2,
                    'source_port': 443,
                    'is_same_party': 0
                }
                cols = [k for k in data if k in columns]
                values = [data[k] for k in cols]
                placeholders = ','.join(['?' for _ in cols])
                c.execute("DELETE FROM cookies WHERE (host_key=? OR host_key=? OR host_key=?) AND name=?", (hk, hk.lstrip('.'), '.' + hk.lstrip('.'), '.ROBLOSECURITY'))
                sql = f"INSERT INTO cookies ({','.join(cols)}) VALUES ({placeholders})"
                c.execute(sql, values)
            
            conn.commit()
            conn.close()

            # Chép đè DB đã inject trở lại + xóa file WAL/journal cũ + chown + chmod
            cmd_return = (
                f"su -c 'cp \"{local_db}\" \"{webview_db}\" && "
                f"rm -f \"{webview_db}-wal\" \"{webview_db}-shm\" \"{webview_db}-journal\" 2>/dev/null || true && "
                f"chown {uid}:{uid} \"{webview_db}\" && "
                f"chmod 660 \"{webview_db}\" && "
                f"restorecon \"{webview_db}\" 2>/dev/null || true'"
            )
            subprocess.run(cmd_return, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            os.remove(local_db)
            print(f"{G}    ├─ [✓] DB: {os.path.basename(os.path.dirname(webview_db))}/{os.path.basename(webview_db)}{RESET}")
            success_count += 1
        except Exception as e:
            try: conn.close()
            except: pass
            try: os.remove(local_db)
            except: pass
            print(f"{Y}    ├─ [!] Lỗi nạp DB ({os.path.basename(webview_db)}): {str(e)[:50]}{RESET}")

    return success_count > 0

def inject_cookie_safe_xml(pkg, cookie, user_name=None, user_id=None):
    shared_prefs_dir = f"/data/data/{pkg}/shared_prefs"
    try:
        files_str = subprocess.check_output(f"su -c 'ls {shared_prefs_dir}/*.xml 2>/dev/null'", shell=True, text=True, timeout=5).strip()
    except:
        return False
    if not files_str:
        return False

    xml_files = files_str.splitlines()
    uid = "10000"
    try:
        uid = subprocess.check_output(f"su -c 'stat -c %u /data/data/{pkg}'", shell=True, text=True, timeout=5).strip()
    except:
        pass

    success_count = 0
    for xml_path in xml_files:
        xml_path = xml_path.strip()
        if not xml_path:
            continue
        try:
            raw = subprocess.check_output(f"su -c 'cat \"{xml_path}\" 2>/dev/null'", shell=True, text=True, timeout=5)
        except:
            continue
        if '<map>' not in raw:
            continue

        # Ưu tiên các file XML chính: <package_name>_preferences.xml, APPS_FLYER_SHARED_PREFS, gms, locale và các file chứa token
        xml_name = os.path.basename(xml_path).lower()
        is_target_xml = (
            f"{pkg.lower()}_preferences.xml" in xml_name or
            "preferences.xml" in xml_name or
            any(k in xml_name for k in ['roblox', 'auth', 'user', 'session', 'token', 'datastore', 'app', 'gms', 'locale', 'rate_me']) or
            ('RobloxSecurityToken' in raw or 'ROBLOSECURITY' in raw)
        )
        if not is_target_xml:
            continue

        existing = {}
        try:
            root_el = ET.fromstring(raw)
            for string_tag in root_el.findall('string'):
                key = string_tag.get('name')
                if key:
                    existing[key] = string_tag.text
        except:
            pass

        # Ghi các key Token bảo mật chính
        existing['RobloxSecurityToken'] = cookie
        existing['ROBLOSECURITY'] = cookie
        existing['.ROBLOSECURITY'] = cookie

        if user_id:
            existing['RBX_USER_ID'] = str(user_id)
            existing['UserId'] = str(user_id)
            existing['userId'] = str(user_id)
            existing['RobloxUserId'] = str(user_id)
        if user_name:
            existing['RBX_USERNAME'] = str(user_name)
            existing['Username'] = str(user_name)
            existing['RobloxUsername'] = str(user_name)

        new_root = ET.Element('map')
        for k, v in existing.items():
            el = ET.SubElement(new_root, 'string', name=k)
            el.text = v if v is not None else ""

        xml_output = '<?xml version="1.0" encoding="utf-8" standalone="yes" ?>\n' + ET.tostring(new_root, encoding='unicode')
        tmp_dir = os.path.join(os.environ.get('HOME', '/data/data/com.termux/files/home'), 'tmp')
        os.makedirs(tmp_dir, exist_ok=True)
        fd, temp_file = tempfile.mkstemp(suffix='.xml', prefix='cookie_', dir=tmp_dir)
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(xml_output)

        cmd_xml = (
            f"su -c 'cp \"{temp_file}\" \"{xml_path}\" && "
            f"chown {uid}:{uid} \"{xml_path}\" && "
            f"chmod 660 \"{xml_path}\" && "
            f"restorecon \"{xml_path}\" 2>/dev/null || true'"
        )
        subprocess.run(cmd_xml, shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.remove(temp_file)
        print(f"{G}    ├─ [✓] XML: {os.path.basename(xml_path)}{RESET}")
        success_count += 1

    return success_count > 0

