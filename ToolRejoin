    def get_auth_ticket(self) -> tuple[str, str]:
        """Tạo Auth Ticket từ Roblox API server thông qua Cookie .ROBLOSECURITY."""
        url = "https://auth.roblox.com/v1/authentication-ticket/"
        headers = {
            "Cookie": f".ROBLOSECURITY={self.cookie}",
            "Referer": "https://www.roblox.com/",
            "Content-Type": "application/json",
            "User-Agent": "Roblox/WinInet"
        }
        csrf_token = ""
        req1 = urllib.request.Request(url, data=b"{}", headers=headers, method="POST")
        try:
            with urllib.request.urlopen(req1, timeout=10) as resp:
                pass
        except urllib.error.HTTPError as e:
            if e.code == 403:
                csrf_token = e.headers.get("x-csrf-token", "")
            else:
                return "", f"Lỗi HTTP {e.code}"
        except Exception as e:
            return "", str(e)

        if not csrf_token:
            return "", "Không có CSRF Token"

        headers["X-CSRF-TOKEN"] = csrf_token
        req2 = urllib.request.Request(url, data=b"{}", headers=headers, method="POST")
        try:
            with urllib.request.urlopen(req2, timeout=10) as resp:
                ticket = resp.headers.get("rbx-authentication-ticket", "")
                if ticket:
                    return ticket, ""
                data = json.loads(resp.read().decode('utf-8'))
                return data.get("authTicket", ""), ""
        except urllib.error.HTTPError as e:
            ticket = e.headers.get("rbx-authentication-ticket", "")
            if ticket:
                return ticket, ""
            return "", f"Lỗi HTTP {e.code}"
        except Exception as e:
            return "", str(e)

