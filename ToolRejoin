def find_latest_json(acc_name):
    # Chỉ tìm trong thư mục workspace của các bản Roblox thông dụng
    search_paths = [
        f"/sdcard/Android/media/*/*/workspace/rj_{acc_name}_checkhudyhub.json",
        f"/sdcard/Android/data/*/files/workspace/rj_{acc_name}_checkhudyhub.json",
        f"/sdcard/*/workspace/rj_{acc_name}_checkhudyhub.json"   # cho bản mod
    ]
    best = None
    best_mtime = 0
    for path in search_paths:
        for f in glob.glob(path):
            try:
                mtime = os.path.getmtime(f)
                if mtime > best_mtime:
                    best_mtime = mtime
                    best = f
            except:
                pass
    if best:
        return best, best_mtime
    return None, -1

def get_heartbeat(acc_name):
    global json_path_cache, heartbeat_last_check
    now = time.time()
    # Nếu đã có cache và file vẫn tồn tại, kiểm tra mỗi 15 giây
    if acc_name in json_path_cache:
        cached_path, cached_mtime = json_path_cache[acc_name]
        if os.path.exists(cached_path):
            if now - heartbeat_last_check.get(acc_name, 0) < 15:
                return cached_mtime
            try:
                mtime = os.path.getmtime(cached_path)
                json_path_cache[acc_name] = (cached_path, mtime)
                heartbeat_last_check[acc_name] = now
                return mtime
            except:
                pass
        # File mất, xóa cache
        del json_path_cache[acc_name]

    # Tìm mới (chỉ khi không có cache hoặc file mất)
    best_file, best_mtime = find_latest_json(acc_name)
    if best_file:
        json_path_cache[acc_name] = (best_file, best_mtime)
        heartbeat_last_check[acc_name] = now
        return best_mtime
    return -1

def discover_unbound_account():
    # Duyệt qua tất cả file JSON mới (không quét lại nếu không cần)
    global CLAIMED_NAMES
    search_patterns = [
        "/sdcard/Android/media/*/*/workspace/rj_*_checkhudyhub.json",
        "/sdcard/Android/data/*/files/workspace/rj_*_checkhudyhub.json",
        "/sdcard/*/workspace/rj_*_checkhudyhub.json"
    ]
    candidates = []
    for pattern in search_patterns:
        for f in glob.glob(pattern):
            try:
                mtime = os.path.getmtime(f)
                if time.time() - mtime < 150:
                    name = os.path.basename(f).split('_')[1]  # rj_NAME_checkhudyhub.json
                    candidates.append((name, mtime, f))
            except:
                pass
    # Lọc trùng, chọn mới nhất
    candidates.sort(key=lambda x: x[1], reverse=True)
    seen = set()
    for name, _, _ in candidates:
        if name not in CLAIMED_NAMES and name not in seen:
            CLAIMED_NAMES.add(name)
            return name
    return None

