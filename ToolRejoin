def login_via_cookie():
    """Ép đăng nhập Roblox bằng Cookie (Yêu Cầu Root)"""
    global selected_package
    if not selected_package:
        print(f"{R}[!] Bạn phải chọn Package ở mục [1] trước!{RESET}")
        time.sleep(2)
        return

    print(f"\n{C}--- ĐĂNG NHẬP BẰNG COOKIE ---{RESET}")
    print(f"{Y}Lưu ý: Tính năng này yêu cầu máy ĐÃ ROOT (Magisk/KernelSU).{RESET}")
    cookie = input(f"{M}Nhập Cookie Roblox (_|WARNING...): {RESET}").strip()

    if not cookie.startswith("_|WARNING"):
        print(f"{R}[!] Cookie không hợp lệ! (Phải bắt đầu bằng _|WARNING){RESET}")
        time.sleep(2)
        return

    print(f"{C}[*] Đang tạo cấu hình XML...{RESET}")
    # Định dạng chuẩn của file lưu cookie Roblox trên Android
    xml_content = f"""<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<map>
    <string name="ROBLOSECURITY">{cookie}</string>
</map>"""

    # Ghi ra thẻ nhớ trước khi dùng root đẩy vào hệ thống
    temp_file = "/sdcard/Download/temp_roblox_cookie.xml"
    try:
        with open(temp_file, "w", encoding="utf-8") as f:
            f.write(xml_content)
    except Exception as e:
        print(f"{R}[!] Lỗi tạo file tạm: {e}{RESET}")
        time.sleep(2)
        return

    print(f"{Y}[*] Đang Inject Cookie vào {selected_package}... (Vui lòng bấm Cho Phép Root nếu hiện bảng){RESET}")

    # Chuỗi lệnh bash chạy dưới quyền ROOT (su -c)
    # Không dùng "pm clear" để giữ lại quyền Storage và setting của Executor
    root_cmd = f"""su -c "
    am force-stop {selected_package}
    
    # Tạo thư mục nếu chưa có và copy file cấu hình vào
    mkdir -p /data/data/{selected_package}/shared_prefs/
    cp {temp_file} /data/data/{selected_package}/shared_prefs/com.roblox.client_preferences.xml
    
    # Set quyền đọc ghi chuẩn xác
    chmod 660 /data/data/{selected_package}/shared_prefs/com.roblox.client_preferences.xml
    
    # Lấy UID của App và cấp quyền sở hữu (chown) để Roblox không bị crash khi đọc file
    PKG_UID=\\$(dumpsys package {selected_package} | grep userId= | head -n 1 | cut -d'=' -f2 | cut -d' ' -f1)
    chown \\$PKG_UID:\\$PKG_UID /data/data/{selected_package}/shared_prefs/com.roblox.client_preferences.xml
    
    # Dọn dẹp rác
    rm {temp_file}
    " """

    # Thực thi Inject
    os.system(root_cmd)
    
    print(f"{G}[+] Inject Cookie hoàn tất! Đang mở lại game để kiểm tra...{RESET}")
    os.system(f"su -c 'am start -n {selected_package}/com.roblox.client.Activity > /dev/null 2>&1'")
    time.sleep(3)

def check_heartbeat():
    search_paths = [
        "/sdcard/Android/media/*/workspace/*_checkhudyhub.json",
        "/sdcard/Android/data/*/files/workspace/*_checkhudyhub.json",
        "/sdcard/Download/*_checkhudyhub.json"
    ]
    
    files = []
    for path in search_paths:
        files.extend(glob.glob(path))
        
    if not files:
        return False, "Không tìm thấy file Heartbeat (Bạn đã chạy script Lua trong game chưa?)"
        
    latest_file = max(files, key=os.path.getmtime)
    last_mod_time = os.path.getmtime(latest_file)
    current_time = time.time()
    
    diff = current_time - last_mod_time
    
    if diff > 45:
        return False, f"Game bị đứng hoặc văng! (Mất nhịp tim {int(diff)} giây trước)"
    
    return True, f"Hoạt động ổn định (Heartbeat cách đây {int(diff)}s)"

def start_auto_rejoin():
    global selected_package
    if not selected_package:
        print(f"{R}[!] Bạn phải chọn Package ở mục [1] trước!{RESET}")
        time.sleep(2)
        return

    print(f"\n{Y}[*] Khởi động HuDy Auto Rejoin...{RESET}")
    print(f"{C}[*] Bấm Ctrl + C để dừng.{RESET}")
    
    print(f"{G}[+] Đang khởi động Roblox...{RESET}")
    os.system(f"am force-stop {selected_package} > /dev/null 2>&1")
    time.sleep(2)
    os.system(f"am start -n {selected_package}/com.roblox.client.Activity > /dev/null 2>&1")
    
    while True:
        try:
            time.sleep(15)
            is_alive, msg = check_heartbeat()
            current_time_str = datetime.now().strftime("%H:%M:%S")
            
            if is_alive:
                print(f"[{current_time_str}] {G}{msg}{RESET}")
            else:
                print(f"[{current_time_str}] {R}{msg}{RESET}")
                print(f"[{current_time_str}] {Y}[*] Đang tiến hành Rejoin...{RESET}")
                
                os.system(f"am force-stop {selected_package} > /dev/null 2>&1")
                time.sleep(3) 
                os.system(f"am start -n {selected_package}/com.roblox.client.Activity > /dev/null 2>&1")
                
                print(f"[{current_time_str}] {C}[*] Đã mở lại. Đang chờ 60s để game load...{RESET}")
                time.sleep(60)

        except KeyboardInterrupt:
            print(f"\n{R}[!] Đã dừng Auto Rejoin.{RESET}")
            time.sleep(1)
            break
        except Exception as e:
            print(f"{R}[!] Lỗi hệ thống: {e}{RESET}")
            time.sleep(5)

