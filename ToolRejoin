class RootRobloxCookieInjector:
    """Class xử lý tiêm Cookie .ROBLOSECURITY trực tiếp vào SQLite WebView DB với quyền ROOT."""
    def __init__(self, cookie: str, package_name: str = "com.roblox.client"):
        self.cookie = cookie.strip().replace('\r', '').replace('\n', '')
        self.package_name = package_name
