def start_auto_rejoin():
    global selected_packages, kill_all_time, json_path_cache
    if not selected_packages:
        print(f"{R}[!] Phải chọn Package ở mục [1] trước!{RESET}"); time.sleep(2); return

    print(f"\n{Y}[*] Đang Inject Universal Script cho các Package...{RESET}")
    inject_universal_lua()
    
    states = {}
    current_time = time.time()
    for item in selected_packages:
        pkg = item['pkg']
        states[pkg] = {
            'text': 'Đang Mở Sảnh...',
            'color': Y,
            'boot_phase': 0,
            'boot_timer': current_time,
            'rejoin_time': current_time,
            'bound_name': item['name'] if item['name'] else None,
            'display_name': item['name'] if item['name'] else 'Chờ Auto-Bind...'
        }
        force_restart_app(pkg, states, current_time, 'Đang Mở Sảnh...', Y)

    os.system("stty sane < /dev/tty > /dev/null 2>&1")

    while True:
        try:
            current_time = time.time()
            
            for item in selected_packages:
                pkg = item['pkg']
                uptime_seconds = current_time - states[pkg]['rejoin_time']
                
                if states[pkg]['boot_phase'] == 1:
                    elapsed_boot = current_time - states[pkg]['boot_timer']
                    if elapsed_boot >= 30:
                        trigger_boot_step_2(pkg)
                        states[pkg]['boot_phase'] = 0 
                    else:
                        states[pkg]['text'] = f"Đang Nạp Game ({int(30 - elapsed_boot)}s)"
                        states[pkg]['color'] = M
                    continue 
                
                uptime_minutes = uptime_seconds / 60

                if kill_all_time > 0 and uptime_minutes >= kill_all_time:
                    force_restart_app(pkg, states, current_time, f"Auto Restart ({kill_all_time}m)", M)
                    continue

                if not states[pkg]['bound_name']:
                    claimed = [s['bound_name'] for s in states.values() if s['bound_name']]
                    found_name = discover_unbound_account(claimed)
                    if found_name:
                        states[pkg]['bound_name'] = found_name
                        states[pkg]['display_name'] = found_name
                
                bound_name = states[pkg]['bound_name']
                is_in_grace_period = (uptime_seconds < 150)

                if not bound_name:
                    if is_in_grace_period:
                        states[pkg]['text'] = f"Đang Load ({int(150 - uptime_seconds)}s)"
                        states[pkg]['color'] = Y
                    else:
                        force_restart_app(pkg, states, current_time, "Chưa Load/Kẹt Bind!", R)
                    continue

                last_ping = get_heartbeat_data(bound_name)

                if last_ping == -1:
                    if is_in_grace_period: 
                        states[pkg]['text'] = f"Đang Nạp Data ({int(150 - uptime_seconds)}s)"
                        states[pkg]['color'] = Y
                    else:
                        force_restart_app(pkg, states, current_time, "Treo Màn/Chưa Vô Game!", R)
                else:
                    diff = current_time - last_ping
                    if diff > 45: 
                        if is_in_grace_period:
                            states[pkg]['text'] = f"Vào Server... ({int(150 - uptime_seconds)}s)"
                            states[pkg]['color'] = Y
                        else:
                            force_restart_app(pkg, states, current_time, f"Văng Game ({int(diff)}s)", R)
                    else:
                        states[pkg]['text'] = f"Đang Farm ({int(diff)}s trước)"
                        states[pkg]['color'] = G

            clear_screen()
            print_banner()
            print(f"{C}{'INGAME NAME':<15} | {'PACKAGE INFO':<15} | {'TÌNH TRẠNG HIỆN TẠI':<25}{RESET}")
            print("-" * 65)
            
            for item in selected_packages:
                pkg = item['pkg']
                s_name = states[pkg]['display_name']
                if len(s_name) > 14: s_name = s_name[:11] + "..."
                s_pkg = pkg.split('.')[-1]
                if len(s_pkg) > 14: s_pkg = s_pkg[:11] + "..."
                
                txt = states[pkg]['text']
                col = states[pkg]['color']
                print(f"{s_name:<15} | {s_pkg:<15} | {col}{txt:<25}{RESET}")
            
            print("-" * 65)
            print(f"{C} Đang chạy Live... (Bấm Ctrl + C để dừng){RESET}")
            
            time.sleep(3)

        except KeyboardInterrupt:
            print(f"\n{R}[!] Đã dừng Auto Rejoin.{RESET}")
            fix_tty()
            break
        except Exception as e:
            time.sleep(3)

