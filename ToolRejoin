def get_auth_ticket(cookie):
    """Tạo Authentication Ticket từ Cookie Roblox để đăng nhập trực tiếp vào Native App."""
    try:
        # Bước 1: Lấy X-CSRF-TOKEN
        req = urllib.request.Request(
            "https://auth.roblox.com/v1/authentication-ticket/",
            data=b"{}",
            headers={
                "Cookie": f".ROBLOSECURITY={cookie}",
                "Content-Type": "application/json",
                "Referer": "https://www.roblox.com/"
            },
            method="POST"
        )
        csrf_token = None
        try:
            with urllib.request.urlopen(req, timeout=5) as resp:
                csrf_token = resp.headers.get("x-csrf-token")
        except urllib.error.HTTPError as e:
            if e.code == 403:
                csrf_token = e.headers.get("x-csrf-token")
        
        if not csrf_token:
            return None, "Không lấy được X-CSRF-Token"

        # Bước 2: Yêu cầu sinh Auth Ticket
        req2 = urllib.request.Request(
            "https://auth.roblox.com/v1/authentication-ticket/",
            data=b"{}",
            headers={
                "Cookie": f".ROBLOSECURITY={cookie}",
                "Content-Type": "application/json",
                "Referer": "https://www.roblox.com/",
                "x-csrf-token": csrf_token
            },
            method="POST"
        )
        with urllib.request.urlopen(req2, timeout=5) as resp2:
            ticket = resp2.headers.get("rbx-authentication-ticket")
            if ticket:
                return ticket, "Thành công"
    except Exception as e:
        return None, str(e)
    return None, "Không tạo được Auth Ticket"

def verify_roblox_cookie(cookie):
    """Kiểm tra Cookie có sống hay đã bị Roblox khóa/hết hạn qua Roblox API."""
    try:
        req = urllib.request.Request(
            "https://users.roblox.com/v1/users/authenticated",
            headers={
                "Cookie": f".ROBLOSECURITY={cookie}",
                "User-Agent": "Roblox/WinInet"
            }
        )
        with urllib.request.urlopen(req, timeout=8) as response:
            if response.status == 200:
                data = json.loads(response.read().decode('utf-8'))
                return True, data.get('name', 'Unknown'), data.get('id', 0)
    except urllib.error.HTTPError as e:
        if e.code == 401:
            return False, "Cookie đã HẾT HẠN hoặc bị LOG OUT trên Web (401 Unauthorized)", 0
        return False, f"Lỗi HTTP {e.code}", 0
    except Exception as e:
        return False, f"Không thể kiểm tra API (Bỏ qua kiểm tra): {str(e)}", -1
    return False, "Không thể xác thực Cookie", 0

