def inject_lua_autoexec(pkg):
    lua_code = f"""task.wait(5)
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local DisconnectErrors = Enum.ConnectionError.DisconnectErrors.Value
local PlaceLaunchOtherError = Enum.ConnectionError.PlacelaunchOtherError.Value
repeat task.wait() until game:IsLoaded() and Players.LocalPlayer
local LocalPlayer = Players.LocalPlayer
local fileName = "{pkg}_checkhudyhub.json"
local sWF = true
task.spawn(function()
    while sWF do 
        task.wait(3)
        pcall(function()
            local errorCode = GuiService:GetErrorCode().Value
            if errorCode == 1 or errorCode == 773 or errorCode == 772 or errorCode == 769 or (errorCode >= DisconnectErrors and errorCode < PlaceLaunchOtherError) then 
                sWF = false 
            end 
        end)
        if sWF then 
            local pidOk, pid = pcall(function() return game.PlaceId end)
            local humOk, hum = pcall(function() return LocalPlayer.Character.Humanoid end)
            if not (pidOk and pid == 0 and not (humOk and hum)) then 
                pcall(function()
                    writefile(fileName, string.format('{{"playerName":"%s","time":"%s"}}', LocalPlayer.Name, os.date("!%Y-%m-%dT%H:%M:%SZ", workspace:GetServerTimeNow())))
                end)
            end 
        end 
    end 
end)"""
    
    temp_lua = f"/sdcard/Download/temp_lua_{pkg}.lua"
    with open(temp_lua, "w", encoding="utf-8") as f: f.write(lua_code)
        
    root_cmd = f"""su -c "
    DIRS1=\\$(find /sdcard/ -maxdepth 3 -type d -iname '*autoexec*' 2>/dev/null)
    DIRS2=\\$(find /sdcard/Android/media/{pkg} /sdcard/Android/data/{pkg} -type d -iname '*autoexec*' 2>/dev/null)
    for dir in \\$DIRS1 \\$DIRS2; do
        cp {temp_lua} \\"\\$dir/{pkg}_checkhudyhub.lua\\"
        chmod 777 \\"\\$dir/{pkg}_checkhudyhub.lua\\"
    done
    rm {temp_lua}
    " """
    os.system(root_cmd)

def get_heartbeat_data(pkg):
    search_paths = [
        f"/sdcard/Android/media/{pkg}/*/workspace/{pkg}_checkhudyhub.json",
        f"/sdcard/Android/data/{pkg}/*/workspace/{pkg}_checkhudyhub.json",
        f"/sdcard/Android/data/{pkg}/files/workspace/{pkg}_checkhudyhub.json",
        f"/sdcard/Download/{pkg}_checkhudyhub.json",
        f"/sdcard/*/Workspace/{pkg}_checkhudyhub.json", 
        f"/sdcard/*/workspace/{pkg}_checkhudyhub.json"
    ]
    
    files = []
    for path in search_paths:
        files.extend(glob.glob(path))
        
    if not files: return -1, "Chờ Login..."
    latest_file = max(files, key=os.path.getmtime)
    
    player_name = "Chưa load"
    try:
        with open(latest_file, 'r', encoding='utf-8') as f:
            data = json.load(f)
            if "playerName" in data: player_name = data["playerName"]
    except Exception: pass
        
    return os.path.getmtime(latest_file), player_name

def launch_app_root(pkg):
    """Khởi động App qua 2 bước: Làm ấm (để nhận Cookie) -> Bắn DeepLink"""
    
    # Bước 1: Dùng Python thuần bới tìm cổng khởi động chính xác của Clone (Main Activity)
    main_act = ""
    try:
        out = subprocess.check_output(f"su -c 'cmd package resolve-activity --brief {pkg}'", shell=True, text=True, stderr=subprocess.DEVNULL)
        lines = out.strip().split('\n')
        if len(lines) > 0 and '/' in lines[-1]:
            main_act = lines[-1].strip()
    except Exception:
        pass
        
    # Bước 2: Ép mở App lên sảnh trước để nó tiêu thụ Cookie (Cold Start)
    if main_act:
        os.system(f"su -c 'am start -n {main_act} > /dev/null 2>&1'")
    else:
        os.system(f"su -c 'monkey -p {pkg} -c android.intent.category.LAUNCHER 1 > /dev/null 2>&1'")
        
    # Bước 3: Nếu có cài đặt ID Game, chờ App load Cookie xong mới bắn DeepLink xuyên thẳng vào Map
    if target_place_id:
        # Chờ 4 giây cho game kịp Login bằng Cookie vừa nhét
        time.sleep(4) 
        
        if main_act:
            # Bắn DeepLink đích danh vào cổng chính của bản Clone
            os.system(f"su -c 'am start -n {main_act} -a android.intent.action.VIEW -d \"roblox://placeId={target_place_id}\" > /dev/null 2>&1'")
        else:
            # Dự phòng bằng cờ -p chuẩn của Android
            os.system(f"su -c 'am start -p {pkg} -a android.intent.action.VIEW -d \"roblox://placeId={target_place_id}\" > /dev/null 2>&1'")

def start_auto_rejoin():
    global selected_packages, kill_all_time
    if not selected_packages:
        print(f"{R}[!] Phải chọn Package ở mục [1] trước!{RESET}"); time.sleep(2); return

    print(f"\n{Y}[*] Đang setup Autoexec cho {len(selected_packages)} Package...{RESET}")
    for pkg in selected_packages:
        inject_lua_autoexec(pkg)
        os.system(f"su -c 'am force-stop {pkg} > /dev/null 2>&1'")
        time.sleep(0.5)
        launch_app_root(pkg)
    
    states = {pkg: {'text': 'Đang Mở Game...', 'color': Y, 'rejoin_time': time.time(), 'name': 'Chờ Login...'} for pkg in selected_packages}

    while True:
        try:
            current_time = time.time()
            
            for pkg in selected_packages:
                uptime_seconds = current_time - states[pkg]['rejoin_time']
                uptime_minutes = uptime_seconds / 60

                # 1. TÍNH NĂNG TIME KILL ALL
                if kill_all_time > 0 and uptime_minutes >= kill_all_time:
                    states[pkg]['text'] = f"Auto Restart ({kill_all_time}m)"
                    states[pkg]['color'] = M
                    os.system(f"su -c 'am force-stop {pkg} > /dev/null 2>&1'")
                    time.sleep(1)
                    launch_app_root(pkg)
                    states[pkg]['rejoin_time'] = current_time
                    continue

                # 2. XỬ LÝ HEARTBEAT NHƯ BÌNH THƯỜNG
                if uptime_seconds < 60:
                    states[pkg]['text'] = f"Đang Load ({int(60 - uptime_seconds)}s)"
                    states[pkg]['color'] = Y
                    _, p_name = get_heartbeat_data(pkg)
                    if p_name != "Chờ Login...": states[pkg]['name'] = p_name
                    continue

                last_ping, player_name = get_heartbeat_data(pkg)
                if player_name != "Chờ Login...": states[pkg]['name'] = player_name

                if last_ping == -1:
                    if uptime_seconds > 150: 
                        states[pkg]['text'] = f"Lỗi Load / Treo Màn!"
                        states[pkg]['color'] = R
                        os.system(f"su -c 'am force-stop {pkg} > /dev/null 2>&1'")
                        time.sleep(1)
                        launch_app_root(pkg)
                        states[pkg]['rejoin_time'] = current_time
                    else:
                        states[pkg]['text'] = "Chờ file JSON..."
                        states[pkg]['color'] = C
                else:
                    diff = current_time - last_ping
                    if diff > 45: 
                        states[pkg]['text'] = f"Văng Game ({int(diff)}s)"
                        states[pkg]['color'] = R
                        os.system(f"su -c 'am force-stop {pkg} > /dev/null 2>&1'")
                        time.sleep(1)
                        launch_app_root(pkg)
                        states[pkg]['rejoin_time'] = current_time
                    else:
                        states[pkg]['text'] = f"Đang Farm ({int(diff)}s trước)"
                        states[pkg]['color'] = G

            # --- VẼ KHUNG DASHBOARD ---
            clear_screen()
            print_banner()
            print(f"{C}{'INGAME NAME':<15} | {'PACKAGE INFO':<15} | {'TÌNH TRẠNG HIỆN TẠI':<25}{RESET}")
            print("-" * 65)
            
            for pkg in selected_packages:
                s_name = states[pkg]['name']
                if len(s_name) > 14: s_name = s_name[:11] + "..."
                s_pkg = pkg.split('.')[-1]
                if len(s_pkg) > 14: s_pkg = s_pkg[:11] + "..."
                
                txt = states[pkg]['text']
                col = states[pkg]['color']
                print(f"{s_name:<15} | {s_pkg:<15} | {col}{txt:<25}{RESET}")
            
            print("-" * 65)
            print(f"{C} Đang chạy Live... (Bấm Ctrl + C để dừng){RESET}")
            time.sleep(5)

        except KeyboardInterrupt:
            print(f"\n{R}[!] Đã dừng Auto Rejoin.{RESET}")
            break
        except Exception as e:
            time.sleep(3)

