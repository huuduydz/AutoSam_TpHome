def scan_packages():
    packages = []
    try:
        output = subprocess.check_output("su -c 'pm list packages -3'", shell=True, text=True, stderr=subprocess.DEVNULL)
        for line in output.splitlines():
            if "package:" in line:
                packages.append(line.replace("package:", "").strip())
    except Exception:
        pass

    cleaned_packages = []
    for p in list(set(packages)):
        clean_p = p.replace('\r', '').replace('\n', '').strip()
        if clean_p:
            cleaned_packages.append(clean_p)
    return cleaned_packages

def select_package_menu():
    global selected_packages
    packages = scan_packages()
    
    if not packages:
        print(f"{R}[!] Không tìm thấy app nào!{RESET}"); time.sleep(2); return

    print(f"\n{G}Danh sách Package tìm thấy:{RESET}")
    for i, pkg in enumerate(packages, 1):
        print(f"[{i}] {pkg}")
    
    try:
        print(f"\n{C}💡 Nhập nhiều số cách nhau bởi khoảng trắng (VD: 1 3 5){RESET}")
        choice_str = input(f"{M}Chọn số thứ tự Package: {RESET}")
        
        choices = [int(x) for x in re.findall(r'\d+', choice_str)]
        selected_packages.clear()
        
        for choice in set(choices):
            if 1 <= choice <= len(packages):
                selected_packages.append(packages[choice - 1])
        
        if selected_packages:
            print(f"\n{G}[+] Đã chọn {len(selected_packages)} Package thành công!{RESET}")
            time.sleep(1)
    except Exception:
        pass

def inject_lua_autoexec(pkg):
    lua_code = f"""task.wait(5)
local Players = game:GetService("Players")
local GuiService = game:GetService("GuiService")
local DisconnectErrors = Enum.ConnectionError.DisconnectErrors.Value
local PlaceLaunchOtherError = Enum.ConnectionError.PlacelaunchOtherError.Value
repeat task.wait() until game:IsLoaded() and Players.LocalPlayer
local LocalPlayer = Players.LocalPlayer
local fileName = "{pkg}_checkhudyhub.json"
local sWF = true
task.spawn(function()
    while sWF do 
        task.wait(3)
        pcall(function()
            local errorCode = GuiService:GetErrorCode().Value
            if errorCode == 1 or errorCode == 773 or errorCode == 772 or errorCode == 769 or (errorCode >= DisconnectErrors and errorCode < PlaceLaunchOtherError) then 
                sWF = false 
            end 
        end)
        if sWF then 
            local pidOk, pid = pcall(function() return game.PlaceId end)
            local humOk, hum = pcall(function() return LocalPlayer.Character.Humanoid end)
            if not (pidOk and pid == 0 and not (humOk and hum)) then 
                pcall(function()
                    writefile(fileName, string.format('{{"playerName":"%s","time":"%s"}}', LocalPlayer.Name, os.date("!%Y-%m-%dT%H:%M:%SZ", workspace:GetServerTimeNow())))
                end)
            end 
        end 
    end 
end)"""
    
    temp_lua = f"/sdcard/Download/temp_lua_{pkg}.lua"
    with open(temp_lua, "w", encoding="utf-8") as f: f.write(lua_code)
        
    root_cmd = f"""su -c "
    DIRS1=\\$(find /sdcard/ -maxdepth 3 -type d -iname '*autoexec*' 2>/dev/null)
    DIRS2=\\$(find /sdcard/Android/media/{pkg} /sdcard/Android/data/{pkg} -type d -iname '*autoexec*' 2>/dev/null)
    for dir in \\$DIRS1 \\$DIRS2; do
        cp {temp_lua} \\"\\$dir/{pkg}_checkhudyhub.lua\\"
        chmod 777 \\"\\$dir/{pkg}_checkhudyhub.lua\\"
    done
    rm {temp_lua}
    " """
    os.system(root_cmd)

def get_heartbeat_data(pkg):
    global json_path_cache
    
    # TỐI ƯU 2: Sử dụng Cache đường dẫn. Nếu đã tìm thấy 1 lần, những lần sau bốc thẳng ra đọc, không dùng glob quét ổ cứng nữa.
    if pkg in json_path_cache and os.path.exists(json_path_cache[pkg]):
        latest_file = json_path_cache[pkg]
    else:
        search_paths = [
            f"/sdcard/Android/media/{pkg}/*/workspace/{pkg}_checkhudyhub.json",
            f"/sdcard/Android/data/{pkg}/*/workspace/{pkg}_checkhudyhub.json",
            f"/sdcard/Android/data/{pkg}/files/workspace/{pkg}_checkhudyhub.json",
            f"/sdcard/Download/{pkg}_checkhudyhub.json",
            f"/sdcard/*/Workspace/{pkg}_checkhudyhub.json", 
            f"/sdcard/*/workspace/{pkg}_checkhudyhub.json"
        ]
        files = []
        for path in search_paths: files.extend(glob.glob(path))
        if not files: return -1, "Chờ Load/Login..."
        
        latest_file = max(files, key=os.path.getmtime)
        json_path_cache[pkg] = latest_file  # Lưu vào Cache
    
    player_name = "Chưa load"
    try:
        with open(latest_file, 'r', encoding='utf-8') as f:
            data = json.load(f)
            if "playerName" in data: player_name = data["playerName"]
    except Exception: pass
        
    return os.path.getmtime(latest_file), player_name

def trigger_boot_step_1(pkg):
    """Khởi động bộ khung App (Sảnh)"""
    os.system(f"su -c 'monkey -p {pkg} -c android.intent.category.LAUNCHER 1 > /dev/null 2>&1'")

def trigger_boot_step_2(pkg):
    """Bắn DeepLink (Xuyên thẳng vào Map)"""
    intent_cmd = f"su -c 'am start -p {pkg} -a android.intent.action.VIEW -d \"roblox://experiences/start?placeId={target_place_id}\" > /dev/null 2>&1'"
    os.system(intent_cmd)

def start_auto_rejoin():
    global selected_packages, kill_all_time, json_path_cache
    if not selected_packages:
        print(f"{R}[!] Phải chọn Package ở mục [1] trước!{RESET}"); time.sleep(2); return

    print(f"\n{Y}[*] Đang setup Autoexec cho {len(selected_packages)} Package...{RESET}")
    
    # Cấu trúc States lưu trạng thái khởi động không đồng bộ
    states = {}
    for pkg in selected_packages:
        inject_lua_autoexec(pkg)
        os.system(f"su -c 'am force-stop {pkg} > /dev/null 2>&1'")
        time.sleep(0.3)
        trigger_boot_step_1(pkg)
        
        states[pkg] = {
            'text': 'Đang Mở Sảnh...',
            'color': Y,
            'boot_phase': 1 if target_place_id else 0, # Phase 1: Đang chờ bắn Link | Phase 0: Giám sát bình thường
            'boot_timer': time.time(),
            'rejoin_time': time.time(),
            'name': 'Chờ Load/Login...'
        }

    while True:
        try:
            current_time = time.time()
            
            for pkg in selected_packages:
                # TỐI ƯU 3: CƠ CHẾ XỬ LÝ THEO TỪNG NHỊP (STATE MACHINE) CHỐNG ĐÓNG BĂNG TOOL
                if states[pkg]['boot_phase'] == 1:
                    # Nếu đang ở Phase 1 (Đợi 10s để bắn DeepLink)
                    elapsed_boot = current_time - states[pkg]['boot_timer']
                    if elapsed_boot >= 10:
                        trigger_boot_step_2(pkg)
                        states[pkg]['boot_phase'] = 0 # Hoàn thành khởi động, chuyển về chế độ theo dõi
                        states[pkg]['rejoin_time'] = current_time # Reset thời gian farm
                    else:
                        states[pkg]['text'] = f"Đang Nạp Game ({int(10 - elapsed_boot)}s)"
                        states[pkg]['color'] = M
                    continue # Bỏ qua việc check Nhịp tim trong lúc đang boot để tránh lag
                
                # ---- XỬ LÝ THEO DÕI BÌNH THƯỜNG (PHASE 0) ----
                uptime_seconds = current_time - states[pkg]['rejoin_time']
                uptime_minutes = uptime_seconds / 60

                if kill_all_time > 0 and uptime_minutes >= kill_all_time:
                    states[pkg]['text'] = f"Auto Restart ({kill_all_time}m)"
                    states[pkg]['color'] = M
                    os.system(f"su -c 'am force-stop {pkg} > /dev/null 2>&1'")
                    time.sleep(0.5)
                    trigger_boot_step_1(pkg)
                    states[pkg]['boot_phase'] = 1 if target_place_id else 0
                    states[pkg]['boot_timer'] = current_time
                    continue

                if uptime_seconds < 60:
                    states[pkg]['text'] = f"Đang Load ({int(60 - uptime_seconds)}s)"
                    states[pkg]['color'] = Y
                    _, p_name = get_heartbeat_data(pkg)
                    if p_name != "Chờ Load/Login...": states[pkg]['name'] = p_name
                    continue

                last_ping, player_name = get_heartbeat_data(pkg)
                if player_name != "Chờ Load/Login...": states[pkg]['name'] = player_name

                if last_ping == -1:
                    if uptime_seconds > 180: 
                        states[pkg]['text'] = f"Treo Màn/Chưa Login!"
                        states[pkg]['color'] = R
                        os.system(f"su -c 'am force-stop {pkg} > /dev/null 2>&1'")
                        time.sleep(0.5)
                        trigger_boot_step_1(pkg)
                        states[pkg]['boot_phase'] = 1 if target_place_id else 0
                        states[pkg]['boot_timer'] = current_time
                    else:
                        states[pkg]['text'] = "Chờ file JSON..."
                        states[pkg]['color'] = C
                else:
                    diff = current_time - last_ping
                    if diff > 45: 
                        states[pkg]['text'] = f"Văng Game ({int(diff)}s)"
                        states[pkg]['color'] = R
                        os.system(f"su -c 'am force-stop {pkg} > /dev/null 2>&1'")
                        time.sleep(0.5)
                        trigger_boot_step_1(pkg)
                        states[pkg]['boot_phase'] = 1 if target_place_id else 0
                        states[pkg]['boot_timer'] = current_time
                    else:
                        states[pkg]['text'] = f"Đang Farm ({int(diff)}s trước)"
                        states[pkg]['color'] = G

            # --- VẼ KHUNG DASHBOARD ---
            clear_screen()
            print_banner()
            print(f"{C}{'INGAME NAME':<15} | {'PACKAGE INFO':<15} | {'TÌNH TRẠNG HIỆN TẠI':<25}{RESET}")
            print("-" * 65)
            
            for pkg in selected_packages:
                s_name = states[pkg]['name']
                if len(s_name) > 14: s_name = s_name[:11] + "..."
                s_pkg = pkg.split('.')[-1]
                if len(s_pkg) > 14: s_pkg = s_pkg[:11] + "..."
                
                txt = states[pkg]['text']
                col = states[pkg]['color']
                print(f"{s_name:<15} | {s_pkg:<15} | {col}{txt:<25}{RESET}")
            
            print("-" * 65)
            print(f"{C} Đang chạy Live... (Bấm Ctrl + C để dừng){RESET}")
            
            # Giảm thời gian trễ vòng lặp xuống 3 giây để Bảng ĐH cập nhật mượt hơn
            time.sleep(3)

        except KeyboardInterrupt:
            print(f"\n{R}[!] Đã dừng Auto Rejoin.{RESET}")
            break
        except Exception as e:
            time.sleep(3)

def main():
    while True:
        clear_screen()
        print_banner()
        
        print(f"[{C}1{RESET}] Quét và Chọn Package Roblox")
        print(f"[{C}2{RESET}] Cài đặt Game ID (PlaceID) & Time Kill All")
        print(f"[{C}3{RESET}] Bắt đầu Auto Rejoin (Live Dashboard)")
        print(f"[{C}4{RESET}] Thoát")
        
        choice = input(f"\n{M}HuDy > {RESET}").strip()
        
        if choice == '1': select_package_menu()
        elif choice == '2': settings_menu()
        elif choice == '3': start_auto_rejoin()
        elif choice == '4': 
            clear_screen()
            print(f"{G}Tạm biệt!{RESET}")
            break

if __name__ == "__main__":
    main()
