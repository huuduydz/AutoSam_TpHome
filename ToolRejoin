def get_heartbeat_data(pkg):
    """Đọc file JSON, trả về (Thời gian cập nhật, Tên Nhân Vật)"""
    search_paths = [
        f"/sdcard/Android/media/{pkg}/*/workspace/{pkg}_checkhudyhub.json",
        f"/sdcard/Android/data/{pkg}/*/workspace/{pkg}_checkhudyhub.json",
        f"/sdcard/Android/data/{pkg}/files/workspace/{pkg}_checkhudyhub.json",
        f"/sdcard/Download/{pkg}_checkhudyhub.json",
        # Thêm đường dẫn bao quát cho Delta và các Executor khác ở gốc
        f"/sdcard/*/Workspace/{pkg}_checkhudyhub.json", 
        f"/sdcard/*/workspace/{pkg}_checkhudyhub.json"
    ]
    
    files = []
    for path in search_paths:
        files.extend(glob.glob(path))
        
    if not files: return -1, "Chờ Login..."
    
    latest_file = max(files, key=os.path.getmtime)
    mod_time = os.path.getmtime(latest_file)
    
    # Ép đọc file JSON để bóc tên nhân vật
    player_name = "Chưa load"
    try:
        with open(latest_file, 'r', encoding='utf-8') as f:
            data = json.load(f)
            if "playerName" in data:
                player_name = data["playerName"]
    except Exception:
        pass
        
    return mod_time, player_name

def launch_app_root(pkg):
    """Hàm khởi động app clone an toàn qua Root + Monkey"""
    os.system(f"su -c 'monkey -p {pkg} -c android.intent.category.LAUNCHER 1 > /dev/null 2>&1'")

def start_auto_rejoin():
    global selected_packages
    if not selected_packages:
        print(f"{R}[!] Phải chọn Package ở mục [1] trước!{RESET}"); time.sleep(2); return

    print(f"\n{Y}[*] Đang setup Autoexec cho {len(selected_packages)} Package...{RESET}")
    for pkg in selected_packages:
        inject_lua_autoexec(pkg)
        os.system(f"su -c 'am force-stop {pkg} > /dev/null 2>&1'")
        time.sleep(0.5)
        launch_app_root(pkg)
    
    states = {pkg: {'text': 'Đang Mở Game...', 'color': Y, 'rejoin_time': time.time(), 'name': 'Chờ Login...'} for pkg in selected_packages}

    while True:
        try:
            current_time = time.time()
            
            for pkg in selected_packages:
                if current_time - states[pkg]['rejoin_time'] < 60:
                    states[pkg]['text'] = f"Đang Load ({int(60 - (current_time - states[pkg]['rejoin_time']))}s)"
                    states[pkg]['color'] = Y
                    
                    # Vẫn thử lấy tên acc nếu nó load nhanh hơn 60s
                    _, p_name = get_heartbeat_data(pkg)
                    if p_name != "Chờ Login...": states[pkg]['name'] = p_name
                    continue

                last_ping, player_name = get_heartbeat_data(pkg)
                
                # Cập nhật tên acc nếu lấy được
                if player_name != "Chờ Login...":
                    states[pkg]['name'] = player_name

                if last_ping == -1:
                    diff = current_time - states[pkg]['rejoin_time']
                    if diff > 150: 
                        states[pkg]['text'] = f"Lỗi Load / Treo Màn!"
                        states[pkg]['color'] = R
                        os.system(f"su -c 'am force-stop {pkg} > /dev/null 2>&1'")
                        time.sleep(1)
                        launch_app_root(pkg)
                        states[pkg]['rejoin_time'] = current_time
                    else:
                        states[pkg]['text'] = "Chờ file JSON..."
                        states[pkg]['color'] = C
                else:
                    diff = current_time - last_ping
                    if diff > 45: 
                        states[pkg]['text'] = f"Văng Game ({int(diff)}s)"
                        states[pkg]['color'] = R
                        os.system(f"su -c 'am force-stop {pkg} > /dev/null 2>&1'")
                        time.sleep(1)
                        launch_app_root(pkg)
                        states[pkg]['rejoin_time'] = current_time
                    else:
                        states[pkg]['text'] = f"Đang Farm ({int(diff)}s trước)"
                        states[pkg]['color'] = G

            # --- VẼ KHUNG DASHBOARD 3 CỘT ---
            clear_screen()
            print_banner()
            # Căn chỉnh kích thước cột: Tên(15) | Package(15) | Tình trạng(25)
            print(f"{C}{'INGAME NAME':<15} | {'PACKAGE INFO':<15} | {'TÌNH TRẠNG HIỆN TẠI':<25}{RESET}")
            print("-" * 65)
            
            for pkg in selected_packages:
                # Xử lý cắt chuỗi nếu tên quá dài để bảng không bị vỡ form
                s_name = states[pkg]['name']
                if len(s_name) > 14: s_name = s_name[:11] + "..."
                
                s_pkg = pkg.split('.')[-1]
                if len(s_pkg) > 14: s_pkg = s_pkg[:11] + "..."
                
                txt = states[pkg]['text']
                col = states[pkg]['color']
                print(f"{s_name:<15} | {s_pkg:<15} | {col}{txt:<25}{RESET}")
            
            print("-" * 65)
            print(f"{C} Đang chạy Live... (Bấm Ctrl + C để dừng){RESET}")
            time.sleep(5)

        except KeyboardInterrupt:
            print(f"\n{R}[!] Đã dừng Auto Rejoin.{RESET}")
            break
        except Exception as e:
            time.sleep(3)

