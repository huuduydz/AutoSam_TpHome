    inject_universal_lua()

    states = {}
    now = time.time()
    for item in selected_packages:
        pkg = item['pkg']
        states[pkg] = {
            'text': 'Đang Mở Sảnh...',
            'color': Y,
            'boot_phase': 0,
            'boot_timer': now,
            'rejoin_time': now,
            'bound_name': item['name'] if item['name'] else None,
            'display_name': item['name'] if item['name'] else 'Chờ Auto-Bind...'
        }
        force_restart_app(pkg, states, now, 'Đang Mở Sảnh...', Y)

    os.system("stty sane < /dev/tty > /dev/null 2>&1")

    # Vòng lặp nhẹ
    last_dashboard = 0
    while True:
        try:
            current_time = time.time()
            any_change = False

            for item in selected_packages:
                pkg = item['pkg']
                state = states[pkg]
                uptime_seconds = current_time - state['rejoin_time']

                # Phase 1: chờ bắn deep link
                if state['boot_phase'] == 1:
                    if current_time - state['boot_timer'] >= 30:
                        trigger_boot_step_2(pkg)
                        state['boot_phase'] = 0
                        any_change = True
                    else:
                        new_text = f"Đang Nạp Game ({int(30 - (current_time - state['boot_timer']))}s)"
                        if state['text'] != new_text:
                            state['text'] = new_text
                            state['color'] = M
                            any_change = True
                    continue

                # Auto restart nếu kill_all_time > 0
                if kill_all_time > 0 and uptime_seconds / 60 >= kill_all_time:
                    force_restart_app(pkg, states, current_time, f"Auto Restart ({kill_all_time}m)", M)
                    any_change = True
                    continue

                # Bind tên ingame
                if not state['bound_name']:
                    found = discover_unbound_account()
                    if found:
                        state['bound_name'] = found
                        state['display_name'] = found
                        any_change = True

                bound = state['bound_name']
                is_grace = (uptime_seconds < 150)

                if not bound:
                    if is_grace:
                        new_text = f"Đang Load ({int(150 - uptime_seconds)}s)"
                        if state['text'] != new_text:
                            state['text'] = new_text
                            state['color'] = Y
                            any_change = True
                    else:
                        force_restart_app(pkg, states, current_time, "Chưa Load/Kẹt Bind!", R)
                        any_change = True
                    continue

                # Kiểm tra heartbeat
                last_ping = get_heartbeat(bound)
                if last_ping == -1:
                    if is_grace:
                        new_text = f"Đang Nạp Data ({int(150 - uptime_seconds)}s)"
                        if state['text'] != new_text:
                            state['text'] = new_text
                            state['color'] = Y
                            any_change = True
                    else:
                        force_restart_app(pkg, states, current_time, "Treo Màn/Chưa Vô Game!", R)
                        any_change = True
                else:
                    diff = current_time - last_ping
                    if diff > 45:
                        if is_grace:
                            new_text = f"Vào Server... ({int(150 - uptime_seconds)}s)"
                            if state['text'] != new_text:
                                state['text'] = new_text
                                state['color'] = Y
                                any_change = True
                        else:
                            force_restart_app(pkg, states, current_time, f"Văng Game ({int(diff)}s)", R)
                            any_change = True
                    else:
                        new_text = f"Đang Farm ({int(diff)}s trước)"
                        if state['text'] != new_text:
                            state['text'] = new_text
                            state['color'] = G
                            any_change = True

            # Chỉ vẽ dashboard nếu có thay đổi hoặc sau 30 giây
            if any_change or (current_time - last_dashboard > 30):
                clear_screen()
                print_banner()
                print(f"{C}{'INGAME NAME':<15} | {'PACKAGE INFO':<15} | {'TÌNH TRẠNG HIỆN TẠI':<25}{RESET}")
                print("-" * 65)
                for item in selected_packages:
                    pkg = item['pkg']
                    s_name = states[pkg]['display_name']
                    if len(s_name) > 14: s_name = s_name[:11] + "..."
                    s_pkg = pkg.split('.')[-1]
                    if len(s_pkg) > 14: s_pkg = s_pkg[:11] + "..."
                    txt = states[pkg]['text']
                    col = states[pkg]['color']
                    print(f"{s_name:<15} | {s_pkg:<15} | {col}{txt:<25}{RESET}")
                print("-" * 65)
                print(f"{C} Đang chạy Live... (Ctrl+C để dừng){RESET}")
                last_dashboard = current_time

            time.sleep(10)  # Tăng lên 10 giây để giảm tải CPU

        except KeyboardInterrupt:
            print(f"\n{R}[!] Đã dừng Auto Rejoin.{RESET}")
            fix_tty()
            break
        except Exception as e:
            time.sleep(5)

