_boot_threads = {}   # {pkg: Thread} — track boot threads

def _check_pkg_alive_once(pkg):
    """Kiểm tra chính xác 100% xem process của pkg có đang chạy hay không.
    Loại bỏ hoàn toàn false-positive từ các lệnh shell/grep/rm/find.
    Trả về: True (chắc chắn sống) | False (chắc chắn chết) | None (timeout → tạm coi sống để an toàn)."""
    # 1. Check pidof (Nhanh và chính exact tên process trong kernel)
    try:
        out = subprocess.check_output(
            f"su -c 'pidof {pkg} 2>/dev/null'",
            shell=True, text=True, timeout=2,
            stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        ).strip()
        if out and any(p.isdigit() for p in out.split()):
            return True
    except subprocess.TimeoutExpired:
        return None
    except:
        pass

    # 2. Check qua _pgrep_pkg (Quét /proc/[0-9]*/cmdline loại bỏ lệnh shell phụ)
    try:
        pids = _pgrep_pkg(pkg, timeout=3)
        if pids:
            return True
        return False
    except subprocess.TimeoutExpired:
        return None
    except:
        return False

def _is_pkg_alive_confirmed(pkg, votes=2, interval=3.0):
    """Kiểm tra pkg có thực sự chết không bằng cách vote nhiều lần.
    Chỉ trả về False (chết) nếu `votes` lần liên tiếp đều báo chết.
    Trả về True ngay khi 1 lần thấy sống (tránh false-negative).
    Nếu có timeout thì coi là sống (an toàn hơn là restart nhầm)."""
    dead_count = 0
    for i in range(votes):
        result = _check_pkg_alive_once(pkg)
        if result is True or result is None:
            return True   # Sống hoặc không chắc → dừng sớm (coi là sống)
        else:
            dead_count += 1
        if i < votes - 1:
            time.sleep(interval)
    return dead_count < votes  # Nếu dead_count >= votes -> False (chết)

# Alias cho monitor_package (dùng vote 1 lần để không chậm vòng lặp 10s)
def _is_pkg_active(pkg):
    """Alias nhanh: 1 lần check. Dùng cho watchdog."""
    r = _check_pkg_alive_once(pkg)
    return r is not False  # None hoặc True → coi là active

def _pgrep_pkg(pkg, timeout=3):
    """Lấy danh sách PID chính xác của pkg bằng cách duyệt qua /proc qua su -c để tránh va chạm clone."""
    pids = []
    try:
        cmd = "su -c 'for p in /proc/[0-9]*; do [ -d \"$p\" ] && echo -n \"${p##*/}:\" && cat \"$p/cmdline\" 2>/dev/null && echo; done'"
        out = subprocess.check_output(
            cmd, shell=True, timeout=timeout,
            stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        )
        for line in out.split(b'\n'):
            if b':' not in line:
                continue
            parts = line.split(b':', 1)
            pid_str = parts[0].strip()
            if not pid_str.isdigit():
                continue
            cmdline = parts[1].split(b'\x00')[0].decode('utf-8', errors='ignore').strip()
            if cmdline == pkg or cmdline.startswith(pkg + ':'):
                pids.append(pid_str.decode('utf-8'))
    except:
        pass
    return pids

def _kill_pkg(pkg):
    """Kill process của pkg — kill -9 PID trước, fallback am force-stop."""
    pids = _pgrep_pkg(pkg)
    if pids:
        pid_str = ' '.join(pids)
        safe_root(f"su -c 'kill -9 {pid_str} 2>/dev/null'")
    else:
        safe_root(f"su -c 'am force-stop {pkg}'")
    time.sleep(1)

def boot_pkg_with_verify(pkg, max_retries=2):
    """Boot pkg tối ưu tốc độ: force-stop sạch → launch intent/monkey → poll 10s."""
    log_action(f"{Y}[BOOT]{RESET} Dang Mo App -> {pkg[-15:]}")
    for attempt in range(1, max_retries + 1):
        safe_root(f"su -c 'am force-stop {pkg}'")
        time.sleep(1)

        if target_place_id:
            safe_root(
                f"su -c 'am start -a android.intent.action.VIEW "
                f"-d \"roblox://experiences/start?placeId={target_place_id}\" -f 0x18000000 {pkg} 2>/dev/null'"
            )
            time.sleep(0.5)
            safe_root(f"su -c 'monkey -p {pkg} -c android.intent.category.LAUNCHER 1 2>/dev/null'")
        else:
            safe_root(f"su -c 'monkey -p {pkg} -c android.intent.category.LAUNCHER 1 2>/dev/null'")

        for _ in range(5):
            time.sleep(2)
            if _is_pkg_active(pkg):
                log_action(f"{G}[SUCCESS]{RESET} Bat App Thanh Cong -> {pkg[-15:]}")
                return True

        if attempt < max_retries:
            time.sleep(1)

    log_action(f"{R}[FAIL]{RESET} That bai khi mo app -> {pkg[-15:]}")
    return False

def _boot_worker(pkg, states):
    """Background thread: boot pkg không block monitor thread."""
    boot_acquired = global_restart_semaphore.acquire(timeout=60)
    try:
        boot_pkg_with_verify(pkg)
    except Exception:
        pass
    finally:
        states[pkg]['last_boot_finished'] = time.time() + 15
        if boot_acquired:
            global_restart_semaphore.release()
        _boot_threads.pop(pkg, None)

def force_restart_app(pkg, states, current_time, reason, color, ignore_cooldown=False):
    global last_restart_time, last_any_restart_time, file_to_pkg_binding

    # ── B0: Đang boot → KHÔNG ĐƯỢC kill hay spawn thêm ────
    existing = _boot_threads.get(pkg)
    if existing and existing.is_alive():
        return

    if not ignore_cooldown and pkg in last_restart_time and current_time - last_restart_time[pkg] < 180:
        return

    log_action(f"{R}[RESTART]{RESET} [{pkg[-15:]}] Ly do: {reason}")
    states[pkg]['text'] = reason
    states[pkg]['color'] = color
    last_restart_time[pkg] = current_time
    last_any_restart_time = current_time
    states[pkg]['last_boot_finished'] = current_time + 30

    # ── B1: Kill ngay process cũ ───
    _kill_pkg(pkg)

    # ── Dọn file heartbeat + cache RAM ──────────────────────────
    bound_name = states[pkg].get('bound_name')
    if bound_name:
        safe_root(
            f"su -c 'rm -f "
            f"/sdcard/Android/media/{pkg}/workspace/*_{bound_name}_checkhudyhub.json "
            f"/sdcard/Android/data/{pkg}/workspace/*_{bound_name}_checkhudyhub.json "
            f"/sdcard/Android/media/{pkg}/*_{bound_name}_checkhudyhub.json "
            f"/sdcard/Android/data/{pkg}/*_{bound_name}_checkhudyhub.json "
            f"/sdcard/Delta/*_{bound_name}_checkhudyhub.json "
            f"2>/dev/null'"
        )
        json_path_cache.pop(pkg, None)
        heartbeat_last_check.pop(pkg, None)
        with shared_lock:
            CLAIMED_NAMES.discard(bound_name)
            stale_fps = [fp for fp, fp_pkg in file_to_pkg_binding.items() if fp_pkg == pkg]
            for fp in stale_fps:
                del file_to_pkg_binding[fp]

    # ── Reset state ──────────────────────────────────────────
    states[pkg]['rejoin_time'] = current_time
    states[pkg]['bound_name'] = None
    states[pkg]['display_name'] = 'Chờ Auto-Bind...'
    states[pkg]['heartbeat_misses'] = 0
    states[pkg]['not_running_count'] = 0

    # ── B2: Boot trong background thread — monitor thread không bị block ────
    t = threading.Thread(
        target=_boot_worker, args=(pkg, states),
        daemon=True, name=f"boot_{pkg[-8:]}"
    )
    _boot_threads[pkg] = t
    t.start()

def rejoin_in_game(pkg, states, current_time, reason, color):
    """Khi PIP còn sống nhưng văng game/treo:
    Chỉ bắn lệnh Intent vào lại game mà KHÔNG kill PIP.
    Nếu PIP đã bị tắt process: Mới force-restart lại PIP."""
    global last_restart_time, last_any_restart_time, json_path_cache, heartbeat_last_check

    # Nếu PIP process đã thực sự bị đóng -> Buộc phải boot lại app từ đầu
    if not is_app_running(pkg):
        force_restart_app(pkg, states, current_time, reason, color, ignore_cooldown=True)
        return

    log_action(f"{Y}[REJOIN]{RESET} [{pkg[-15:]}] Ly do: {reason}")
    states[pkg]['text'] = reason
    states[pkg]['color'] = color
    last_restart_time[pkg] = current_time
    last_any_restart_time = current_time

    # Bắn Intent trực tiếp vào game (không kill PIP)
    if target_place_id:
        safe_root(
            f"su -c 'am start -a android.intent.action.VIEW "
            f"-d \"roblox://experiences/start?placeId={target_place_id}\" -p {pkg} -f 0x18000000 2>/dev/null'"
        )
    else:
        safe_root(f"su -c 'monkey -p {pkg} -c android.intent.category.LAUNCHER 1 2>/dev/null'")

    # Reset cache và misses
    bound_name = states[pkg].get('bound_name')
    if bound_name:
        safe_root(
            f"su -c 'rm -f "
            f"/sdcard/Android/media/{pkg}/workspace/*_{bound_name}_checkhudyhub.json "
            f"/sdcard/Android/data/{pkg}/workspace/*_{bound_name}_checkhudyhub.json "
            f"2>/dev/null'"
        )
        json_path_cache.pop(pkg, None)
        heartbeat_last_check.pop(pkg, None)

    states[pkg]['rejoin_time'] = current_time
    states[pkg]['heartbeat_misses'] = 0
    states[pkg]['not_running_count'] = 0

