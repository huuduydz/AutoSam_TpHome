    def run_root_cmd(self, cmd: str, timeout: int = 15) -> tuple[int, str, str]:
        """Thực thi lệnh shell root su -c với bắt stdout/stderr."""
        safe_cmd = cmd.replace("'", "'\\''")
        full_cmd = f"su -c '{safe_cmd}'"
        try:
            process = subprocess.Popen(
                full_cmd, shell=True,
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True
            )
            stdout, stderr = process.communicate(timeout=timeout)
            return process.returncode, stdout.strip(), stderr.strip()
        except subprocess.TimeoutExpired:
            process.kill()
            process.communicate()
            return -1, "", f"Timeout ({timeout}s)"
        except Exception as e:
            return -1, "", str(e)

    def get_package_ownership(self) -> tuple[int, int]:
        """Lấy UID và GID nội bộ của package qua stat hoặc packages.xml."""
        app_dir = f"/data/data/{self.package_name}"
        code, out, _ = self.run_root_cmd(f"stat -c '%u %g' {app_dir}")
        if code == 0 and out:
            parts = out.split()
            if len(parts) >= 2 and parts[0].isdigit() and parts[1].isdigit():
                self.uid = int(parts[0])
                self.gid = int(parts[1])
                return self.uid, self.gid
        
        code_xml, out_xml, _ = self.run_root_cmd(f"cat /data/system/packages.xml | grep -i '{self.package_name}'")
        if code_xml == 0 and out_xml:
            import re
            match = re.search(r'userId="(\d+)"', out_xml) or re.search(r'appId="(\d+)"', out_xml)
            if match:
                u_id = int(match.group(1))
                self.uid, self.gid = u_id, u_id
                return self.uid, self.gid

        self.uid, self.gid = 10000, 10000
        return self.uid, self.gid

