# TÍNH NĂNG 2: BẢNG THEO DÕI LIVE DASHBOARD
# =========================================================================
def start_auto_rejoin():
    global selected_packages
    if not selected_packages:
        print(f"{R}[!] Phải chọn Package ở mục [1] trước!{RESET}"); time.sleep(2); return

    print(f"\n{Y}[*] Đang setup Autoexec cho {len(selected_packages)} Package...{RESET}")
    for pkg in selected_packages:
        inject_lua_autoexec(pkg)
        os.system(f"am force-stop {pkg} > /dev/null 2>&1")
        time.sleep(0.5)
        os.system(f"am start -n {pkg}/com.roblox.client.Activity > /dev/null 2>&1")
    
    # Khởi tạo bộ nhớ tạm để ghi chú tình trạng từng app
    states = {pkg: {'text': 'Đang Mở Game...', 'color': Y, 'rejoin_time': time.time()} for pkg in selected_packages}

    # Bắt đầu vòng lặp Live Dashboard
    while True:
        try:
            current_time = time.time()
            
            for pkg in selected_packages:
                # Nếu vừa mới mở game xong, cho nó 60 giây ân hạn để load UI
                if current_time - states[pkg]['rejoin_time'] < 60:
                    states[pkg]['text'] = f"Đang Load ({int(60 - (current_time - states[pkg]['rejoin_time']))}s)"
                    states[pkg]['color'] = Y
                    continue

                last_ping = get_heartbeat(pkg)

                if last_ping == -1:
                    diff = current_time - states[pkg]['rejoin_time']
                    if diff > 150: # Quá 2.5 phút mà chưa thấy file -> Lỗi load/Stuck ở màn hình đen
                        states[pkg]['text'] = f"Lỗi Load / Treo Màn!"
                        states[pkg]['color'] = R
                        os.system(f"am force-stop {pkg} > /dev/null 2>&1")
                        time.sleep(1)
                        os.system(f"am start -n {pkg}/com.roblox.client.Activity > /dev/null 2>&1")
                        states[pkg]['rejoin_time'] = current_time
                    else:
                        states[pkg]['text'] = "Chờ file JSON..."
                        states[pkg]['color'] = C
                else:
                    diff = current_time - last_ping
                    if diff > 45: # Mất nhịp tim quá 45 giây -> Văng Game
                        states[pkg]['text'] = f"Văng Game ({int(diff)}s)"
                        states[pkg]['color'] = R
                        os.system(f"am force-stop {pkg} > /dev/null 2>&1")
                        time.sleep(1)
                        os.system(f"am start -n {pkg}/com.roblox.client.Activity > /dev/null 2>&1")
                        states[pkg]['rejoin_time'] = current_time
                    else:
                        states[pkg]['text'] = f"Đang Farm ({int(diff)}s trước)"
                        states[pkg]['color'] = G

            # --- VẼ KHUNG DASHBOARD ---
            clear_screen()
            print_banner()
            # In Header của Bảng
            print(f"{C}{'TÊN BẢN ROBLOX':<25} | {'TÌNH TRẠNG HIỆN TẠI':<25}{RESET}")
            print("-" * 65)
            
            # In từng dòng trạng thái
            for pkg in selected_packages:
                # Cắt ngắn tên package nếu quá dài để khung không bị méo
                short_pkg = pkg.split('.')[-1]
                if len(short_pkg) < 5: short_pkg = pkg[-20:] 
                
                txt = states[pkg]['text']
                col = states[pkg]['color']
                print(f"{short_pkg:<25} | {col}{txt:<25}{RESET}")
            
            print("-" * 65)
            print(f"{C} Đang chạy Live... (Bấm Ctrl + C để dừng){RESET}")
            
            # Làm mới bảng mỗi 5 giây
            time.sleep(5)

        except KeyboardInterrupt:
            print(f"\n{R}[!] Đã dừng Auto Rejoin.{RESET}")
            time.sleep(1)
            break
        except Exception as e:
            time.sleep(3)

def main():
    while True:
        clear_screen()
        print_banner()
        
        print(f"[{C}1{RESET}] Quét và Chọn Package Roblox")
        print(f"[{C}2{RESET}] Bắt đầu Auto Rejoin (Live Dashboard)")
