def inject_cookie_webview(pkg, cookie):
    """Tự động bơm cookie vào WebView Cookies database của app."""
    webview_db = f"/data/data/{pkg}/app_webview/Default/Cookies"
    
    # Kiểm tra file tồn tại không
    try:
        subprocess.check_output(f"su -c 'test -f {webview_db} && echo exists'", shell=True, text=True, timeout=5)
    except:
        return False  # Không tìm thấy file WebView Cookies

    # Tạo thư mục tạm và copy database về để xử lý (tránh khóa file)
    tmp_dir = os.path.join(os.environ.get('HOME', '/data/data/com.termux/files/home'), 'tmp')
    os.makedirs(tmp_dir, exist_ok=True)
    local_db = os.path.join(tmp_dir, f"cookies_{pkg.split('.')[-1]}.db")

    # Copy database về local
    subprocess.run(f"su -c 'cp {webview_db} {local_db} && chmod 666 {local_db}'", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)

    try:
        conn = sqlite3.connect(local_db)
        cursor = conn.cursor()

        # Kiểm tra bảng cookies có tồn tại không
        cursor.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='cookies'")
        if not cursor.fetchone():
            conn.close()
            os.remove(local_db)
            return False

        # Lấy cấu trúc bảng để biết các cột
        cursor.execute("PRAGMA table_info(cookies)")
        columns = [col[1] for col in cursor.fetchall()]

        # Chuẩn bị dữ liệu cần chèn
        now = int(time.time())
        data = {
            'creation_utc': now,
            'top_frame_site_key': '.roblox.com',
            'host_key': '.roblox.com',
            'name': '.ROBLOSECURITY',
            'value': cookie,
            'path': '/',
            'expires_utc': 2147483647,
            'is_secure': 1,
            'is_httponly': 1,
            'last_access_utc': now,
            'has_expires': 1,
            'is_permanent': 1,
            'source_port': -1,
            'is_same_party': 0
        }

        # Lọc chỉ giữ các cột tồn tại trong bảng
        cols = [k for k in data if k in columns]
        values = [data[k] for k in cols]
        placeholders = ', '.join(['?' for _ in cols])

        # Xóa cookie cũ nếu có
        cursor.execute("DELETE FROM cookies WHERE host_key=? AND name=?", ('.roblox.com', '.ROBLOSECURITY'))
        # Chèn cookie mới
        sql = f"INSERT INTO cookies ({', '.join(cols)}) VALUES ({placeholders})"
        cursor.execute(sql, values)

        conn.commit()
        conn.close()

        # Copy database đã sửa trở lại vị trí gốc
        subprocess.run(f"su -c 'cp {local_db} {webview_db}'", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.remove(local_db)
        return True

    except Exception as e:
        try:
            conn.close()
        except:
            pass
        try:
            os.remove(local_db)
        except:
            pass
        print(f"{R}    └─ Lỗi khi chèn cookie WebView: {str(e)[:100]}{RESET}")
        return False

