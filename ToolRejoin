def _get_file_mtime(filepath):
    """Lấy mtime - thử getmtime trước, fallback su stat cho file cần root."""
    try:
        return os.path.getmtime(filepath)
    except:
        pass
    try:
        out = subprocess.check_output(
            f"su -c 'stat -c %Y \"{filepath}\" 2>/dev/null'",
            shell=True, text=True, timeout=3,
            stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL
        ).strip()
        if out.isdigit():
            return float(out)
    except:
        pass
    return -1

import json as _json_mod

def _read_json_data(filepath):
    """Đọc nội dung JSON heartbeat, trả về dict {timestamp, status, errorCode, placeId, jobId} hoặc None."""
    raw = None
    try:
        with open(filepath, 'r', encoding='utf-8') as fh:
            raw = fh.read().strip()
    except:
        pass
    if not raw:
        try:
            raw = subprocess.check_output(
                f"su -c 'cat \"{filepath}\" 2>/dev/null'",
                shell=True, text=True, timeout=3,
                stdin=subprocess.DEVNULL, stderr=subprocess.DEVNULL
            ).strip()
        except:
            pass
    if not raw:
        return None
    try:
        data = _json_mod.loads(raw)
        res = {
            'timestamp': float(data.get('timestamp', -1)),
            'status': str(data.get('status', 'farming')),
            'errorCode': int(data.get('errorCode', 0)),
            'placeId': str(data.get('placeId', '')),
            'jobId': str(data.get('jobId', ''))
        }
        if res['timestamp'] == -1 and 'time' in data:
            from datetime import datetime, timezone
            dt = datetime.strptime(data['time'], '%Y-%m-%dT%H:%M:%SZ')
            res['timestamp'] = dt.replace(tzinfo=timezone.utc).timestamp()
        return res
    except:
        pass
    return None

def get_heartbeat_data(acc_name, pkg):
    """Lấy dữ liệu JSON heartbeat của acc_name thuộc package pkg."""
    global json_path_cache, heartbeat_last_check, file_to_pkg_binding
    now = time.time()
    if pkg not in json_path_cache:
        json_path_cache[pkg] = {}
        heartbeat_last_check[pkg] = {}
    cache = json_path_cache[pkg]
    last_check = heartbeat_last_check[pkg]

    if acc_name in cache:
        cached_path, cached_data = cache[acc_name]
        if os.path.exists(cached_path):
            if now - last_check.get(acc_name, 0) < 5:
                return cached_data
            data = _read_json_data(cached_path)
            if data:
                cache[acc_name] = (cached_path, data)
                last_check[acc_name] = now
                with shared_lock:
                    file_to_pkg_binding[cached_path] = pkg
                return data
        del cache[acc_name]

    all_files = get_all_heartbeat_files_fast(pkg)
    best_file = None
