def scan_packages():
    """Quét TẤT CẢ các ứng dụng do người dùng cài (Bỏ qua app hệ thống)"""
    print(f"\n{C}[*] Đang quét toàn bộ ứng dụng trên máy...{RESET}")
    packages = []
    
    try:
        output = subprocess.check_output("su -c 'pm list packages -3'", shell=True, text=True, stderr=subprocess.DEVNULL)
        for line in output.splitlines():
            if "package:" in line:
                packages.append(line.replace("package:", "").strip())
    except Exception:
        try:
            output = subprocess.check_output("pm list packages -3", shell=True, text=True, stderr=subprocess.DEVNULL)
            for line in output.splitlines():
                if "package:" in line:
                    packages.append(line.replace("package:", "").strip())
        except Exception:
            pass

    # [BẢN VÁ LỖI ĐƠ]: Khôi phục lại trạng thái Terminal sau khi bị lệnh su làm hỏng
    os.system("stty sane")

    # Làm sạch các ký tự rác (\r, \n) để chống in bậc thang
    cleaned_packages = []
    for p in list(set(packages)):
        clean_p = p.replace('\r', '').replace('\n', '').strip()
        if clean_p:
            cleaned_packages.append(clean_p)
            
    return cleaned_packages

def select_package_menu():
    global selected_packages
    packages = scan_packages()
    
    if not packages:
        print(f"{R}[!] Không tìm thấy bất kỳ app nào!{RESET}")
        time.sleep(2)
        return

    print(f"\n{G}Danh sách Package tìm thấy:{RESET}")
    for i, pkg in enumerate(packages, 1):
        print(f"[{i}] {pkg}")
    
    try:
        # Chốt chặn an toàn lần 2 đảm bảo bàn phím không bị liệt
        os.system("stty sane") 
        print(f"\n{C}💡 Mẹo: Nhập nhiều số cách nhau bởi dấu phẩy hoặc khoảng trắng (VD: 1 3 5 hoặc 1,2,3){RESET}")
        choice_str = input(f"{M}Chọn số thứ tự Package muốn chạy: {RESET}")
        
        # Dùng Regex để bắt tất cả các số người dùng nhập vào
        choices = [int(x) for x in re.findall(r'\d+', choice_str)]
        selected_packages.clear()
        
        for choice in set(choices):
            if 1 <= choice <= len(packages):
                selected_packages.append(packages[choice - 1])
        
        if selected_packages:
            print(f"\n{G}[+] Đã chọn {len(selected_packages)} Package thành công!{RESET}")
            time.sleep(2)
        else:
            print(f"{R}[!] Không có lựa chọn nào hợp lệ!{RESET}")
            time.sleep(1)
            
    except Exception as e:
        print(f"{R}[!] Lỗi thao tác: {e}{RESET}")
        time.sleep(1)

def login_via_cookie():
    """Ép đăng nhập Roblox bằng Cookie (Hỗ trợ Multi-Package)"""
    global selected_packages
    if not selected_packages:
        print(f"{R}[!] Bạn phải chọn Package ở mục [1] trước!{RESET}")
        time.sleep(2)
        return

    print(f"\n{C}--- ĐĂNG NHẬP BẰNG COOKIE ---{RESET}")
    print(f"{Y}Lưu ý: Tính năng này yêu cầu máy ĐÃ ROOT (Magisk/KernelSU).{RESET}")
    cookie = input(f"{M}Nhập Cookie Roblox (_|WARNING...): {RESET}").strip()

    if not cookie.startswith("_|WARNING"):
        print(f"{R}[!] Cookie không hợp lệ! (Phải bắt đầu bằng _|WARNING){RESET}")
        time.sleep(2)
        return

    print(f"{C}[*] Đang tạo cấu hình XML...{RESET}")
    xml_content = f"""<?xml version='1.0' encoding='utf-8' standalone='yes' ?>
<map>
    <string name="ROBLOSECURITY">{cookie}</string>
</map>"""

    temp_file = "/sdcard/Download/temp_roblox_cookie.xml"
    try:
        with open(temp_file, "w", encoding="utf-8") as f:
            f.write(xml_content)
    except Exception as e:
        print(f"{R}[!] Lỗi tạo file tạm: {e}{RESET}")
        time.sleep(2)
        return

    # Lặp qua tất cả các app đã chọn để nhét Cookie
    for pkg in selected_packages:
        print(f"{Y}[*] Đang Inject Cookie vào {pkg}...{RESET}")
        root_cmd = f"""su -c "
        am force-stop {pkg}
        mkdir -p /data/data/{pkg}/shared_prefs/
        cp {temp_file} /data/data/{pkg}/shared_prefs/com.roblox.client_preferences.xml
        chmod 660 /data/data/{pkg}/shared_prefs/com.roblox.client_preferences.xml
        PKG_UID=\\$(dumpsys package {pkg} | grep userId= | head -n 1 | cut -d'=' -f2 | cut -d' ' -f1)
        chown \\$PKG_UID:\\$PKG_UID /data/data/{pkg}/shared_prefs/com.roblox.client_preferences.xml
        " """
        
        os.system(root_cmd)
        print(f"{G}[+] Inject {pkg} hoàn tất!{RESET}")
        os.system(f"su -c 'am start -n {pkg}/com.roblox.client.Activity > /dev/null 2>&1'")
        time.sleep(1.5)

    # Dọn dẹp rác
    os.system(f"su -c 'rm {temp_file} > /dev/null 2>&1'")
    print(f"\n{G}[+] Đã hoàn thành Inject cho {len(selected_packages)} package!{RESET}")
    time.sleep(3)

def check_heartbeat():
    search_paths = [
        "/sdcard/Android/media/*/workspace/*_checkhudyhub.json",
        "/sdcard/Android/data/*/files/workspace/*_checkhudyhub.json",
        "/sdcard/Download/*_checkhudyhub.json"
    ]
    
    files = []
    for path in search_paths:
        files.extend(glob.glob(path))
        
    if not files:
        return False, "Không tìm thấy file Heartbeat (Bạn đã chạy script Lua trong game chưa?)"
        
    latest_file = max(files, key=os.path.getmtime)
    last_mod_time = os.path.getmtime(latest_file)
    current_time = time.time()
    
    diff = current_time - last_mod_time
    
    if diff > 45:
        return False, f"Game bị đứng hoặc văng! (Mất nhịp tim {int(diff)} giây trước)"
    
    return True, f"Hoạt động ổn định (Heartbeat cách đây {int(diff)}s)"

def start_auto_rejoin():
    global selected_packages
    if not selected_packages:
        print(f"{R}[!] Bạn phải chọn Package ở mục [1] trước!{RESET}")
        time.sleep(2)
        return

    print(f"\n{Y}[*] Khởi động HuDy Auto Rejoin cho {len(selected_packages)} Package...{RESET}")
    print(f"{C}[*] Bấm Ctrl + C để dừng.{RESET}")
    
    print(f"{G}[+] Đang dọn dẹp các app Roblox...{RESET}")
    for pkg in selected_packages:
        os.system(f"am force-stop {pkg} > /dev/null 2>&1")
    time.sleep(2)
    
    print(f"{G}[+] Đang khởi động hàng loạt...{RESET}")
    for pkg in selected_packages:
        os.system(f"am start -n {pkg}/com.roblox.client.Activity > /dev/null 2>&1")
        time.sleep(1)
    
    while True:
        try:
            time.sleep(15)
            is_alive, msg = check_heartbeat()
            current_time_str = datetime.now().strftime("%H:%M:%S")
            
            if is_alive:
                print(f"[{current_time_str}] {G}{msg}{RESET}")
            else:
                print(f"[{current_time_str}] {R}{msg}{RESET}")
                print(f"[{current_time_str}] {Y}[*] Đang tiến hành Rejoin hàng loạt...{RESET}")
                
                for pkg in selected_packages:
                    os.system(f"am force-stop {pkg} > /dev/null 2>&1")
                time.sleep(3) 
                
                for pkg in selected_packages:
                    os.system(f"am start -n {pkg}/com.roblox.client.Activity > /dev/null 2>&1")
                    time.sleep(1)
                
                print(f"[{current_time_str}] {C}[*] Đã mở lại xong. Đang chờ 60s để các game load...{RESET}")
                time.sleep(60)

        except KeyboardInterrupt:
            print(f"\n{R}[!] Đã dừng Auto Rejoin.{RESET}")
            time.sleep(1)
            break
        except Exception as e:
            print(f"{R}[!] Lỗi hệ thống: {e}{RESET}")
            time.sleep(5)

