def discover_unbound_account(claimed_names):
    search_paths = [
        "/sdcard/Android/media/*/*/workspace/rj_*_checkhudyhub.json",
        "/sdcard/Android/data/*/files/workspace/rj_*_checkhudyhub.json",
        "/sdcard/*/Workspace/rj_*_checkhudyhub.json", 
        "/sdcard/*/workspace/rj_*_checkhudyhub.json"
    ]
    files = []
    for path in search_paths: files.extend(glob.glob(path))
    
    for f in sorted(files, key=os.path.getmtime, reverse=True):
        try:
            mtime = os.path.getmtime(f)
            if (time.time() - mtime) < 150:
                with open(f, 'r', encoding='utf-8') as file:
                    data = json.load(file)
                    pname = data.get("playerName")
                    if pname and pname not in claimed_names:
                        return pname
        except Exception: pass
    return None

def get_heartbeat_data(acc_name):
    global json_path_cache
    
    if acc_name in json_path_cache and os.path.exists(json_path_cache[acc_name]):
        latest_file = json_path_cache[acc_name]
    else:
        search_paths = [
            f"/sdcard/Android/media/*/*/workspace/rj_{acc_name}_checkhudyhub.json",
            f"/sdcard/Android/data/*/files/workspace/rj_{acc_name}_checkhudyhub.json",
            f"/sdcard/*/Workspace/rj_{acc_name}_checkhudyhub.json", 
            f"/sdcard/*/workspace/rj_{acc_name}_checkhudyhub.json"
        ]
        files = []
        for path in search_paths: files.extend(glob.glob(path))
        if not files: return -1
        
        latest_file = max(files, key=os.path.getmtime)
        json_path_cache[acc_name] = latest_file 
    
    return os.path.getmtime(latest_file)

def trigger_boot_step_1(pkg):
    safe_root(f"su -c 'monkey -p {pkg} -c android.intent.category.LAUNCHER 1'")

def trigger_boot_step_2(pkg):
    safe_root(f"su -c 'am start -p {pkg} -a android.intent.action.VIEW -d \"roblox://experiences/start?placeId={target_place_id}\"'")

def force_restart_app(pkg, states, current_time, reason_text, color_code):
    global json_path_cache
    states[pkg]['text'] = reason_text
    states[pkg]['color'] = color_code
    
    safe_root(f"su -c 'am force-stop {pkg}'")
    
    bound_name = states[pkg].get('bound_name')
    if bound_name:
        safe_root(f"su -c 'find /sdcard -type f -name \"rj_{bound_name}_checkhudyhub.json\" -delete 2>/dev/null'")
        if bound_name in json_path_cache:
            del json_path_cache[bound_name]
            
    time.sleep(0.5)
    trigger_boot_step_1(pkg)
    
    # Bắt đầu vòng đời mới
    states[pkg]['boot_phase'] = 1 if target_place_id else 0
    states[pkg]['boot_timer'] = current_time
    states[pkg]['rejoin_time'] = current_time

def start_auto_rejoin():
    global selected_packages, kill_all_time, json_path_cache
    if not selected_packages:
        print(f"{R}[!] Phải chọn Package ở mục [1] trước!{RESET}"); time.sleep(2); return

    print(f"\n{Y}[*] Đang Inject Universal Script cho các Package...{RESET}")
    inject_universal_lua()
    
    states = {}
    current_time = time.time()
    for item in selected_packages:
        pkg = item['pkg']
        states[pkg] = {
            'text': 'Đang Mở Sảnh...',
            'color': Y,
            'boot_phase': 0,
            'boot_timer': current_time,
            'rejoin_time': current_time,
            'bound_name': item['name'] if item['name'] else None,
            'display_name': item['name'] if item['name'] else 'Chờ Auto-Bind...'
        }
        force_restart_app(pkg, states, current_time, 'Đang Mở Sảnh...', Y)

    os.system("stty sane < /dev/tty > /dev/null 2>&1")

    while True:
        try:
            current_time = time.time()
            
            for item in selected_packages:
                pkg = item['pkg']
                uptime_seconds = current_time - states[pkg]['rejoin_time']
                
                # --- PHASE 1: CHỜ BẮN DEEPLINK (TĂNG LÊN 15s CHỐNG SỐC APP) ---
                if states[pkg]['boot_phase'] == 1:
                    elapsed_boot = current_time - states[pkg]['boot_timer']
                    if elapsed_boot >= 15:
                        trigger_boot_step_2(pkg)
                        states[pkg]['boot_phase'] = 0 
                        # Không reset rejoin_time ở đây để bảo toàn quy tắc 150s
                    else:
                        states[pkg]['text'] = f"Đang Nạp Game ({int(15 - elapsed_boot)}s)"
                        states[pkg]['color'] = M
                    continue 
                
                # --- PHASE 0: THEO DÕI VÀ AUTO-BIND ---
                uptime_minutes = uptime_seconds / 60

                if kill_all_time > 0 and uptime_minutes >= kill_all_time:
                    force_restart_app(pkg, states, current_time, f"Auto Restart ({kill_all_time}m)", M)
                    continue

                if not states[pkg]['bound_name']:
                    claimed = [s['bound_name'] for s in states.values() if s['bound_name']]
                    found_name = discover_unbound_account(claimed)
                    if found_name:
                        states[pkg]['bound_name'] = found_name
                        states[pkg]['display_name'] = found_name
                
                bound_name = states[pkg]['bound_name']

                # --- QUY TẮC MIỄN TỬ: 150 GIÂY ĐẦU TIÊN (GRACE PERIOD) ---
                is_in_grace_period = (uptime_seconds < 150)

                if not bound_name:
                    if is_in_grace_period:
                        states[pkg]['text'] = f"Đang Load ({int(150 - uptime_seconds)}s)"
                        states[pkg]['color'] = Y
                    else:
                        force_restart_app(pkg, states, current_time, "Chưa Load/Kẹt Bind!", R)
                    continue

                last_ping = get_heartbeat_data(bound_name)

                if last_ping == -1:
                    if is_in_grace_period: 
                        states[pkg]['text'] = f"Đang Nạp Data ({int(150 - uptime_seconds)}s)"
                        states[pkg]['color'] = Y
                    else:
                        force_restart_app(pkg, states, current_time, "Treo Màn/Chưa Vô Game!", R)
                else:
                    diff = current_time - last_ping
                    if diff > 45: 
                        if is_in_grace_period:
                            # DU DI BỎ QUA: Vẫn trong 150s đầu tiên, File Json có thể là rác hoặc game đang giật lag
                            states[pkg]['text'] = f"Vào Server... ({int(150 - uptime_seconds)}s)"
                            states[pkg]['color'] = Y
                        else:
                            # Hết 150s mà diff vẫn > 45 -> Đích thị là Văng Game thật!
                            force_restart_app(pkg, states, current_time, f"Văng Game ({int(diff)}s)", R)
                    else:
                        states[pkg]['text'] = f"Đang Farm ({int(diff)}s trước)"
                        states[pkg]['color'] = G

            # --- VẼ KHUNG DASHBOARD ---
            clear_screen()
            print_banner()
            print(f"{C}{'INGAME NAME':<15} | {'PACKAGE INFO':<15} | {'TÌNH TRẠNG HIỆN TẠI':<25}{RESET}")
            print("-" * 65)
            
            for item in selected_packages:
                pkg = item['pkg']
                s_name = states[pkg]['display_name']
                if len(s_name) > 14: s_name = s_name[:11] + "..."
                s_pkg = pkg.split('.')[-1]
                if len(s_pkg) > 14: s_pkg = s_pkg[:11] + "..."
                
                txt = states[pkg]['text']
                col = states[pkg]['color']
                print(f"{s_name:<15} | {s_pkg:<15} | {col}{txt:<25}{RESET}")
            
            print("-" * 65)
            print(f"{C} Đang chạy Live... (Bấm Ctrl + C để dừng){RESET}")
            
            time.sleep(3)

        except KeyboardInterrupt:
            print(f"\n{R}[!] Đã dừng Auto Rejoin.{RESET}")
            fix_tty()
            break
        except Exception as e:
            time.sleep(3)

def main():
    fix_tty()
    while True:
        clear_screen()
        print_banner()
        
        print(f"[{C}1{RESET}] Quét và Chọn Package Roblox (Fix Trùng Lặp)")
        print(f"[{C}2{RESET}] Cài đặt Game ID (PlaceID) & Time Kill All")
