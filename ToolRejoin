def settings_menu():
    global target_place_id, kill_all_time
    print(f"\n{C}--- CÀI ĐẶT GAME ID & TIME KILL ALL ---{RESET}")
    
    p_id_raw = input(f"{M}Nhập Place ID (VD Blox Fruits: 2753915549) [Bỏ trống để vào sảnh]: {RESET}").strip()
    if p_id_raw == "":
        target_place_id = ""
        print(f"{Y}[*] Đã xóa Place ID, App sẽ mở vào màn hình chính.{RESET}")
    else:
        numbers = re.findall(r'\d+', p_id_raw)
        if numbers:
