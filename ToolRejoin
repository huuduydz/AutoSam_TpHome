def is_app_running(pkg):
    """Kiểm tra nhanh process của package.
    Dùng _check_pkg_alive_once() — scope đúng pkg, không gây check chéo.
    None (timeout) → coi là đang chạy để tránh false restart."""
    r = _check_pkg_alive_once(pkg)
    return r is not False  # True hoặc None → còn sống

def monitor_package(pkg, states, last_ok_ping, stop_event):
    """Thread độc lập cho từng package - không ảnh hưởng tab khác."""
    global kill_all_time, last_restart_time, CLAIMED_NAMES
    while not stop_event.is_set():
        try:
            current_time = time.time()
            state = states[pkg]
            session_uptime = current_time - state['session_start_time']
            uptime_seconds = current_time - state['rejoin_time']

            # === KIỂM TRA ĐANG TRONG TIẾN TRÌNH BOOT ===
            # PIP_WATCHDOG chịu trách nhiệm bật lại process
            # monitor_package chỉ lo heartbeat + rejoin game
            if pkg in _boot_threads and _boot_threads[pkg].is_alive():
                state['text'] = "Đang Khởi Động..."
                state['color'] = Y
                stop_event.wait(5)
                continue

            # === KIỂM TRA PROCESS CÒN SỐNG KHÔNG ===
            # is_app_running dùng _check_pkg_alive_once (1 lần, nhanh)
            # Nếu chết: hiển thị cảnh báo nhưng KHÔNG tự restart
            # → PIP_WATCHDOG sẽ vote 3 lần rồi mới restart để tránh false-restart
            if not is_app_running(pkg):
                state['text'] = f"Chờ Watchdog bật lại..."
                state['color'] = Y
                stop_event.wait(10)
                continue

            # === AUTO RESTART THEO THỜI GIAN (dùng session_uptime, tích lũy qua rejoin) ===
            if kill_all_time > 0 and session_uptime / 60 >= kill_all_time:
                # Dùng lock riêng của pkg - tránh block luồng khác
                with pkg_restart_locks[pkg]:
                    force_restart_app(pkg, states, current_time, f"Auto Restart ({kill_all_time}m)", M)
                # Reset session timer sau khi auto restart
                state['session_start_time'] = current_time
                last_ok_ping[pkg] = current_time
                stop_event.wait(10)
                continue

            # === WARMUP ===
            if current_time < state.get('warmup_until', 0):
                state['text'] = f"Warmup ({int(state['warmup_until'] - current_time)}s)"
                state['color'] = Y
                stop_event.wait(5)
                continue

            # === TÌM TÊN NẾU CHƯA BIND ===
            if not state['bound_name']:
                found = discover_unbound_account(pkg, states)
                if found:
                    state['bound_name'] = found
                    state['display_name'] = found

            bound = state['bound_name']
            is_grace = (uptime_seconds < 150)  # 150s thay vì 240s → detect fail nhanh hơn

            # === CHƯ A BIND ĐƯỢC TÊN ===
            if not bound:
                if is_grace:
                    # Nếu app không chạy sau 30s warmup → restart ngay
                    if uptime_seconds > 30 and not is_app_running(pkg):
                        can_restart = pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 180
                        if can_restart:
                            with pkg_restart_locks[pkg]:
                                force_restart_app(pkg, states, current_time, "App không mở được!", R)
                            last_ok_ping[pkg] = current_time
                        else:
                            state['text'] = 'App lỗi, đang chờ...'
                            state['color'] = R
                    else:
                        state['text'] = f"Đang Load ({int(150 - uptime_seconds)}s)"
                        state['color'] = Y
                else:
                    can_restart = pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 180
                    if can_restart:
                        with pkg_restart_locks[pkg]:
                            force_restart_app(pkg, states, current_time, "Chưa Load/Kẻ t Bind!", R)
                        last_ok_ping[pkg] = current_time
                    else:
                        wait_sec = int(180 - (current_time - last_restart_time.get(pkg, current_time)))
                        state['text'] = f"Chờ Restart ({wait_sec}s)"
                        state['color'] = R
                stop_event.wait(10)
                continue

            # === CHECK HEARTBEAT ===
            # Nếu pkg khác vừa restart (< 180s), cho thêm grace để tránh cascade
            other_just_restarted = (current_time - last_any_restart_time < 180) and \
                                   (last_any_restart_time != last_restart_time.get(pkg, 0))

            last_ping = get_heartbeat(bound, pkg)
            if last_ping == -1:
                state['heartbeat_misses'] = state.get('heartbeat_misses', 0) + 1
                misses = state['heartbeat_misses']
                if is_grace or other_just_restarted:
                    remain = int(240 - uptime_seconds) if is_grace else int(180 - (current_time - last_any_restart_time))
                    state['text'] = f"Đang Nạp Data ({max(0,remain)}s)"
                    state['color'] = Y
                elif misses >= 3 and (pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 180):
                    # Cần 3 miss liên tiếp (~30s) mới restart - tránh false negative
                    with pkg_restart_locks[pkg]:
                        force_restart_app(pkg, states, current_time, "Treo Màn/Chưa Vô Game!", R)
                    last_ok_ping[pkg] = current_time
                    state['heartbeat_misses'] = 0
                else:
                    state['text'] = f"Mất HB ({misses}/3 lần)..."
                    state['color'] = Y
            else:
                state['heartbeat_misses'] = 0  # Reset khi có heartbeat
                diff = current_time - last_ping
                if diff <= 120:
                    last_ok_ping[pkg] = current_time
                real_diff = current_time - last_ok_ping.get(pkg, current_time)
                if diff > 120:
                    if is_grace or other_just_restarted:
                        remain = int(240 - uptime_seconds) if is_grace else int(180 - (current_time - last_any_restart_time))
                        state['text'] = f"Vào Server... ({max(0,remain)}s)"
                        state['color'] = Y
                    elif real_diff >= 120 and (pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 180):
                        with pkg_restart_locks[pkg]:
                            force_restart_app(pkg, states, current_time, f"Văng Game ({int(diff)}s)", R)
                        last_ok_ping[pkg] = current_time
                    elif real_diff < 120:
                        state['text'] = f"Cảnh báo lag ({int(diff)}s)"
                        state['color'] = Y
                else:
                    state['text'] = f"Đang Farm ({int(diff)}s trước)"
                    state['color'] = G
        except Exception as e:
            # Ghi lỗi nhưng không crash thread - quan trọng cho 24/7
            try:
                states[pkg]['text'] = f"Lỗi ({str(e)[:15]})"
                states[pkg]['color'] = R
            except:
                pass
        stop_event.wait(10)


# =====================================================================
# PIP WATCHDOG — Thread riêng: bật lại app ngay khi phát hiện tắt
# =====================================================================
_pip_watchdog_threads = {}  # {pkg: Thread}

def _pip_watchdog_worker(pkg, states, last_ok_ping, stop_event):
    """PIP WATCHDOG — nguồn quyết định DUY NHẤT để restart process.
    Monitor_package chỉ hiển thị trạng thái, watchdog mới thực sự bật lại.

    Logic vote: cần 3 lần check liên tiếp (~24s) đều báo CHẾT mới restart.
    Nếu BẤT KỲ lần nào thấy sống hoặc timeout → reset về 0 (tránh false-restart)."""
    # Delay ban đầu cho boot thread khởi động xong
    stop_event.wait(20)
    dead_votes = 0  # Số lần liên tiếp xác nhận app chết
    while not stop_event.is_set():
        try:
            # Đang trong boot → không cần kiểm tra
            if pkg in _boot_threads and _boot_threads[pkg].is_alive():
                dead_votes = 0
                stop_event.wait(8)
                continue

            # _check_pkg_alive_once: True=sống, False=chết, None=không chắc(timeout)
            result = _check_pkg_alive_once(pkg)

            if result is True:
                # Sống rõ ràng → reset counter
                dead_votes = 0
            elif result is None:
                # Timeout/không chắc → coi như sống, reset để tránh false-restart
                dead_votes = 0
            else:
                # result is False → chắc chắn chết 1 lần
                dead_votes += 1

            # Cần ĐỦ 3 lần liên tiếp mới tin là app thực sự chết
            if dead_votes >= 3:
                current_time = time.time()
                # Cooldown 120s giữa 2 lần restart để tránh restart storm
                last_r = last_restart_time.get(pkg, 0)
                can_restart = (current_time - last_r) >= 120
                if can_restart:
                    existing = _boot_threads.get(pkg)
                    if not existing or not existing.is_alive():
                        try:
                            states[pkg]['text'] = 'Watchdog: Pip die → Bật lại!'
                            states[pkg]['color'] = R
                        except:
                            pass
                        last_restart_time[pkg] = current_time
                        t = threading.Thread(
                            target=_boot_worker,
                            args=(pkg, states),
                            daemon=True,
                            name=f"boot_wd_{pkg[-8:]}"
                        )
                        _boot_threads[pkg] = t
                        t.start()
                dead_votes = 0  # Reset sau khi đã xử lý
        except Exception:
            pass
        # Interval 8s giữa các lần vote
        stop_event.wait(8)

def start_auto_rejoin():
    global selected_packages, kill_all_time, json_path_cache, heartbeat_last_check, CLAIMED_NAMES, last_restart_time, pkg_restart_locks, global_restart_semaphore, file_to_pkg_binding
    if not selected_packages:
        print(f"{R}[!] Chọn package trước!{RESET}")
        time.sleep(2)
        return

    last_restart_time = {}
    last_any_restart_time = 0
    json_path_cache = {}
    heartbeat_last_check = {}
    CLAIMED_NAMES = set()
    pkg_restart_locks = {}
    global_restart_semaphore = threading.Semaphore(1)
    file_to_pkg_binding = {}

    print(f"\n{Y}[*] Inject script universal...{RESET}")
    inject_universal_lua()

    states = {}
    last_ok_ping = {}
    stop_event = threading.Event()
    now = time.time()

    # Bật từng tab theo thứ tự, cách nhau 5s để hệ thống ổn định
    for i, item in enumerate(selected_packages):
        pkg = item['pkg']
        pkg_restart_locks[pkg] = threading.Lock()
        pkg_now = time.time()  # Dùng thời gian thực tế cho từng pkg, không dùng `now` chung
        states[pkg] = {
            'text': 'Đang Mở Sảnh...',
            'color': Y,
            'bound_name': item['name'] if item['name'] else None,
            'display_name': item['name'] if item['name'] else 'Chờ Auto-Bind...',
            'rejoin_time': pkg_now,
            'session_start_time': pkg_now,
            'warmup_until': pkg_now + 90,
            'heartbeat_misses': 0,
            'not_running_count': 0
        }
        last_ok_ping[pkg] = pkg_now
        last_restart_time.pop(pkg, None)
        force_restart_app(pkg, states, pkg_now, 'Đang Mở Sảnh...', Y)
        if i < len(selected_packages) - 1:
            print(f"{Y}[*] Chờ 5s trước khi bật tab tiếp theo...{RESET}")
            time.sleep(5)

    os.system("stty sane < /dev/tty > /dev/null 2>&1")
    # Đợi thêm 2s cho các shell command sau safe_root hoàn tất
    time.sleep(2)

    # Khởi thread riêng cho từng package
    monitor_threads = {}
    pip_watchdog_threads = {}
    for item in selected_packages:
        pkg = item['pkg']
        # Thread monitor chính
        t = threading.Thread(
            target=monitor_package,
            args=(pkg, states, last_ok_ping, stop_event),
            daemon=True,
            name=f"mon-{pkg[-12:]}"
        )
        t.start()
        monitor_threads[pkg] = t
        # PIP Watchdog thread: bật lại ngay khi phát hiện app tắt
        wd = threading.Thread(
            target=_pip_watchdog_worker,
            args=(pkg, states, last_ok_ping, stop_event),
            daemon=True,
            name=f"wd-{pkg[-12:]}"
        )
        wd.start()
        pip_watchdog_threads[pkg] = wd

    # Main thread: hiển thị dashboard + watchdog tự khởi lại thread chết
    last_dashboard = 0
    try:
        while True:
            current_time = time.time()
            if current_time - last_dashboard >= 5:
                print_dashboard(states)
                last_dashboard = current_time

            # === WATCHDOG: phát hiện thread chết và khởi lại ===
            for item in selected_packages:
                pkg = item['pkg']
                # Restart monitor thread nếu chết
                t = monitor_threads.get(pkg)
                if t and not t.is_alive():
                    try:
                        states[pkg]['text'] = 'Watchdog: khởi lại...'
                        states[pkg]['color'] = M
                    except:
                        pass
                    new_t = threading.Thread(
                        target=monitor_package,
                        args=(pkg, states, last_ok_ping, stop_event),
                        daemon=True,
                        name=f"mon-{pkg[-12:]}"
                    )
                    new_t.start()
                    monitor_threads[pkg] = new_t
                # Restart pip watchdog thread nếu chết
                wd = pip_watchdog_threads.get(pkg)
                if wd and not wd.is_alive():
                    new_wd = threading.Thread(
                        target=_pip_watchdog_worker,
                        args=(pkg, states, last_ok_ping, stop_event),
                        daemon=True,
                        name=f"wd-{pkg[-12:]}"
                    )
                    new_wd.start()
                    pip_watchdog_threads[pkg] = new_wd

            time.sleep(3)
    except KeyboardInterrupt:
        stop_event.set()
        time.sleep(1.5)  # Đợi thread dừng hết
        fix_tty()
        print(f"\n{R}[!] Đã dừng Auto Rejoin.{RESET}")
        print("-" * 65)
        print(f"{Y}[*] Bấm Enter để về menu...{RESET}")
        try:
            input()  # Chờ người dùng bấm Enter trước khi về menu
        except:
            pass
        fix_tty()

