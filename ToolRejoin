                    }
                    valid_cols = [col for col in cookie_data if col in columns]
                    valid_vals = [cookie_data[col] for col in valid_cols]
                    placeholders = ','.join(['?' for _ in valid_cols])

                    cursor.execute(
                        "DELETE FROM cookies WHERE (host_key=? OR host_key=? OR host_key=?) AND name=?",
