def discover_unbound_account(claimed_names):
    search_paths = [
        "/sdcard/Android/media/*/*/workspace/rj_*_checkhudyhub.json",
        "/sdcard/Android/data/*/files/workspace/rj_*_checkhudyhub.json",
        "/sdcard/*/Workspace/rj_*_checkhudyhub.json", 
        "/sdcard/*/workspace/rj_*_checkhudyhub.json"
    ]
    files = []
    for path in search_paths: files.extend(glob.glob(path))
    
    for f in sorted(files, key=os.path.getmtime, reverse=True):
        try:
            mtime = os.path.getmtime(f)
            if (time.time() - mtime) < 150:
                with open(f, 'r', encoding='utf-8') as file:
                    data = json.load(file)
                    pname = data.get("playerName")
                    if pname and pname not in claimed_names:
                        return pname
        except Exception: pass
    return None

def get_heartbeat_data(acc_name):
    global json_path_cache
    
    if acc_name in json_path_cache and os.path.exists(json_path_cache[acc_name]):
        latest_file = json_path_cache[acc_name]
    else:
        search_paths = [
            f"/sdcard/Android/media/*/*/workspace/rj_{acc_name}_checkhudyhub.json",
            f"/sdcard/Android/data/*/files/workspace/rj_{acc_name}_checkhudyhub.json",
            f"/sdcard/*/Workspace/rj_{acc_name}_checkhudyhub.json", 
            f"/sdcard/*/workspace/rj_{acc_name}_checkhudyhub.json"
        ]
        files = []
        for path in search_paths: files.extend(glob.glob(path))
        if not files: return -1
        
        latest_file = max(files, key=os.path.getmtime)
        json_path_cache[acc_name] = latest_file 
    
    return os.path.getmtime(latest_file)

