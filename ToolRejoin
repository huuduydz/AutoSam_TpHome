def is_network_available():
    """Kiểm tra kết nối mạng bằng kết nối socket TCP tới DNS Server (1.1.1.1:53 / 8.8.8.8:53)."""
    try:
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.settimeout(2.0)
            s.connect(("1.1.1.1", 53))
        return True
    except Exception:
        try:
            with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
                s.settimeout(2.0)
                s.connect(("8.8.8.8", 53))
            return True
        except Exception:
            return False

