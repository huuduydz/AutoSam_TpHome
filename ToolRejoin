        print(f"{Y}[*] Mở app...{RESET}")
        subprocess.run(f"su -c 'monkey -p {pkg} -c android.intent.category.LAUNCHER 1'", shell=True, stdout=subprocess.DEVNULL)
        time.sleep(1)
    print(f"\n{G}[+] HOÀN TẤT.{RESET}")
    time.sleep(5)

# =====================================================================
# AUTO REJOIN (TỐI ƯU + ĐỌC ĐÚNG FILE)
# =====================================================================
def start_auto_rejoin():
    global selected_packages, kill_all_time, json_path_cache, heartbeat_last_check, CLAIMED_NAMES, last_restart_time
    last_ok_ping = {}  # {pkg: timestamp} - lần cuối heartbeat hợp lệ
    if not selected_packages:
        print(f"{R}[!] Chọn package trước!{RESET}")
        time.sleep(2)
        return

    # Reset để đảm bảo mở app được khi vào lại session
    last_restart_time = {}
    json_path_cache = {}
    heartbeat_last_check = {}
    CLAIMED_NAMES = set()

    print(f"\n{Y}[*] Inject script universal...{RESET}")
    inject_universal_lua()

    states = {}
    now = time.time()
    for item in selected_packages:
        pkg = item['pkg']
        states[pkg] = {
            'text': 'Đang Mở Sảnh...',
            'color': Y,
            'bound_name': item['name'] if item['name'] else None,
            'display_name': item['name'] if item['name'] else 'Chờ Auto-Bind...',
            'rejoin_time': now,
            'warmup_until': now + 60
        }
        last_ok_ping[pkg] = now  # khởi tạo để không bị false-restart ngay
        force_restart_app(pkg, states, now, 'Đang Mở Sảnh...', Y)

    os.system("stty sane < /dev/tty > /dev/null 2>&1")

    last_dashboard = 0
    while True:
        try:
            current_time = time.time()
            any_change = False

            for item in selected_packages:
                pkg = item['pkg']
                state = states[pkg]
                uptime_seconds = current_time - state['rejoin_time']

                if kill_all_time > 0 and uptime_seconds / 60 >= kill_all_time:
                    force_restart_app(pkg, states, current_time, f"Auto Restart ({kill_all_time}m)", M)
                    last_ok_ping[pkg] = current_time  # reset sau restart
                    any_change = True
                    continue

                if 'warmup_until' in state and current_time < state['warmup_until']:
                    new_text = f"Warmup ({int(state['warmup_until'] - current_time)}s)"
                    if state['text'] != new_text:
                        state['text'] = new_text
                        state['color'] = Y
                        any_change = True
                    continue

                if not state['bound_name']:
                    found = discover_unbound_account(pkg)
                    if found:
                        state['bound_name'] = found
                        state['display_name'] = found
                        any_change = True

                bound = state['bound_name']
                is_grace = (uptime_seconds < 240)

                if not bound:
                    if is_grace:
                        new_text = f"Đang Load ({int(240 - uptime_seconds)}s)"
                        if state['text'] != new_text:
                            state['text'] = new_text
                            state['color'] = Y
                            any_change = True
                    else:
                        if pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 180:
                            force_restart_app(pkg, states, current_time, "Chưa Load/Kẹt Bind!", R)
                            last_ok_ping[pkg] = current_time  # reset sau restart
                            any_change = True
                    continue

                last_ping = get_heartbeat(bound, pkg)
                if last_ping == -1:
                    if is_grace:
                        new_text = f"Đang Nạp Data ({int(240 - uptime_seconds)}s)"
                        if state['text'] != new_text:
                            state['text'] = new_text
                            state['color'] = Y
                            any_change = True
                    else:
                        if pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 180:
                            force_restart_app(pkg, states, current_time, "Treo Màn/Chưa Vô Game!", R)
                            last_ok_ping[pkg] = current_time  # reset sau restart
                            any_change = True
                else:
                    diff = current_time - last_ping
                    # Cập nhật last_ok_ping nếu heartbeat còn tươi (<= 120s)
                    if diff <= 120:
                        last_ok_ping[pkg] = current_time
                    # Tính thời gian kể từ lần cuối heartbeat hợp lệ
                    real_diff = current_time - last_ok_ping.get(pkg, current_time)
                    if diff > 120:
                        if is_grace:
                            new_text = f"Vào Server... ({int(240 - uptime_seconds)}s)"
                            if state['text'] != new_text:
                                state['text'] = new_text
                                state['color'] = Y
                                any_change = True
                        else:
                            # Chỉ restart nếu THỰC SỰ không có ping hợp lệ >= 120s
                            if real_diff >= 120 and (pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 180):
                                force_restart_app(pkg, states, current_time, f"Văng Game ({int(diff)}s)", R)
                                last_ok_ping[pkg] = current_time  # reset sau restart
                                any_change = True
                            elif real_diff < 120:
                                # Vẫn còn ping gần đây, chỉ hiển thị cảnh báo
                                new_text = f"Cảnh báo lag ({int(diff)}s)"
                                if state['text'] != new_text:
                                    state['text'] = new_text
                                    state['color'] = Y
                                    any_change = True
                    else:
                        new_text = f"Đang Farm ({int(diff)}s trước)"
                        if state['text'] != new_text:
                            state['text'] = new_text
                            state['color'] = G
                            any_change = True

            if any_change or (current_time - last_dashboard > 30):
                print_dashboard(states)
                last_dashboard = current_time

            time.sleep(10)

        except KeyboardInterrupt:
            print(f"\n{R}[!] Đã dừng Auto Rejoin.{RESET}")
            fix_tty()
            break
        except Exception as e:
            time.sleep(5)

