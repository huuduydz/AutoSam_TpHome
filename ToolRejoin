        print(f"[{C}4{RESET}] Thoát")
        
        choice = input(f"\n{M}HuDy > {RESET}").strip()
        
        if choice == '1': select_package_menu()
        elif choice == '2': start_auto_rejoin()
        elif choice == '3': login_via_cookie()
        elif choice == '4': clear_screen(); break

if __name__ == "__main__":
    main()
