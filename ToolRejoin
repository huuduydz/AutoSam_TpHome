                cursor.execute("PRAGMA table_info(cookies)")
                columns = [col[1] for col in cursor.fetchall()]

                current_epoch_sec = int(time.time())
                epoch_1601_offset = 11644473600
                now_epoch_1601 = (current_epoch_sec + epoch_1601_offset) * 1000000
                expires_epoch_1601 = (current_epoch_sec + (10 * 365 * 86400) + epoch_1601_offset) * 1000000

                hosts = ['.roblox.com', 'www.roblox.com', 'roblox.com', '.www.roblox.com']

