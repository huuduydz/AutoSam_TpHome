def inject_cookie_webview(pkg, cookie):
    webview_db = f"/data/data/{pkg}/app_webview/Default/Cookies"
    try:
        subprocess.check_output(f"su -c 'test -f {webview_db} && echo exists'", shell=True, text=True, timeout=5)
    except:
        return False
    tmp_dir = os.path.join(os.environ.get('HOME', '/data/data/com.termux/files/home'), 'tmp')
    os.makedirs(tmp_dir, exist_ok=True)
    local_db = os.path.join(tmp_dir, f"cookies_{pkg.split('.')[-1]}.db")
    subprocess.run(f"su -c 'cp {webview_db} {local_db} && chmod 666 {local_db}'", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    try:
        conn = sqlite3.connect(local_db)
        c = conn.cursor()
        c.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='cookies'")
        if not c.fetchone():
            conn.close()
            os.remove(local_db)
            return False
        c.execute("PRAGMA table_info(cookies)")
        columns = [col[1] for col in c.fetchall()]
        now = int(time.time())
        data = {
            'creation_utc': now, 'top_frame_site_key': '.roblox.com', 'host_key': '.roblox.com',
            'name': '.ROBLOSECURITY', 'value': cookie, 'path': '/', 'expires_utc': 2147483647,
            'is_secure': 1, 'is_httponly': 1, 'last_access_utc': now, 'has_expires': 1,
            'is_permanent': 1, 'source_port': -1, 'is_same_party': 0
        }
        cols = [k for k in data if k in columns]
        values = [data[k] for k in cols]
        placeholders = ','.join(['?' for _ in cols])
        c.execute("DELETE FROM cookies WHERE host_key=? AND name=?", ('.roblox.com', '.ROBLOSECURITY'))
        sql = f"INSERT INTO cookies ({','.join(cols)}) VALUES ({placeholders})"
        c.execute(sql, values)
        conn.commit()
        conn.close()
        subprocess.run(f"su -c 'cp {local_db} {webview_db}'", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.remove(local_db)
        return True
    except Exception as e:
        try:
            conn.close()
        except:
            pass
        try:
            os.remove(local_db)
        except:
            pass
        print(f"{R}    └─ Lỗi WebView: {str(e)[:80]}{RESET}")
        return False

def inject_cookie_safe_xml(pkg, cookie):
    shared_prefs_dir = f"/data/data/{pkg}/shared_prefs"
    try:
        files_str = subprocess.check_output(f"su -c 'ls {shared_prefs_dir}/*.xml 2>/dev/null'", shell=True, text=True, timeout=5).strip()
    except:
        return False
    if not files_str:
        return False
    xml_files = files_str.split('\n')
    uid = "10000"
    try:
        uid = subprocess.check_output(f"su -c 'stat -c %u /data/data/{pkg}'", shell=True, text=True, timeout=5).strip()
    except:
        pass
    for xml_path in xml_files:
        xml_path = xml_path.strip()
        if not xml_path:
            continue
        try:
            raw = subprocess.check_output(f"su -c 'cat {xml_path} 2>/dev/null'", shell=True, text=True, timeout=5)
        except:
            continue
        if '<map>' not in raw:
            continue
        existing = {}
        try:
            root_el = ET.fromstring(raw)
            for string_tag in root_el.findall('string'):
                key = string_tag.get('name')
                if key:
                    existing[key] = string_tag.text
        except:
            pass
        existing['ROBLOSECURITY'] = cookie
        new_root = ET.Element('map')
        for k, v in existing.items():
            el = ET.SubElement(new_root, 'string', name=k)
            el.text = v
        xml_output = '<?xml version="1.0" encoding="utf-8" standalone="yes" ?>\n' + ET.tostring(new_root, encoding='unicode')
        tmp_dir = os.path.join(os.environ.get('HOME', '/data/data/com.termux/files/home'), 'tmp')
        os.makedirs(tmp_dir, exist_ok=True)
        fd, temp_file = tempfile.mkstemp(suffix='.xml', prefix='cookie_', dir=tmp_dir)
        with os.fdopen(fd, 'w', encoding='utf-8') as f:
            f.write(xml_output)
        subprocess.run(f"su -c 'cp {temp_file} {xml_path} && chown {uid}:{uid} {xml_path} && chmod 660 {xml_path} && restorecon {xml_path} 2>/dev/null || true && touch {xml_path}'", shell=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        os.remove(temp_file)
    return True

