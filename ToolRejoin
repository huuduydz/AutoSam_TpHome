# PIP WATCHDOG — Thread riêng: bật lại app ngay khi phát hiện tắt
# =====================================================================
_pip_watchdog_threads = {}  # {pkg: Thread}

def _pip_watchdog_worker(pkg, states, last_ok_ping, stop_event):
    """PIP WATCHDOG — Giữ PIP luôn bật.
    KHÔNG tự tắt app đang chạy. Chỉ khi app thực sự bị đóng process mới bật lại."""
    stop_event.wait(5)
    dead_votes = 0
    while not stop_event.is_set():
        try:
            current_time = time.time()

            # 1) Đang trong boot → bỏ qua, reset vote
            if pkg in _boot_threads and _boot_threads[pkg].is_alive():
                dead_votes = 0
                stop_event.wait(3)
                continue

            # 2) Đang trong thời gian bảo vệ post-boot → bỏ qua, reset vote
            if current_time < states[pkg].get('last_boot_finished', 0):
                dead_votes = 0
                stop_event.wait(3)
                continue

            result = _check_pkg_alive_once(pkg)
            if result is False:
                dead_votes += 1
            else:
                dead_votes = 0

            # Cần ĐỦ 3 lần liên tiếp báo chết (~9s) mới xác nhận app thực sự bị đóng
            if dead_votes >= 3:
                existing = _boot_threads.get(pkg)
                if not existing or not existing.is_alive():
                    log_action(f"{Y}[WATCHDOG]{RESET} App [{pkg[-15:]}] bi dong -> Bat lai PIP!")
                    t = threading.Thread(
                        target=_boot_worker, args=(pkg, states),
                        daemon=True, name=f"boot_{pkg[-8:]}"
                    )
                    _boot_threads[pkg] = t
                    t.start()
                dead_votes = 0
        except Exception:
            pass
        stop_event.wait(3)

