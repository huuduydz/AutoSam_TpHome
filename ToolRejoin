def scan_packages():
    packages = []
    try:
        output = subprocess.check_output("pm list packages -3", shell=True, text=True, stderr=subprocess.DEVNULL)
    except Exception:
        try:
            output = subprocess.check_output("su -c 'pm list packages -3'", shell=True, text=True, stderr=subprocess.DEVNULL, stdin=subprocess.DEVNULL)
        except:
            output = ""

    fix_tty()
    for line in output.splitlines():
        if "package:" in line:
            packages.append(line.replace("package:", "").strip())

    cleaned_packages = []
    for p in list(set(packages)):
        clean_p = p.replace('\r', '').replace('\n', '').strip()
        if clean_p:
            cleaned_packages.append(clean_p)
    return cleaned_packages

