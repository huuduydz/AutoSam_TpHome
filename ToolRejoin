def extract_username_from_filename(filename):
    """Lấy tên ingame từ tên file kiểu rj_TEN_checkhudyhub.json hoặc r_j_TEN_checkhudyhub.json..."""
    base = os.path.basename(filename)
    # Xóa đuôi _checkhudyhub.json
    if base.endswith('_checkhudyhub.json'):
        base = base[:-len('_checkhudyhub.json')]
    else:
        # Không đúng định dạng, thử tách phần trước đuôi .json
        base = os.path.splitext(base)[0]
    # Tách bởi dấu gạch dưới, lấy phần tử cuối cùng (sau khi đã bỏ hậu tố) làm tên
    # Với rj_TEN -> parts = ['rj', 'TEN'] -> lấy parts[-1]
    # Với r_j_TEN -> parts = ['r', 'j', 'TEN'] -> lấy parts[-1]
    parts = base.split('_')
    if len(parts) >= 2:
        return parts[-1]  # Phần cuối là tên
    return base  # fallback

def get_all_heartbeat_files_fast(pkg=None):
    """Dùng find hệ thống để tìm tất cả file *_checkhudyhub.json trên các đường dẫn phổ biến"""
    # Các thư mục cần quét, bao gồm cả workspace của bản mod
    search_dirs = [
        "/sdcard/Android/media",
        "/sdcard/Android/data",
        "/sdcard/Delta",               # thư mục mod thường gặp
        "/storage/emulated/0/Delta",
        "/sdcard/ModWorkspace"
    ]
    # Nếu có pkg, thêm thư mục riêng của package đó (để tối ưu)
    if pkg:
        search_dirs.insert(0, f"/sdcard/Android/media/{pkg}")
        search_dirs.insert(0, f"/sdcard/Android/data/{pkg}")
        search_dirs.insert(0, f"/sdcard/{pkg}")
    results = []
    for d in search_dirs:
        try:
            cmd = f"su -c 'find {d} -iname \"*_checkhudyhub.json\" -type f 2>/dev/null'"
            out = subprocess.check_output(cmd, shell=True, text=True, timeout=5).strip()
            for line in out.splitlines():
                line = line.strip()
                if line:
                    results.append(line)
        except:
            pass
    # Loại trùng
    return list(set(results))

def get_heartbeat(acc_name, pkg):
    global json_path_cache, heartbeat_last_check
    now = time.time()
    if pkg not in json_path_cache:
        json_path_cache[pkg] = {}
        heartbeat_last_check[pkg] = {}
    cache = json_path_cache[pkg]
    last_check = heartbeat_last_check[pkg]

    if acc_name in cache:
        cached_path, cached_mtime = cache[acc_name]
        if os.path.exists(cached_path):
            if now - last_check.get(acc_name, 0) < 15:
                return cached_mtime
            try:
                mtime = os.path.getmtime(cached_path)
                cache[acc_name] = (cached_path, mtime)
                last_check[acc_name] = now
                return mtime
            except:
                pass
        del cache[acc_name]

    # Tìm mới từ danh sách tất cả file
    all_files = get_all_heartbeat_files_fast(pkg)
    best_mtime = 0
    best_file = None
    for f in all_files:
        try:
            # Lấy tên từ file, so khớp với acc_name
            name_in_file = extract_username_from_filename(f)
            if name_in_file == acc_name:
                mtime = os.path.getmtime(f)
                if mtime > best_mtime:
                    best_mtime = mtime
                    best_file = f
        except:
            pass
    if best_file:
        cache[acc_name] = (best_file, best_mtime)
        last_check[acc_name] = now
        return best_mtime
    return -1

def discover_unbound_account(pkg):
    global CLAIMED_NAMES
    all_files = get_all_heartbeat_files_fast(pkg)
    candidates = []
    now = time.time()
    for f in all_files:
        try:
            mtime = os.path.getmtime(f)
            if now - mtime < 240:  # file mới trong 4 phút
                name = extract_username_from_filename(f)
                if name:
                    candidates.append((name, mtime))
        except:
            pass
    candidates.sort(key=lambda x: x[1], reverse=True)
    for name, _ in candidates:
        if name not in CLAIMED_NAMES:
            CLAIMED_NAMES.add(name)
            return name
    return None

