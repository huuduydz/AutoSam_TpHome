-- 3. TIẾN HÀNH KIỂM TRA HANDSHAKE PAYLOAD
-- =============================================================================
local function ValidatePayload(p)
    if type(p) ~= "table" then
        return false, "Không nhận được payload từ Loader! (Bạn đang chạy file test trực tiếp mà không qua Loader)."
    end

    local uid = LocalPlayer and LocalPlayer.UserId or 0
    if p.UserId ~= uid then
        return false, string.format("UserId không khớp! Payload: %s, LocalPlayer: %s", tostring(p.UserId), tostring(uid))
    end

    local now = os.time()
    if not p.Timestamp or type(p.Timestamp) ~= "number" then
        return false, "Payload thiếu trường Timestamp!"
    end

    local age = math.abs(now - p.Timestamp)
    if age > TEST_CONFIG.MAX_TOKEN_AGE then
        return false, string.format("Token đã hết hạn! (Thời gian chênh lệch: %d giây > %d giây cho phép).", age, TEST_CONFIG.MAX_TOKEN_AGE)
    end

    local rawMsg = tostring(uid) .. ":" .. tostring(p.Timestamp) .. ":" .. TEST_CONFIG.LOADER_SECRET
    local expectedSignature = _SHA256.digest(rawMsg)

    if p.Token ~= expectedSignature then
        return false, "Chữ ký SHA256 không hợp lệ! Khóa bí mật (Secret Key) không đồng bộ giữa Loader và Source."
    end

    return true, {
        UserId = uid,
        Timestamp = p.Timestamp,
        LatencySec = age,
        Token = p.Token,
        LoaderVersion = p.LoaderVersion or "Không rõ"
    }
end

