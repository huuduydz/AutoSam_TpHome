                    "message": "Roblox chặn sinh Ticket vào game và yêu cầu giải Captcha!"
                }
            elif chal_id or chal_type or chal_meta:
                return {
                    "status": "CAPTCHA_CHECKPOINT",
                    "badge": f"Dính Checkpoint Bảo Mật ({chal_type or 'Challenge'})",
                    "color": Y,
                    "user_id": user_id,
