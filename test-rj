def auto_enter_key_and_continue(key_str):
    """
    Tự động nhập key dạng 'FREE_...' vào khung 'KEY_example' và bấm nút 'Continue'.
    Tọa độ chuẩn theo bảng Welcome Back ở góc phải:
    - Input 'KEY_example': X = 83.3% W, Y = 61.7% H
    - Button 'Continue':   X = 83.3% W, Y = 75.8% H
    Sau khi bấm Continue, Delta sẽ tự động kiểm tra và sinh file license!
    """
    key_str = key_str.strip()
    if not key_str:
        return False

    w, h = get_screen_resolution()
    input_coords = None
    continue_coords = None

    # Thử quét tọa độ chính xác qua uiautomator
    try:
        safe_root("su -c 'uiautomator dump /sdcard/uidump.xml 2>/dev/null'")
        dump_str = subprocess.check_output("su -c 'cat /sdcard/uidump.xml 2>/dev/null'", shell=True, text=True, timeout=3)
        if dump_str:
            root_el = ET.fromstring(dump_str)
            for node in root_el.iter('node'):
                txt = node.attrib.get('text', '')
                desc = node.attrib.get('content-desc', '')
                bounds = node.attrib.get('bounds', '')
                coords = re.findall(r'\[(\d+),(\d+)\]', bounds)
                if len(coords) == 2:
                    cx = (int(coords[0][0]) + int(coords[1][0])) // 2
                    cy = (int(coords[0][1]) + int(coords[1][1])) // 2
                    if "Continue" in txt or "Continue" in desc:
                        continue_coords = (cx, cy)
                    elif "KEY_example" in txt or "Enter key" in txt or "Enter key" in desc or node.attrib.get('class') == 'android.widget.EditText':
                        input_coords = (cx, cy)
    except:
        pass

    # 1. Tọa độ ô input: Panel bên phải (83.3% W, 61.7% H)
    in_x = input_coords[0] if input_coords else int(w * 0.833)
    in_y = input_coords[1] if input_coords else int(h * 0.617)

    # 2. Focus vào ô nhập key (nhấp 2 lần để con trỏ chắc chắn vào ô)
    add_log(f"[Key] Focus ô 'KEY_example' ({in_x}, {in_y})")
    safe_root(f"su -c 'input tap {in_x} {in_y}'")
    time.sleep(0.3)
    safe_root(f"su -c 'input tap {in_x} {in_y}'")
    time.sleep(0.5)

    # 3. Ghi vào Clipboard
    set_android_clipboard(key_str)
    time.sleep(0.2)

    # 4. Gõ chuỗi key (dạng FREE_...) vào ô input
    safe_root(f"su -c 'input text \"{key_str}\"'")
    time.sleep(0.4)
    # Gửi lệnh paste backup
    safe_root("su -c 'input keyevent 279 2>/dev/null'")
    time.sleep(0.4)

    # 5. Đóng bàn phím ảo (nếu có) bằng phím Back để không che nút Continue
    safe_root("su -c 'input keyevent 4 2>/dev/null'")
    time.sleep(0.8)

    # 6. Tọa độ nút Continue: Panel bên phải (83.3% W, 75.8% H)
    cont_x = continue_coords[0] if continue_coords else int(w * 0.833)
    cont_y = continue_coords[1] if continue_coords else int(h * 0.758)

    add_log(f"[Key] Bấm nút 'Continue' ({cont_x}, {cont_y})")
    safe_root(f"su -c 'input tap {cont_x} {cont_y}'")
    time.sleep(2.0)
    return True

def _get_delta_license_dirs():
    """Trả về danh sách tất cả thư mục có thể chứa Delta license."""
    dirs = [
        "/storage/emulated/0/Delta/Internals/Cache",
        "/data/media/0/Delta/Internals/Cache",
        "/sdcard/Delta/Internals/Cache",
        "/sdcard/DeltaQT/Internals/Cache",
        "/storage/emulated/0/DeltaQT/Internals/Cache",
    ]
    for item in selected_packages:
        pkg = item['pkg']
        dirs.extend([
            f"/sdcard/Android/media/{pkg}/Delta/Internals/Cache",
            f"/data/media/0/Android/media/{pkg}/Delta/Internals/Cache",
            f"/sdcard/Android/data/{pkg}/Delta/Internals/Cache",
            f"/data/media/0/Android/data/{pkg}/Delta/Internals/Cache",
        ])
    return list(set(dirs))


def open_delta_getkey(pkg):
    """Trigger Delta mở trang Get Key bằng cách gửi intent vào activity chính.
    Delta thường xử lý key check khi launch nên force-stop rồi reopen là đủ."""
    # Xóa file license cũ hết hạn (nếu có) để Delta bắt buộc hiện bảng Welcome Back
    dirs = _get_delta_license_dirs()
    for d in dirs:
        lic = f"{d}/license"
        mt = _get_file_mtime_root(lic)
        if mt > 0:
            safe_root(f"su -c 'rm -f \"{lic}\"'")

    safe_root(f"su -c 'am force-stop {pkg}'")
    time.sleep(2)
    safe_root(
        f"su -c 'monkey -p {pkg} -c android.intent.category.LAUNCHER 1 2>/dev/null'"
    )
    add_log(f"[Key] Mở Delta {pkg[-16:]} để nạp Key")


def delta_license_sync_thread(stop_event):
    """
    Thread tự động lấy & nạp key Delta (KHÔNG CẦN BACKUP HAY RESTORE):
    1. Kiểm tra xem app đã có file license còn hạn (< KEY_EXPIRE_HOURS) hay chưa.
    2. Nếu chưa có hoặc hết hạn:
       - Mở Delta, chờ bảng Welcome Back xuất hiện.
       - Tự động click 'Receive Key' (góc phải) để lấy URL Get Key vào Clipboard.
       - Đóng trình duyệt Chrome vừa bị bật lên.
       - Gửi URL lên Bacon API giải mã lấy chuỗi key 'FREE_...'.
       - Khởi động lại game để quay lại bảng 'Welcome Back!'.
       - Tự động điền chuỗi key 'FREE_...' vào ô 'KEY_example' và click 'Continue'.
       - Delta sẽ tự động kiểm tra và sinh file license riêng cho app đó!
    """
    global AUTO_RESTORE_DELTA_KEY, selected_packages, _last_key_trigger

    while not stop_event.is_set():
        try:
            if getattr(sys.modules[__name__], 'AUTO_RESTORE_DELTA_KEY', "Disable") != "Enable":
                stop_event.wait(10)
                continue

            bkey = load_bacon_api_key()
            if not bkey:
                stop_event.wait(15)
                continue

            now = time.time()
            expire_secs = KEY_EXPIRE_HOURS * 3600

            for item in selected_packages:
                pkg = item['pkg']
                last_trigger = _last_key_trigger.get(pkg, 0)
                if now - last_trigger < 300:  # Giãn cách 5 phút mỗi lần thử cho 1 pkg
                    continue

                # Kiểm tra app này đã có license hợp lệ từ game chưa
                pkg_dirs = [
                    "/storage/emulated/0/Delta/Internals/Cache",
                    "/sdcard/Delta/Internals/Cache",
                    f"/sdcard/Android/media/{pkg}/Delta/Internals/Cache",
                    f"/sdcard/Android/data/{pkg}/Delta/Internals/Cache",
                ]
                has_license = False
                for d in pkg_dirs:
                    lic = f"{d}/license"
                    mt = _get_file_mtime_root(lic)
                    if mt > 0 and (now - mt < expire_secs):
                        has_license = True
                        break

                if has_license:
                    continue  # App này đã có key hợp lệ, không cần nạp

                # App chưa có key hợp lệ -> Bắt đầu quy trình tự động lấy và nạp key
                _last_key_trigger[pkg] = now
                add_log(f"[Key] {pkg[-12:]} cần Key, bắt đầu xử lý...")

                # Bước 1: Kiểm tra xem đã có link Get Key sẵn trong Clipboard chưa
                clip = get_android_clipboard()
                target_url = extract_getkey_url(clip)

                if not target_url:
                    # Mở app để bảng Welcome Back xuất hiện
                    open_delta_getkey(pkg)
                    add_log("[Key] Chờ hiển thị bảng Welcome Back...")
                    stop_event.wait(6)  # Chờ 6s cho form load

                    # Tự động click nút "Receive Key" ở góc phải
                    click_receive_key_button()
                    stop_event.wait(2)

                    # Đóng trình duyệt Chrome vừa bị bật lên
                    close_browser_popups()

                    # Đọc lại Clipboard để lấy URL vừa được copy
                    clip = get_android_clipboard()
                    target_url = extract_getkey_url(clip)

                # Bước 2: Gửi URL lên Bacon API giải mã
                if target_url:
                    add_log(f"[Bacon] Giải mã link: {target_url[:20]}...")
                    try:
                        client = BaconBypassClient(api_key=bkey, timeout=90.0, max_retries=3)
                        key_res = client.bypass(target_url)
                        add_log(f"[Bacon] Nhận key: {key_res[:16]}...")

                        # Đóng lại trình duyệt nếu có
                        close_browser_popups()

                        # Bước 3: Khởi động lại game để quay lại bảng "Welcome Back!" nhập key
                        add_log(f"[Key] Khởi động lại {pkg[-12:]} để nhập key...")
                        safe_root(f"su -c 'am force-stop {pkg}'")
                        stop_event.wait(2)
                        safe_root(f"su -c 'monkey -p {pkg} -c android.intent.category.LAUNCHER 1 2>/dev/null'")
                        add_log("[Key] Chờ hiển thị bảng Enter Key...")
                        stop_event.wait(6)  # Chờ 6s cho game mở lại và hiển thị bảng Welcome Back

                        # Bước 4: Nhập chuỗi key 'FREE_...' vào khung và click 'Continue'
                        if not (key_res.startswith("http://") or key_res.startswith("https://")):
                            auto_enter_key_and_continue(key_res)
                            add_log("[Key] Đã điền key FREE_... & bấm Continue!")
                            stop_event.wait(5)
                        else:
                            # Nếu kết quả là URL kích hoạt Whitelist
                            _http_get_ping(key_res)
                            add_log("[Bacon] Đã ping URL kích hoạt!")
                            stop_event.wait(3)

                        # Bước 5: Kiểm tra Delta đã tự sinh file license chưa
                        created = False
                        for d in pkg_dirs:
                            lic = f"{d}/license"
                            if _get_file_mtime_root(lic) > 0:
                                created = True
                                break

                        if created:
                            add_log(f"[Key] {pkg[-12:]} đã tự sinh License thành công!")
                        else:
                            add_log(f"[Key] Đã submit key cho {pkg[-12:]}")

                    except BaconApiException as be:
                        add_log(f"[Bacon Lỗi] {str(be)[:25]}")
                else:
                    add_log("[Key] Chưa lấy được URL Get Key.")

                stop_event.wait(10)

        except Exception:
            pass
        stop_event.wait(15)

def start_auto_rejoin():
    global selected_packages, kill_all_time, json_path_cache, heartbeat_last_check, CLAIMED_NAMES, last_restart_time, pkg_restart_locks, global_restart_semaphore, file_to_pkg_binding
    if not selected_packages:
        print(f"{R}[!] Chọn package trước!{RESET}")
        time.sleep(2)
        return

    last_restart_time = {}
    last_any_restart_time = 0
    json_path_cache = {}
    heartbeat_last_check = {}
    CLAIMED_NAMES = set()
    pkg_restart_locks = {}
    global_restart_semaphore = threading.Semaphore(1)
    file_to_pkg_binding = {}

    print(f"\n{Y}[*] Inject script universal...{RESET}")
    inject_universal_lua()

    states = {}
    last_ok_ping = {}
    stop_event = threading.Event()
    sync_t = threading.Thread(target=delta_license_sync_thread, args=(stop_event,), daemon=True)
    sync_t.start()

