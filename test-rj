def test_method_3_xml_preferences(pkg, cookie, user_name, user_id):
    print(f"\n{C}=== [METHOD 3] TIÊM TOÀN BỘ FILE XML SHARED PREFERENCES ==={RESET}")
    run_su(f"am force-stop {pkg}")
    time.sleep(1)

    shared_dir = f"/data/data/{pkg}/shared_prefs"
    out = run_su(f"ls {shared_dir}/*.xml 2>/dev/null")
    xmls = [line.strip() for line in (out.splitlines() if out else []) if line.strip()]

    if not xmls:
        print(f"{R}[!] Không tìm thấy file XML nào trong {shared_dir}{RESET}")
        return False

    uid = run_su(f"stat -c %u /data/data/{pkg}") or "10000"
    print(f"{Y}[*] Phát hiện {len(xmls)} file XML SharedPreferences. Tiến hành nạp key security...{RESET}")

    for xml_path in xmls:
        raw = run_su(f"cat \"{xml_path}\" 2>/dev/null")
        if not raw or '<map>' not in raw:
            continue

        existing = {}
        try:
            root_el = ET.fromstring(raw)
            for s in root_el.findall('string'):
                k = s.get('name')
                if k: existing[k] = s.text
        except:
            pass

        # Nạp tất cả các key token biến thể
        existing['RobloxSecurityToken'] = cookie
        existing['ROBLOSECURITY'] = cookie
        existing['.ROBLOSECURITY'] = cookie
        if user_name:
            existing['Username'] = str(user_name)
            existing['RobloxUsername'] = str(user_name)
            existing['RBX_USERNAME'] = str(user_name)
        if user_id:
            existing['UserId'] = str(user_id)
            existing['RobloxUserId'] = str(user_id)
            existing['RBX_USER_ID'] = str(user_id)

        new_root = ET.Element('map')
        for k, v in existing.items():
            el = ET.SubElement(new_root, 'string', name=k)
            el.text = v if v is not None else ""

        xml_out = '<?xml version="1.0" encoding="utf-8" standalone="yes" ?>\n' + ET.tostring(new_root, encoding='unicode')
        
        tmp_xml = os.path.join(tempfile.gettempdir(), f"tmp_{os.path.basename(xml_path)}")
        with open(tmp_xml, 'w', encoding='utf-8') as f:
            f.write(xml_out)

        run_su(f"cp \"{tmp_xml}\" \"{xml_path}\" && chown {uid}:{uid} \"{xml_path}\" && chmod 660 \"{xml_path}\" && restorecon \"{xml_path}\" 2>/dev/null")
        if os.path.exists(tmp_xml): os.remove(tmp_xml)
        print(f"{G}  ├─ [✓] Updated XML: {os.path.basename(xml_path)}{RESET}")

    return True

