                }
            elif "captcha" in chal_type or "arkose" in chal_type or "captcha" in err_body:
                return {
                    "status": "CAPTCHA_CHECKPOINT",
                    "badge": "Dính Captcha Vào Game (Arkose)",
                    "color": Y,
                    "user_id": user_id,
                    "username": username or "N/A",
                    "challenge_type": "ARKOSE_CAPTCHA",
                    "challenge_id": chal_id,
