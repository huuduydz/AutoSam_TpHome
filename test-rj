def monitor_package(pkg, states, last_ok_ping, stop_event):
    """Thread độc lập cho từng package - không ảnh hưởng tab khác."""
    global kill_all_time, last_restart_time, CLAIMED_NAMES, CHECK_ACC_TIME_BLOCKED, CHECK_ACC_TIME_NORMAL, AUTO_CHECK_ACC_HEALTH
    while not stop_event.is_set():
        try:
            current_time = time.time()
            state = states[pkg]
            # session_start_time: thời điểm start lần đầu, KHÔNG reset khi rejoin
            # rejoin_time: chỉ dùng để tính warmup
            session_uptime = current_time - state['session_start_time']
            uptime_seconds = current_time - state['rejoin_time']

            # === XỬ LÝ TỰ ĐỘNG GIẢI CAPTCHAV2 / NHẤN VÀ GIỮ KHI ĐƯỢC BẮN VÀO GAME ===
            if state.get('handling_captcha_solve'):
                solve_elapsed = current_time - state.get('captcha_solve_start', current_time)
                time_left_solve = max(0, int(90 - solve_elapsed))
                state['text'] = f"Chờ Giữ Nút ({time_left_solve}s)"
                state['color'] = Y

                # Đảm bảo app đang chạy và đang load vào game
                if not is_app_running(pkg):
                    launch_roblox_to_game(pkg)
                    time.sleep(2)

                # Quét màn hình liên tục tìm popup "Bảo Mật / Nhấn và Giữ" và tự động giữ nút 15s
                sec_res = detect_press_and_hold_screen(pkg, auto_solve=True)
                if sec_res.get("detected"):
                    if sec_res.get("solved"):
                        add_log(f"[{pkg[-12:]}] {G}[✓ THÀNH CÔNG] Đã nhấn giữ 15s vượt qua CaptchaV2! Acc đã sạch!{RESET}")
                        state['handling_captcha_solve'] = False
                        state['is_blocked'] = False
                        state['block_reason'] = ''
                        state['account_status'] = 'OK'
                        state['text'] = "Đã Giải Xong -> Game"
                        state['color'] = G
                        state['last_acc_check'] = current_time
                        state['rejoin_time'] = current_time
                        state['warmup_until'] = current_time + 45
                        stop_event.wait(5)
                        continue
                    else:
                        add_log(f"[{pkg[-12:]}] {Y}[*] Đang thao tác nhấn giữ nút xác nhận trên màn hình...{RESET}")

                # Nếu tài khoản đã vào được trong game (có heartbeat checkhudyhub)
                bound_curr = state.get('bound_name')
                hb_curr = get_heartbeat(bound_curr, pkg) if bound_curr else -1
                if state.get('in_game') or (hb_curr != -1 and current_time - hb_curr <= 120):
                    add_log(f"[{pkg[-12:]}] {G}[✓] Phát hiện tài khoản đã vào game thành công (vượt qua CaptchaV2)!{RESET}")
                    state['handling_captcha_solve'] = False
                    state['is_blocked'] = False
                    state['block_reason'] = ''
                    state['account_status'] = 'OK'
                    state['in_game'] = True
                    state['last_acc_check'] = current_time
                    continue

                # Nếu hết 90s mà không giải được (ví dụ captcha dạng xoay ảnh cần mắt người giải)
                if solve_elapsed >= 90:
                    add_log(f"[{pkg[-12:]}] {R}[!] Hết 90s chờ bảng 'Nhấn và Giữ'. Tạm dừng để tránh treo máy.{RESET}")
                    state['handling_captcha_solve'] = False
                    state['is_blocked'] = True
                    state['block_reason'] = "Dính CaptchaV2 (Chờ Giải)"
                    state['last_acc_check'] = current_time
                    _kill_pkg(pkg)

                stop_event.wait(3)
                continue

            # === KIỂM TRA TRẠNG THÁI ACC ĐANG BỊ KẸT (NOT_APPROVED / CAPTCHA / EXPIRED) ===
            if state.get('is_blocked'):
                # Acc đang bị dính: KHÔNG VÀO GAME! Đảm bảo app tắt để không tốn tài nguyên
                if is_app_running(pkg):
                    _kill_pkg(pkg)

                last_check = state.get('last_acc_check', 0)
                recheck_interval = CHECK_ACC_TIME_BLOCKED
                time_passed = current_time - last_check
                time_left = max(0, int(recheck_interval - time_passed))

                short_reason = state.get('block_reason', 'Kẹt Acc')
                if "Not-Approved" in short_reason or "not-approved" in short_reason.lower():
                    lbl = "Kẹt Not-Approved"
                elif "Nhấn và Giữ" in short_reason or "Nhấn&Giữ" in short_reason or "Press & Hold" in short_reason or "Bảo Mật" in short_reason:
                    lbl = "Dính Nhấn&Giữ"
                elif "captchav2" in short_reason.lower() or "captchav2" in str(state.get('account_status')).lower():
                    lbl = "Dính CaptchaV2"
                elif "Captcha" in short_reason or "captcha" in short_reason.lower():
                    lbl = "Dính Captcha"
                elif "401" in short_reason or "Hết Hạn" in short_reason:
                    lbl = "Cookie Die (401)"
                else:
                    lbl = short_reason[:15]

                state['text'] = f"{lbl} ({time_left}s)"
                state['color'] = R if ("Not-Approved" in short_reason or "401" in short_reason or "Hết Hạn" in short_reason) else Y

                # Đến chu kỳ kiểm tra lại xem acc đã giải chưa
                if time_passed >= recheck_interval:
                    cookie = extract_roblox_cookie(pkg)
                    if cookie and state.get('cached_cookie') and state['cached_cookie'] != cookie:
                        add_log(f"[{pkg[-12:]}] {G}[ĐỔI ACC] Phát hiện cookie mới trong app!{RESET}")
                        state['is_blocked'] = False
                        state['block_reason'] = ''
                        state['bound_name'] = None
                        state['display_name'] = 'Đang đồng bộ...'

                    if not cookie:
                        cookie = state.get('cached_cookie')

                    state['last_acc_check'] = current_time
                    if cookie:
                        state['cached_cookie'] = cookie
                        res = check_roblox_account_status(cookie)
                        if res.get('username'):
                            state['bound_name'] = res['username']
                            state['display_name'] = res['username']

                        if res.get('status') == 'OK':
                            # Acc đã được giải hoặc acc mới sạch! Tiến hành Rejoin
                            state['is_blocked'] = False
                            state['block_reason'] = ''
                            state['account_status'] = 'OK'
                            state['kiwi_opened'] = False
                            state['text'] = "Acc Sạch -> Rejoin..."
                            state['color'] = G
                            u_name = res.get('username') or state.get('bound_name') or 'Acc'
                            add_log(f"[{pkg[-12:]}] {G}[ACC SẠCH] {u_name} ĐÃ BÌNH THƯỜNG! Đang Rejoin vào game...{RESET}")
                            safe_root("am force-stop com.kiwibrowser.browser 2>/dev/null || true")
                            with pkg_restart_locks[pkg]:
                                force_restart_app(pkg, states, current_time, "Acc Sạch -> Rejoin", G)
                            last_ok_ping[pkg] = current_time
                            stop_event.wait(5)
                            continue
                        elif res.get('status') == 'CAPTCHA_CHECKPOINT':
                            # Khi recheck vẫn thấy dính CaptchaV2 -> Lại bắn vào game để hiện bảng 'Nhấn và Giữ' tự giải!
                            add_log(f"[{pkg[-12:]}] {Y}[CAPTCHA V2] Bắn vào game để kích hoạt bảng 'Nhấn và Giữ' tự giải...{RESET}")
                            state['is_blocked'] = False
                            state['handling_captcha_solve'] = True
                            state['captcha_solve_start'] = current_time
                            state['text'] = "Bắn Game Giải Captcha..."
                            state['color'] = Y
                            launch_roblox_to_game(pkg)
                            stop_event.wait(3)
                            continue
                        else:
                            # Vẫn đang bị dính Not-Approved hoặc Cookie Die
                            state['is_blocked'] = True
                            badge = res.get('badge', 'Kẹt Acc')
                            state['block_reason'] = badge
                            state['account_status'] = res.get('status')
                            if res.get('status') == 'NOT_APPROVED' and not state.get('kiwi_opened'):
                                state['kiwi_opened'] = True
                                resolve_not_approved_with_kiwi(cookie, pkg)
                            add_log(f"[{pkg[-12:]}] Vẫn {badge} (chờ tiếp {recheck_interval}s)")
                    else:
                        add_log(f"[{pkg[-12:]}] Chưa lấy được Cookie để kiểm tra lại.")

                stop_event.wait(5)
                continue

            # === KIỂM TRA ĐANG TRONG TIẾN TRÌNH BOOT ===
            if pkg in _boot_threads and _boot_threads[pkg].is_alive():
                state['text'] = "Đang Khởi Động..."
                state['color'] = Y
                stop_event.wait(5)
                continue

            # === KIỂM TRA POPUP 'BẢO MẬT / NHẤN VÀ GIỮ' KHI APP ĐANG CHẠY MÀ CHƯA VÀO ĐƯỢC GAME ===
            bound = state.get('bound_name')
            hb = get_heartbeat(bound, pkg) if bound else -1
            if hb != -1 and (current_time - hb <= 120):
                state['in_game'] = True

            if uptime_seconds > 15 and is_app_running(pkg) and not state.get('in_game'):
                last_scr_chk = state.get('last_screen_security_check', 0)
                if current_time - last_scr_chk >= 8:
                    state['last_screen_security_check'] = current_time
                    sec_res = detect_press_and_hold_screen(pkg, auto_solve=True)
                    if sec_res.get("detected"):
                        ref = sec_res.get('ref_id', 'N/A')
                        if sec_res.get("solved"):
                            add_log(f"[{pkg[-12:]}] {G}[BẢO MẬT] Đã tự động 'Nhấn và Giữ' thành công! Đang vào game...{RESET}")
                            state['last_acc_check'] = current_time
                            state['rejoin_time'] = current_time
                            state['warmup_until'] = current_time + 45
                        else:
                            add_log(f"[{pkg[-12:]}] {Y}[BẢO MẬT] Phát hiện màn hình 'Nhấn và Giữ' (ID: {ref[:8]}..)! Đang chuyển chế độ giữ nút...{RESET}")
                            state['handling_captcha_solve'] = True
                            state['captcha_solve_start'] = current_time
                            stop_event.wait(2)
                            continue

            # === ĐẢM BẢO PROCESS APP PHẢI CHẠY (NẾU KHÔNG CHẠY THÌ BẬT NGAY) ===
            if uptime_seconds > 15 and not is_app_running(pkg):
                # Kiểm tra xem acc có bị kẹt Not-Approved/Captcha không trước khi bật lại
                if check_and_handle_account_health(pkg, states, current_time):
                    stop_event.wait(5)
                    continue

                can_restart = pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 180
                if can_restart:
                    with pkg_restart_locks[pkg]:
                        force_restart_app(pkg, states, current_time, "App không chạy!", R)
                    last_ok_ping[pkg] = current_time
                else:
                    state['text'] = 'App tắt, chờ...'
                    state['color'] = R
                stop_event.wait(5)
                continue

            # === AUTO RESTART THEO THỜI GIAN (dùng session_uptime, tích lũy qua rejoin) ===
            if kill_all_time > 0 and session_uptime / 60 >= kill_all_time:
                if check_and_handle_account_health(pkg, states, current_time):
                    stop_event.wait(5)
                    continue

                with pkg_restart_locks[pkg]:
                    force_restart_app(pkg, states, current_time, f"Auto Restart ({kill_all_time}m)", M)
                # Reset session timer sau khi auto restart
                state['session_start_time'] = current_time
                last_ok_ping[pkg] = current_time
                stop_event.wait(10)
                continue

            # === WARMUP ===
            if current_time < state.get('warmup_until', 0):
                state['text'] = f"Warmup ({int(state['warmup_until'] - current_time)}s)"
                state['color'] = Y
                stop_event.wait(5)
                continue

            # === TÌM TÊN NẾU CHƯA BIND ===
            if not state['bound_name']:
                found = discover_unbound_account(pkg, states)
                if found:
                    state['bound_name'] = found
                    state['display_name'] = found

            bound = state['bound_name']
            is_grace = (uptime_seconds < 120)  # 150s thay vì 240s → detect fail nhanh hơn

            # === CHƯ A BIND ĐƯỢC TÊN ===
            if not bound:
                if is_grace:
                    # Nếu app không chạy sau 30s warmup → restart ngay
                    if uptime_seconds > 30 and not is_app_running(pkg):
                        if check_and_handle_account_health(pkg, states, current_time):
                            stop_event.wait(5)
                            continue
                        can_restart = pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 180
                        if can_restart:
                            with pkg_restart_locks[pkg]:
                                force_restart_app(pkg, states, current_time, "App không mở được!", R)
                            last_ok_ping[pkg] = current_time
                        else:
                            state['text'] = 'App lỗi, đang chờ...'
                            state['color'] = R
                    else:
                        state['text'] = f"Đang Load ({int(150 - uptime_seconds)}s)"
                        state['color'] = Y
                else:
                    if check_and_handle_account_health(pkg, states, current_time):
                        stop_event.wait(5)
                        continue
                    can_restart = pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 180
                    if can_restart:
                        with pkg_restart_locks[pkg]:
                            force_restart_app(pkg, states, current_time, "Chưa Load/Kẹt Bind!", R)
                        last_ok_ping[pkg] = current_time
                    else:
                        wait_sec = int(180 - (current_time - last_restart_time.get(pkg, current_time)))
                        state['text'] = f"Chờ Restart ({wait_sec}s)"
                        state['color'] = R
                stop_event.wait(10)
                continue

            # === CHECK HEARTBEAT ===
            # Nếu pkg khác vừa restart (< 180s), cho thêm grace để tránh cascade
            other_just_restarted = (current_time - last_any_restart_time < 90) and \
                                   (last_any_restart_time != last_restart_time.get(pkg, 0))

            last_ping = get_heartbeat(bound, pkg)
            if last_ping == -1:
                state['heartbeat_misses'] = state.get('heartbeat_misses', 0) + 1
                misses = state['heartbeat_misses']
                if is_grace or other_just_restarted:
                    remain = int(240 - uptime_seconds) if is_grace else int(180 - (current_time - last_any_restart_time))
                    state['text'] = f"Đang Nạp Data ({max(0,remain)}s)"
                    state['color'] = Y
                elif misses >= 3 and (pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 90):
                    # Cần 3 miss liên tiếp (~30s) mới restart - kiểm tra acc trước khi restart
                    if check_and_handle_account_health(pkg, states, current_time):
                        stop_event.wait(5)
                        continue
                    with pkg_restart_locks[pkg]:
                        force_restart_app(pkg, states, current_time, "Treo Màn/Chưa Vô Game!", R)
                    last_ok_ping[pkg] = current_time
                    state['heartbeat_misses'] = 0
                else:
                    state['text'] = f"Mất HB ({misses}/3 lần)..."
                    state['color'] = Y
            else:
                state['heartbeat_misses'] = 0  # Reset khi có heartbeat
                diff = current_time - last_ping
                if diff <= 120:
                    last_ok_ping[pkg] = current_time
                    state['in_game'] = True
                real_diff = current_time - last_ok_ping.get(pkg, current_time)
                if diff > 120:
                    state['in_game'] = False
                    if is_grace or other_just_restarted:
                        remain = int(240 - uptime_seconds) if is_grace else int(180 - (current_time - last_any_restart_time))
                        state['text'] = f"Vào Server... ({max(0,remain)}s)"
                        state['color'] = Y
                    elif real_diff >= 120 and (pkg not in last_restart_time or current_time - last_restart_time[pkg] >= 90):
                        if check_and_handle_account_health(pkg, states, current_time):
                            stop_event.wait(5)
                            continue
                        with pkg_restart_locks[pkg]:
                            force_restart_app(pkg, states, current_time, f"Văng Game ({int(diff)}s)", R)
                        last_ok_ping[pkg] = current_time
                    elif real_diff < 120:
                        state['text'] = f"Cảnh báo lag ({int(diff)}s)"
                        state['color'] = Y
                else:
                    state['in_game'] = True
                    state['text'] = f"Đang Farm ({int(diff)}s trước)"
                    state['color'] = G
                    # Acc đang farm bình thường trong game -> cập nhật last_acc_check, tuyệt đối không làm gián đoạn
                    state['last_acc_check'] = current_time
        except Exception as e:
            # Ghi lỗi nhưng không crash thread - quan trọng cho 24/7
            try:
                states[pkg]['text'] = f"Lỗi ({str(e)[:15]})"
                states[pkg]['color'] = R
            except:
                pass
        stop_event.wait(10)



