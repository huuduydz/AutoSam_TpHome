def test_method_2_webview_sqlite(pkg, cookie):
    print(f"\n{C}=== [METHOD 2] TIÊM ĐA DẠNG NỀN TẢNG CHUẨN SQLITE WEBVIEW ==={RESET}")
    run_su(f"am force-stop {pkg}")
    time.sleep(1)

    # Tìm tất cả file db
    find_cmd = f"find /data/data/{pkg}/ -name \"Cookies\" -o -iname \"*cookie*.db\" 2>/dev/null"
    out = run_su(find_cmd)
    dbs = [line.strip() for line in (out.splitlines() if out else []) if line.strip()]
    
    if not dbs:
        dbs = [f"/data/data/{pkg}/app_webview/Default/Cookies", f"/data/data/{pkg}/app_webview/Cookies"]
    
    print(f"{Y}[*] Tìm thấy {len(dbs)} file DB Cookies:{RESET}")
    for db in dbs:
        print(f"    - {db}")

    uid = run_su(f"stat -c %u /data/data/{pkg}") or "10000"
    tmp_dir = os.path.join(tempfile.gettempdir(), "test_cookies")
    os.makedirs(tmp_dir, exist_ok=True)

    now_1601 = (int(time.time()) + 11644473600) * 1000000
    exp_1601 = (int(time.time()) + 10 * 365 * 86400 + 11644473600) * 1000000

    success_count = 0
    for idx, db_path in enumerate(dbs, 1):
        local_db = os.path.join(tmp_dir, f"test_db_{idx}.db")
        run_su(f"cp \"{db_path}\" \"{local_db}\" && chmod 666 \"{local_db}\"")
        if not os.path.exists(local_db):
            print(f"{R}[!] Không copy được {db_path}{RESET}")
            continue

        try:
            conn = sqlite3.connect(local_db)
            c = conn.cursor()
            c.execute("SELECT name FROM sqlite_master WHERE type='table' AND name='cookies'")
            if not c.fetchone():
                conn.close()
                os.remove(local_db)
                continue

            c.execute("PRAGMA table_info(cookies)")
            cols = [col[1] for col in c.fetchall()]

            hosts = ['.roblox.com', 'www.roblox.com', 'roblox.com', '.www.roblox.com', 'api.roblox.com', '.api.roblox.com']
            cookie_names = ['.ROBLOSECURITY', 'ROBLOSECURITY', 'RobloxSecurityToken']

            for hk in hosts:
                for cname in cookie_names:
                    data = {
                        'creation_utc': now_1601,
                        'top_frame_site_key': 'https://roblox.com',
                        'host_key': hk,
                        'name': cname,
                        'value': cookie,
                        'encrypted_value': b'',
                        'path': '/',
                        'expires_utc': exp_1601,
                        'is_secure': 1,
                        'is_httponly': 1,
                        'last_access_utc': now_1601,
                        'has_expires': 1,
                        'is_persistent': 1,
                        'priority': 1,
                        'samesite': -1,
                        'source_scheme': 2,
                        'source_port': 443,
                        'is_same_party': 0
                    }
                    valid_cols = [k for k in data if k in cols]
                    vals = [data[k] for k in valid_cols]
                    placeholders = ','.join(['?' for _ in valid_cols])
                    c.execute("DELETE FROM cookies WHERE (host_key=? OR host_key=?) AND name=?", (hk, hk.lstrip('.'), cname))
                    sql = f"INSERT INTO cookies ({','.join(valid_cols)}) VALUES ({placeholders})"
                    c.execute(sql, vals)

            conn.commit()
            conn.close()

            # Chép đè & xóa sạch WAL
            run_su(f"cp \"{local_db}\" \"{db_path}\" && rm -f \"{db_path}-wal\" \"{db_path}-shm\" \"{db_path}-journal\" 2>/dev/null")
            run_su(f"chown {uid}:{uid} \"{db_path}\" && chmod 660 \"{db_path}\" && restorecon \"{db_path}\" 2>/dev/null || true")
            os.remove(local_db)
            print(f"{G}[✓] Đã tiêm thành công SQLite DB: {db_path}{RESET}")
            success_count += 1
        except Exception as e:
            print(f"{R}[✗] Lỗi xử lý DB {db_path}: {e}{RESET}")

    return success_count > 0

