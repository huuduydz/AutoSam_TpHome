def resolve_not_approved_with_kiwi(cookie, pkg=None):
    """
    Tự động xử lý tài khoản bị kẹt Not-Approved / Checkpoint duyệt:
    1. Kiểm tra Kiwi Browser (com.kiwibrowser.browser) đã cài trên máy chưa.
    2. Tắt Kiwi Browser, trích xuất cookie và tiêm .ROBLOSECURITY vào Cookies DB của Kiwi.
    3. Mở thẳng https://www.roblox.com/not-approved trên Kiwi Browser để người dùng
       hoặc extension YesCaptcha tự động giải Arkose Captcha và bấm Re-activate / Đồng ý.
    """
    if not cookie:
        add_log(f"{R}[KIWI] Không có cookie để tiêm vào Kiwi Browser!{RESET}")
        return False

    pkg_tag = pkg[-12:] if pkg else "KIWI"

    # 1. Kiểm tra Kiwi Browser đã cài trên máy chưa
    code, out, _ = _run_root_capture("pm path com.kiwibrowser.browser 2>/dev/null", timeout=3)
    if code != 0 or not out.strip():
        add_log(f"[{pkg_tag}] {R}[KIWI] Chưa cài Kiwi Browser (com.kiwibrowser.browser) trên máy! Hãy cài Kiwi Browser từ CH Play hoặc APK.{RESET}")
        return False

    add_log(f"[{pkg_tag}] {C}[KIWI] Đang chuẩn bị tiêm Cookie tài khoản vào Kiwi Browser...{RESET}")

    # 2. Đảm bảo Kiwi tắt trước khi can thiệp SQLite DB
    safe_root("am force-stop com.kiwibrowser.browser", timeout=5)
    time.sleep(1)

    # 3. Kiểm tra xem Kiwi đã có file DB chưa
    code_find, out_find, _ = _run_root_capture(
        "find '/data/data/com.kiwibrowser.browser/' \\( -name 'Cookies' -o -iname '*cookie*.db' \\) -type f 2>/dev/null",
        timeout=3
    )
    if not out_find.strip():
        # Chưa có DB -> Khởi chạy Kiwi 3s để sinh profile Chromium mặc định
        add_log(f"[{pkg_tag}] {Y}[KIWI] Khởi tạo profile mặc định cho Kiwi...{RESET}")
        safe_root("am start -n com.kiwibrowser.browser/com.google.android.apps.chrome.Main", timeout=5)
        time.sleep(3)
        safe_root("am force-stop com.kiwibrowser.browser", timeout=5)
        time.sleep(1)

    # 4. Thử tiêm Cookie vào WebView/Chromium DB của Kiwi (dự phòng)
    clean_cookie = _normalize_roblosecurity_cookie(cookie)
    try:
        inject_cookie_webview("com.kiwibrowser.browser", clean_cookie)
    except:
        pass

    # 5. Mở Kiwi Browser kèm tham số hash #rbx_cookie=...
    # Extension YesCaptcha (roblox_helper.js) sẽ tự động bắt hash, gọi chrome.cookies.set()
    # để đăng nhập trực tiếp trên trình duyệt và tự động bấm 'Tiếp tục' / 'Reactivate'!
    add_log(f"[{pkg_tag}] {G}[KIWI] Đang mở Kiwi Browser nạp Cookie & giải Not-Approved qua Extension...{RESET}")
    import urllib.parse
    encoded_cookie = urllib.parse.quote(clean_cookie)
    open_url = f"https://www.roblox.com/login#rbx_cookie={encoded_cookie}"
    open_cmd = f"am start -a android.intent.action.VIEW -d '{open_url}' -p com.kiwibrowser.browser"
    safe_root(open_cmd, timeout=6)
    return True

