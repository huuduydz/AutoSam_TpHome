def run_su(cmd, timeout=10):
    """Thực thi lệnh SU ROOT trên Android."""
    try:
        res = subprocess.check_output(f"su -c '{cmd}'", shell=True, text=True, timeout=timeout).strip()
        return res
    except Exception as e:
        return None

def fix_tty():
    """Khôi phục chế độ TTY terminal và tắt bracketed paste mode."""
    try:
        os.system("stty sane 2>/dev/null")
        sys.stdout.write('\033[?2004l')
        sys.stdout.flush()
    except:
        pass

def safe_input(prompt=''):
    """Input an toàn cho Termux: tự động sửa TTY và lọc ký tự rác."""
    fix_tty()
    try:
        res = input(prompt)
    except Exception:
        return ""
    if not res:
        return ""
    # Lọc các escape sequence ANSI
    cleaned = re.sub(r'\x1b\[[0-9;]*[a-zA-Z]', '', res).strip()
    return cleaned

def verify_cookie(cookie):
    """Kiểm tra Cookie có sống hay không qua Roblox API."""
    try:
        req = urllib.request.Request(
            "https://users.roblox.com/v1/users/authenticated",
            headers={
                "Cookie": f".ROBLOSECURITY={cookie}",
                "User-Agent": "Roblox/WinInet"
            }
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode('utf-8'))
                return True, data.get('name', 'Unknown'), data.get('id', 0)
    except Exception as e:
        return False, str(e), 0
    return False, "Invalid Cookie", 0

def get_auth_ticket(cookie):
    """Tạo Auth Ticket từ Roblox Auth API."""
    headers = {
        "Cookie": f".ROBLOSECURITY={cookie}",
        "Content-Type": "application/json",
        "Referer": "https://www.roblox.com/",
        "Origin": "https://www.roblox.com",
        "User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36"
    }

    # Bước 1: Lấy X-CSRF-TOKEN
    csrf_token = None
    req = urllib.request.Request(
        "https://auth.roblox.com/v1/authentication-ticket/",
        data=b"{}",
        headers=headers,
        method="POST"
    )
    try:
        with urllib.request.urlopen(req, timeout=8) as resp:
            csrf_token = resp.headers.get("x-csrf-token") or resp.headers.get("X-CSRF-TOKEN")
    except urllib.error.HTTPError as e:
        csrf_token = e.headers.get("x-csrf-token") or e.headers.get("X-CSRF-TOKEN")
    except Exception as e:
        return None, f"Lỗi kết nối CSRF: {str(e)}"

    if not csrf_token:
        try:
            req_l = urllib.request.Request("https://auth.roblox.com/v1/logout", data=b"{}", headers=headers, method="POST")
            with urllib.request.urlopen(req_l, timeout=8) as resp_l:
                csrf_token = resp_l.headers.get("x-csrf-token") or resp_l.headers.get("X-CSRF-TOKEN")
        except urllib.error.HTTPError as e:
            csrf_token = e.headers.get("x-csrf-token") or e.headers.get("X-CSRF-TOKEN")
        except:
            pass

    if not csrf_token:
        return None, "Không lấy được X-CSRF-Token"

    # Bước 2: Yêu cầu sinh Auth Ticket
    headers["x-csrf-token"] = csrf_token
    headers["X-CSRF-TOKEN"] = csrf_token
    req2 = urllib.request.Request(
        "https://auth.roblox.com/v1/authentication-ticket/",
        data=b"{}",
        headers=headers,
        method="POST"
    )
    try:
        with urllib.request.urlopen(req2, timeout=8) as resp2:
            ticket = resp2.headers.get("rbx-authentication-ticket") or resp2.headers.get("RBX-Authentication-Ticket")
            if ticket:
                return ticket, "Thành công"
    except urllib.error.HTTPError as e:
        ticket = e.headers.get("rbx-authentication-ticket") or e.headers.get("RBX-Authentication-Ticket")
        if ticket:
            return ticket, "Thành công"
        return None, f"Lỗi HTTP {e.code}"
    except Exception as e:
        return None, str(e)
    return None, "Không tạo được Auth Ticket"

