def run_su(cmd, timeout=10):
    """Thực thi lệnh SU ROOT trên Android."""
    try:
        res = subprocess.check_output(f"su -c '{cmd}'", shell=True, text=True, timeout=timeout).strip()
        return res
    except Exception as e:
        return None

def verify_cookie(cookie):
    """Kiểm tra Cookie có sống hay không qua Roblox API."""
    try:
        req = urllib.request.Request(
            "https://users.roblox.com/v1/users/authenticated",
            headers={
                "Cookie": f".ROBLOSECURITY={cookie}",
                "User-Agent": "Roblox/WinInet"
            }
        )
        with urllib.request.urlopen(req, timeout=8) as resp:
            if resp.status == 200:
                data = json.loads(resp.read().decode('utf-8'))
                return True, data.get('name', 'Unknown'), data.get('id', 0)
    except Exception as e:
        return False, str(e), 0
    return False, "Invalid Cookie", 0

def get_auth_ticket(cookie):
    """Tạo Auth Ticket từ Roblox Auth API."""
    try:
        req = urllib.request.Request(
            "https://auth.roblox.com/v1/authentication-ticket/",
            data=b"{}",
            headers={
                "Cookie": f".ROBLOSECURITY={cookie}",
                "Content-Type": "application/json",
                "Referer": "https://www.roblox.com/"
            },
            method="POST"
        )
        csrf_token = None
        try:
            with urllib.request.urlopen(req, timeout=5) as resp:
                csrf_token = resp.headers.get("x-csrf-token")
        except urllib.error.HTTPError as e:
            if e.code == 403:
                csrf_token = e.headers.get("x-csrf-token")
        
        if not csrf_token:
            return None, "Không lấy được X-CSRF-Token"

        req2 = urllib.request.Request(
            "https://auth.roblox.com/v1/authentication-ticket/",
            data=b"{}",
            headers={
                "Cookie": f".ROBLOSECURITY={cookie}",
                "Content-Type": "application/json",
                "Referer": "https://www.roblox.com/",
                "x-csrf-token": csrf_token
            },
            method="POST"
        )
        with urllib.request.urlopen(req2, timeout=5) as resp2:
            ticket = resp2.headers.get("rbx-authentication-ticket")
            if ticket:
                return ticket, "Thành công"
    except Exception as e:
        return None, str(e)
    return None, "Không tạo được Auth Ticket"

