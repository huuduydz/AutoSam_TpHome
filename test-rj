def detect_press_and_hold_screen(pkg=None, auto_solve=False):
    """
    Quét màn hình Android (bằng uiautomator dump) để nhận biết cửa sổ thử thách Bảo Mật:
    - Tiêu đề: 'Bảo Mật' / 'Security'
    - Nội dung: 'Nhấn giữ nút để xác nhận bạn là người thật' / 'Press and hold to confirm you are human'
    - Nút: 'Nhấn và Giữ' / 'Press and Hold'
    - ID tham chiếu: 'ID tham chiếu cdc336c0-...' / 'Reference ID ...'
    
    Nếu auto_solve=True:
    - Tự động lấy tọa độ tâm của nút 'Nhấn và Giữ'
    - Thực hiện long-press: input swipe cx cy cx cy 4500 (nhấn giữ 4.5s)
    - Trả về kết quả giải quyết.
    """
    try:
        dump_file = "/data/local/tmp/dump_security.xml"
        _run_root_capture(f"uiautomator dump '{dump_file}' 2>/dev/null", timeout=6)
        code, xml_str, _ = _run_root_capture(f"cat '{dump_file}' 2>/dev/null", timeout=4)
        _run_root_capture(f"rm -f '{dump_file}' 2>/dev/null", timeout=2)
        if code != 0 or not xml_str:
            return {"detected": False}

        xml_lower = xml_str.lower()
        keywords_vn = ["nhấn giữ nút", "xác nhận bạn là người thật", "nhấn và giữ", "nhấn giữ"]
        keywords_en = ["press and hold to confirm", "confirm you are human", "press and hold", "press & hold", "confirm that you are human"]
        has_vn = any(k in xml_lower for k in keywords_vn)
        has_en = any(k in xml_lower for k in keywords_en)
        has_sec = ("bảo mật" in xml_lower or "security" in xml_lower) and ("người thật" in xml_lower or "human" in xml_lower or "id tham chiếu" in xml_lower or "reference id" in xml_lower)

        if not (has_vn or has_en or has_sec):
            return {"detected": False}

        ref_m = re.search(r'(?:id tham chiếu|reference id)[:\s]*([a-f0-9\-]+)', xml_str, re.I)
        ref_id = ref_m.group(1) if ref_m else "N/A"

        btn_coords = None

        # 1. Parse bằng XML Tree: Lọc chuẩn xác và loại trừ dòng text hướng dẫn ở trên
        try:
            root = ET.fromstring(xml_str)
            candidates = []
            for node in root.iter('node'):
                text = (node.get('text') or '').strip()
                desc = (node.get('content-desc') or '').strip()
                cls = (node.get('class') or '').strip()
                bounds = node.get('bounds') or ''
                m_b = re.search(r'\[(\d+),(\d+)\]\[(\d+),(\d+)\]', bounds)
                if not m_b:
                    continue
                x1, y1, x2, y2 = map(int, m_b.groups())
                cx = (x1 + x2) // 2
                cy = (y1 + y2) // 2
                w = x2 - x1
                h = y2 - y1

                combined = (text or desc).lower()

                # LOẠI TRỪ DÒNG HƯỚNG DẪN Ở TRÊN (ví dụ: "Nhấn giữ nút để xác nhận bạn là người thật."):
                if any(k in combined for k in ["để xác nhận", "xác nhận bạn", "người thật", "human", "nút để", "tham chiếu", "reference", "bảo mật", "security"]):
                    continue

                # ƯU TIÊN 1: Text chính xác là "Nhấn và Giữ" hoặc "Press and Hold"
                if combined in ["nhấn và giữ", "press and hold", "press & hold"]:
                    candidates.append((100, cx, cy, text or desc))
                # ƯU TIÊN 2: Chứa "nhấn và giữ" và là button hoặc clickable
                elif "nhấn và giữ" in combined or "press and hold" in combined or "press & hold" in combined:
                    score = 50
                    if "button" in cls.lower() or node.get('clickable') == 'true':
                        score += 30
                    candidates.append((score, cx, cy, text or desc))
                # ƯU TIÊN 3: Thẻ Button có clickable = true ở khu vực giữa màn hình (dưới dòng text hướng dẫn)
                elif "button" in cls.lower() and node.get('clickable') == 'true' and h >= 30 and w >= 80:
                    candidates.append((20, cx, cy, text or desc or cls))

            if candidates:
                candidates.sort(key=lambda c: c[0], reverse=True)
                btn_coords = (candidates[0][1], candidates[0][2])
        except Exception:
            pass

        # 2. Dự phòng bằng Regex: CHỈ BẮT CHÍNH XÁC NÚT "Nhấn và Giữ", tuyệt đối không bắt "Nhấn giữ nút..."
        if not btn_coords:
            btn_patterns = [
                r'text="(?:\s*Nhấn và Giữ\s*|\s*Press and Hold\s*|\s*Press & Hold\s*)"[^>]*bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"',
                r'bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"[^>]*text="(?:\s*Nhấn và Giữ\s*|\s*Press and Hold\s*|\s*Press & Hold\s*)"',
                r'content-desc="(?:\s*Nhấn và Giữ\s*|\s*Press and Hold\s*|\s*Press & Hold\s*)"[^>]*bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"',
                r'bounds="\[(\d+),(\d+)\]\[(\d+),(\d+)\]"[^>]*content-desc="(?:\s*Nhấn và Giữ\s*|\s*Press and Hold\s*|\s*Press & Hold\s*)"'
            ]
            for pat in btn_patterns:
                m = re.search(pat, xml_str, re.I)
                if m:
                    if pat.startswith(r'bounds='):
                        x1, y1, x2, y2 = int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4))
                    else:
                        x1, y1, x2, y2 = int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4))
                    btn_coords = ((x1 + x2) // 2, (y1 + y2) // 2)
                    break

        # 3. Tọa độ mặc định chuẩn màn hình ngang (Landscape) của nút xanh "Nhấn và Giữ" (khoảng 28% chiều cao)
        if not btn_coords:
            w, h = get_screen_resolution()
            btn_coords = (w // 2, int(h * 0.28))

        solved = False
        if auto_solve and btn_coords:
            cx, cy = btn_coords
            add_log(f"[{pkg[-12:] if pkg else 'BẢO MẬT'}] {Y}Phát hiện 'Nhấn và Giữ' (ID: {ref_id[:8]}..)! Đang tự động giữ nút ({cx}, {cy}) 15s...{RESET}")
            safe_root(f"su -c 'input swipe {cx} {cy} {cx} {cy} 15000'", timeout=22)
            time.sleep(2.5)

            _run_root_capture(f"uiautomator dump '{dump_file}' 2>/dev/null", timeout=6)
            _, chk_xml, _ = _run_root_capture(f"cat '{dump_file}' 2>/dev/null", timeout=4)
            _run_root_capture(f"rm -f '{dump_file}' 2>/dev/null", timeout=2)
            if chk_xml:
                chk_lower = chk_xml.lower()
                still_has = any(k in chk_lower for k in keywords_vn + keywords_en)
                if not still_has:
                    solved = True
                    add_log(f"[{pkg[-12:] if pkg else 'BẢO MẬT'}] {G}[✓] Đã giữ 15s và giải quyết thành công màn hình 'Nhấn và Giữ'!{RESET}")

        return {
            "detected": True,
            "type": "PRESS_AND_HOLD",
            "badge": "Dính Captcha 'Nhấn và Giữ' (Bảo Mật)",
            "ref_id": ref_id,
            "btn_coords": btn_coords,
            "solved": solved
        }
    except Exception:
        return {"detected": False}

