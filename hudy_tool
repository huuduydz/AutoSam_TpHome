                for pkg, uid in active_accounts:
                    lnk = slmap.get(pkg) or slmap.get("__all__")
                    if stop_event.is_set():
                        return
                    if lnk:
                        if stop_event.wait(REJOIN_DELAY):
                            return
                        if not kill_roblox_process(pkg):
                            continue
                        if stop_event.wait(kill_delay):
                            return
                        if not launch_roblox(pkg, lnk):
                            continue
                        pending_rejoin.pop(pkg, None)
                        pending_log_rejoin.pop(pkg, None)
                        grace_t[pkg] = time.monotonic() + JOIN_GRACE_PERIOD
                        if stop_event.wait(REJOIN_SPACING):
                            return
                continue
            if now - last_health_check > 90:
                last_health_check = now
                for pkg, uid in active_accounts:
                    if stop_event.is_set():
                        return
                    if check_account_health(pkg, slmap) == "switched":
                        grace_t[pkg] = time.monotonic() + JOIN_GRACE_PERIOD
            uids_to_check = [uid for pkg, uid in active_accounts if grace_t.get(pkg, 0) <= now]
            presence_map = check_users_online_batch(uids_to_check)
            rejoin_queue = []
            for pkg, uid in active_accounts:
                if stop_event.is_set():
                    return
                lnk = slmap.get(pkg) or slmap.get("__all__")
                if not lnk:
                    continue
                uname = get_username(uid)
                if no_rejoin_captcha and pkg in captcha_packages:
                    package_statuses[pkg] = {"Username": uname, "Status": f"{LR}Captcha Hold{RS}"}
                    continue
                if no_rejoin_faceid and pkg in faceid_packages:
                    package_statuses[pkg] = {"Username": uname, "Status": f"{LR}FaceID Hold{RS}"}
                    continue
                if grace_t.get(pkg, 0) > now:
                    package_statuses[pkg] = {"Username": uname, "Status": "In Lobby"}
                    continue
                is_running = pkg in running_pkgs
                if not is_running:
                    msg(f"{uname} ({uid}) closed/offline. Rejoining...", "warn")
                    rejoin_queue.append((pkg, uid, lnk, "Closed"))
                    continue
                log_stat = pending_log_rejoin.get(pkg) or check_package_log_status(pkg)
                if log_stat in ("kicked", "frozen"):
                    pending_log_rejoin[pkg] = log_stat
                if log_stat == "kicked":
                    msg(f"{uname} ({uid}) log detected Kick/AFK/Popup! Rejoining...", "warn")
                    rejoin_queue.append((pkg, uid, lnk, "Kicked"))
                    continue
                elif log_stat == "frozen":
                    msg(f"{uname} ({uid}) game frozen! Rejoining...", "warn")
                    rejoin_queue.append((pkg, uid, lnk, "Frozen"))
                    continue
                if check_exec_enable:
                    started_at = exec_start_times.get(pkg, 0)
                    if started_at > 0 and (now - started_at) > exec_timeout:
                        if not check_executor_status(pkg, uid):
                            msg(f'{uname}' + ' (' + f'{uid}' + _tr(') Executor khong phan hoi sau ') + f'{exec_timeout}' + 's! Rejoining...', "warn")
                            rejoin_queue.append((pkg, uid, lnk, "ExecTimeout"))
                            continue
                status = presence_map.get(str(uid))
                if status is None:
                    pending_rejoin.pop(pkg, None)
                    offline_c[pkg] = lobby_c[pkg] = 0
                    package_statuses[pkg] = {"Username": uname, "Status": f"{LY}Presence Unknown{RS}"}
                    continue
                if status == 2:
                    pending_rejoin.pop(pkg, None)
                    pending_log_rejoin.pop(pkg, None)
                    offline_c[pkg] = 0
                    lobby_c[pkg] = 0
                    package_statuses[pkg] = {"Username": uname, "Status": f"{LG}Playing{RS}"}
                elif status == 3:
                    offline_c[pkg] = lobby_c[pkg] = 0
                    package_statuses[pkg] = {"Username": uname, "Status": "Studio"}
                elif status == 0:
                    lobby_c[pkg] = 0
                    offline_c[pkg] = offline_c.get(pkg, 0) + 1
                    package_statuses[pkg] = {"Username": uname, "Status": f"{LY}Offline/Loading ({offline_c[pkg]}/{NUM_RETRIES}){RS}"}
                    if offline_c[pkg] >= NUM_RETRIES:
                        msg(f"{uname} ({uid}) offline timeout. Rejoining...", "warn")
                        rejoin_queue.append((pkg, uid, lnk, "Offline"))
                elif status == 1:
                    offline_c[pkg] = 0
                    lobby_c[pkg] = lobby_c.get(pkg, 0) + 1
                    package_statuses[pkg] = {"Username": uname, "Status": f"{LY}In Lobby ({lobby_c[pkg]}/{NUM_RETRIES}){RS}"}
                    if lobby_c[pkg] >= NUM_RETRIES:
                        msg(f"{uname} ({uid}) kicked to Lobby! Rejoining...", "warn")
                        rejoin_queue.append((pkg, uid, lnk, "Lobby"))
            queued = {pkg for pkg, _, _, _ in rejoin_queue}
            for pkg in set(pending_rejoin).difference(queued):
                pending_rejoin.pop(pkg, None)
            for pkg in queued:
                pending_rejoin.setdefault(pkg, time.monotonic() + REJOIN_DELAY)
            rejoin_queue = [item for item in rejoin_queue if time.monotonic() >= pending_rejoin[item[0]]]
            if rejoin_queue:
                if one_kill_enable and len(active_accounts) > 1:
                    msg(_tr('Che do Kill All khi 1 tab vang dang bat! Khoi dong lai tat ca tab...'), "warn")
                    rejoin_queue = [(p, u, slmap.get(p) or slmap.get("__all__"), "1KillSync") for p, u in active_accounts if (slmap.get(p) or slmap.get("__all__")) and not (no_rejoin_captcha and p in captcha_packages) and not (no_rejoin_faceid and p in faceid_packages)]
                for pkg, uid, lnk, reason in rejoin_queue:
                    if stop_event.is_set():
                        return
                    if not kill_roblox_process(pkg):
                        pending_rejoin[pkg] = time.monotonic() + max(10, REJOIN_DELAY)
                        continue
                    if stop_event.wait(kill_delay):
                        return
                    if not launch_roblox(pkg, lnk):
                        grace_t[pkg] = time.monotonic() + max(10, TIME_RETRY)
                        continue
                    pending_rejoin.pop(pkg, None)
                    offline_c[pkg] = 0
                    lobby_c[pkg] = 0
                    grace_t[pkg] = time.monotonic() + JOIN_GRACE_PERIOD
                    package_statuses[pkg] = {"Username": get_username(uid), "Status": f"{LY}Rejoining ({reason})...{RS}"}
                    if len(rejoin_queue) > 1:
                        if stop_event.wait(REJOIN_SPACING):
                            return
        except Exception as err:
            msg(_tr('Loi vong lap Auto Rejoin: ') + f'{err}' + _tr('. Dang tu khoi phuc...'), "err")
            if stop_event.wait(2):
                break
        if stop_event.wait(max(0.2, TIME_RETRY)):
            break
