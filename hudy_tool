    if cap in ("captcha", "proofofwork", "proofofspace"):
        captcha_packages[pkg] = True
        if auto_switch_acc and _perform_account_switch(pkg, slmap, reason="Account Captcha"):
            captcha_packages.pop(pkg, None)
            return "switched"
        return "captcha"
    return "ok"
def auto_rejoin_loop(accounts, slmap, stop_event=None):
