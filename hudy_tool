    @staticmethod
    def verify_cookie(ck, retries=2):
        ck = CookieInjector._clean_cookie(ck)
        if not ck:
            return False
        retries = max(1, int(retries))
        for attempt in range(retries):
            status = None
            try:
                r = requests.get(
                    "https://users.roblox.com/v1/users/authenticated",
                    cookies={".ROBLOSECURITY": ck},
                    headers={"User-Agent": "Mozilla/5.0 (Linux; Android 10; Mobile)"},
                    timeout=10
                )
                status = r.status_code
                if status == 200:
                    data = r.json()
                    uid = data.get("id") if isinstance(data, dict) else None
                    return uid if type(uid) is int and uid > 0 else False
                if status in (401, 403):
                    return False
                if status == 429 and attempt + 1 < retries:
                    try:
                        delay = max(1, min(8, float(r.headers.get("Retry-After", 3))))
                    except (ValueError, TypeError):
                        delay = 3
                    time.sleep(delay)
            except (requests.RequestException, ValueError):
                pass
            finally:
                if "r" in locals():
                    r.close()
            if attempt + 1 < retries and status != 429:
                time.sleep(1)
        return False
