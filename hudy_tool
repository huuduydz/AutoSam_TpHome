def check_account_health(pkg, slmap):
    ck = xuat(pkg)
    if not ck:
        return "ok"
    try:
        response = requests.get(
            "https://users.roblox.com/v1/users/authenticated",
            cookies={".ROBLOSECURITY": ck}, timeout=10
        )
    except requests.RequestException:
        return "network_error"
    if response.status_code == 401:
        if auto_switch_acc and _perform_account_switch(pkg, slmap, reason="Dead Cookie"):
            return "switched"
        return "dead_cookie"
    if response.status_code != 200:
        return "network_error"
    if auto_unwarn_enable:
        unwarn(ck, pkg)
    if is_banned(ck):
        if auto_switch_acc and _perform_account_switch(pkg, slmap, reason="Account Banned"):
            return "switched"
        return "banned"
