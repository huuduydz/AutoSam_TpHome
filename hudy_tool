def compare_versions(v1, v2):
    p1, p2 = [int(x) for x in v1.split(".")], [int(x) for x in v2.split(".")]
    width = max(len(p1), len(p2))
    p1 += [0] * (width - len(p1))
    p2 += [0] * (width - len(p2))
    return (p1 > p2) - (p1 < p2)
