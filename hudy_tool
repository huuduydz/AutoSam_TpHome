            value = value[value.index("_|WARNING"):]
        elif ".ROBLOSECURITY=" in value:
            value = value.split(".ROBLOSECURITY=", 1)[1]
        elif value.count(":") >= 2:
            value = value.split(":", 2)[2]
        value = value.split(";", 1)[0].strip().strip('"\'')
        if not value or len(value) > 4096 or any(ord(c) < 33 or ord(c) > 126 for c in value):
            return ""
        return value
