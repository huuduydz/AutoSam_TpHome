                package_statuses.pop(pkg, None)
                offline_c.pop(pkg, None)
                lobby_c.pop(pkg, None)
                grace_t.pop(pkg, None)
                account_uids.pop(pkg, None)
                pending_log_rejoin.pop(pkg, None)
                pending_rejoin.pop(pkg, None)
            if sys_info["ram_pct"] > 85.0 or (now - last_gc > 300):
                gc.collect()
                last_gc = now
            prefix = load_package_prefix()
            running_pkgs = get_all_running_packages(prefix)
