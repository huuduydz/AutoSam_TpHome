def handle_list_packages():
    global rejoin_packages
    pkgs = get_roblox_packages()
    if not pkgs:
        msg(_tr('Khong co package!'), "err")
        wait_back_menu()
        return
    divider("-", 62, LB)
    for i, pkg in enumerate(pkgs, 1):
        mark = "+" if pkg in rejoin_packages else " "
        print(f"{LY}  [{mark}] {i}. {LW}{pkg}{RS}")
    divider("-", 62, LB)
    c = prompt(_tr('So (cach phay) hoac "all":')).strip()
    if c.lower() == "all":
        rejoin_packages = list(pkgs)
    else:
        try:
            idxs = [int(x.strip()) - 1 for x in c.split(",")]
            rejoin_packages = [pkgs[i] for i in idxs if 0 <= i < len(pkgs)]
        except Exception:
            msg(_tr('Khong hop le!'), "err")
            wait_back_menu()
            return
    msg(_tr('Da chon ') + f'{len(rejoin_packages)}' + ' package(s).', "ok")
    wait_back_menu()
def main():
    load_config()
    while not check_version():
        try:
            if prompt(_tr('Enter thu lai kiem tra phien ban; 0 de thoat:')).strip() == "0":
                return
        except (EOFError, KeyboardInterrupt):
            return
    if not verify_user_token():
        return
    threading.Thread(target=check_update, daemon=True).start()
    load_config()
    threading.Thread(target=auto_install_helper, daemon=True).start()
    wh_url, wh_dev, wh_iv = load_config()
    if wh_url and wh_dev and wh_iv:
        threading.Thread(target=webhook_loop, args=(wh_url, wh_dev, wh_iv), daemon=True).start()
    _zm_start()
    handlers = {
        "1": handle_auto_rejoin,
        "2": handle_setup,
        "3": handle_delete,
        "4": handle_webhook,
        "5": handle_view_saved,
        "6": handle_package_prefix,
        "7": handle_cookie,
        "8": handle_delete_cache,
        "9": handle_turn_on_all,
        "10": handle_configure_delay,
        "11": handle_import_script,
        "12": logout_all_roblox,
        "13": handle_auto_android_id,
        "14": handle_list_packages,
        "16": handle_language,
    }
    while True:
        banner()
        show_menu()
        try:
            choice = input(f"{LY}  >> {LW}").strip()
        except (KeyboardInterrupt, EOFError):
            msg(_tr('Tam biet!'), "ok")
            break
        if choice == "15":
            msg(_tr('Tam biet!'), "ok")
            break
        elif choice in handlers:
            try:
                handlers[choice]()
            except Exception as e:
                msg(_tr('Loi thuc thi menu: ') + f'{e}', "err")
                time.sleep(2)
        else:
            msg(_tr('Lua chon khong hop le!'), "err")
            time.sleep(1)
if __name__ == "__main__":
    try:
        main()
    finally:
        _zm_stop.set()
        if _zm_stop_main_event_ref is not None:
            _zm_stop_main_event_ref.set()
        if _webhook_stop is not None:
