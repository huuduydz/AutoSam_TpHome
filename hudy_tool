def scan_exec_dirs():
    global detected_exec_dirs
    base_path = "/storage/emulated/0"
    system_dirs = {
        "dcim", "mt2", "audiobooks", "music", "podcasts", "android", "pictures",
        "documents", "ringtones", "movies", "notifications", "alarms", "download"
    }
    found = {}
    for exec_name, autoexec_path in EXECUTORS.items():
        parent_dir = os.path.dirname(autoexec_path.rstrip("/"))
        if os.path.exists(parent_dir):
            entry_map = {}
            if os.path.exists(autoexec_path):
                entry_map["autoexec"] = autoexec_path
            for sub_name in ("Workspace", "workspace", "scripts"):
                ws_candidate = os.path.join(parent_dir, sub_name)
                if os.path.exists(ws_candidate):
                    entry_map["workspace"] = ws_candidate
                    break
            if entry_map:
                found[exec_name] = entry_map
    try:
        if os.path.exists(base_path):
            for entry in os.scandir(base_path):
                if not entry.is_dir() or entry.name.lower() in system_dirs:
                    continue
                try:
                    for sub in os.scandir(entry.path):
                        if not sub.is_dir():
                            continue
                        norm = re.sub(r"[ _]", "", sub.name.lower())
                        if "autoexec" in norm or "autoexecute" in norm:
                            found.setdefault(entry.name, {})["autoexec"] = sub.path
                        elif "workspace" in norm:
                            found.setdefault(entry.name, {})["workspace"] = sub.path
                        elif "internals" in norm:
                            found.setdefault(entry.name, {})["internals"] = sub.path
                except Exception:
                    pass
    except Exception:
        pass
    detected_exec_dirs = found
    return found
