            if r.status_code != 200:
                raise ValueError("HTTP " + str(r.status_code))
            data = r.json()
        if not isinstance(data, dict) or type(data.get("needpremium")) is not bool:
            raise ValueError("version.json: needpremium must be boolean")
        latest = data.get("version")
        if not isinstance(latest, str) or not re.fullmatch(r"[0-9]+(?:\.[0-9]+){0,3}", latest.strip()):
            raise ValueError("version.json: invalid version")
        latest = latest.strip()
        if str(data.get("status", "active")).lower() in ("disabled", "blocked", "inactive"):
            msg(_tr('Tool da bi vo hieu hoa.'), "err")
            return False
        if compare_versions(CURRENT_VERSION, latest) < 0:
            msg(_tr('Phien ban hien tai: ') + f'{CURRENT_VERSION}' + _tr('. Can cap nhat: ') + f'{latest}' + '.', "err")
            msg("", "info")
            return False
        NEED_PREMIUM = data["needpremium"]
        return True
    except (requests.RequestException, ValueError, TypeError) as e:
        msg(_tr('Khong doc duoc chinh sach phien ban: ') + f'{type(e).__name__}: {str(e)[:120]}', "err")
