def get_system_info():
    cpu = 0.0
    try:
        cpu = psutil.cpu_percent(interval=None)
    except Exception:
        pass
    ram_pct = 0.0
    try:
        mem = psutil.virtual_memory()
        ram_pct = mem.percent
    except Exception:
        try:
            with open("/proc/meminfo", "r") as f:
                lines = f.readlines()
            total, free = 0, 0
            available = None
            for line in lines:
                if "MemTotal:" in line:
                    total = int(line.split()[1])
                elif line.startswith("MemAvailable:"):
                    available = int(line.split()[1])
                elif line.startswith("MemFree:"):
                    free = int(line.split()[1])
            if available is not None:
                free = available
            if total > 0:
                ram_pct = round(((total - free) / total) * 100, 1)
        except Exception:
            pass
    disk_pct = 0.0
    try:
        du = shutil.disk_usage("/sdcard")
        disk_pct = round((du.used / du.total) * 100, 1)
    except Exception:
        try:
            du = shutil.disk_usage("/")
            disk_pct = round((du.used / du.total) * 100, 1)
        except Exception:
            pass
    bat_s = "100%"
    found_bat = False
    for b_path in ["/sys/class/power_supply/battery/capacity", "/sys/class/power_supply/bms/capacity"]:
        if os.path.exists(b_path):
            try:
                with open(b_path, "r") as f:
                    val = f.read().strip()
                    if val.isdigit():
                        bat_s = val + "%"
                        found_bat = True
                        break
            except Exception:
                pass
    if not found_bat:
        for cmd in ["dumpsys battery", "su -c dumpsys battery"]:
            try:
                r = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=2)
                if r.returncode == 0 and r.stdout:
                    m = re.search(r'level:\s*(\d+)', r.stdout, re.IGNORECASE)
                    if m:
                        bat_s = m.group(1) + "%"
                        found_bat = True
                        break
            except Exception:
                pass
    if not found_bat:
        try:
            bat = psutil.sensors_battery()
            if bat and bat.percent is not None:
                bat_s = f"{bat.percent:.0f}%"
        except Exception:
            pass
    uptime_h = 0.0
    try:
        uptime_h = (time.time() - psutil.boot_time()) / 3600
    except Exception:
        try:
            with open("/proc/uptime", "r") as f:
                uptime_h = float(f.readline().split()[0]) / 3600
        except Exception:
            pass
    return {
        "cpu": cpu,
        "ram_pct": ram_pct,
        "disk_pct": disk_pct,
        "battery": bat_s,
        "uptime_h": round(uptime_h, 1)
    }
def get_memory_usage(pid):
    mem_usage = 0.0
    cpu = 0.0
    try:
        with open(f"/proc/{pid}/status", "r") as f:
            for line in f:
                if line.startswith("VmRSS:"):
                    rss_kb = int(line.split()[1])
                    mem_usage = round(rss_kb / 1024, 2)
                    break
        def read_proc():
            with open(f"/proc/{pid}/stat", "r") as f:
                parts = f.readline().rsplit(")", 1)[1].split()
            return int(parts[11]) + int(parts[12]), time.monotonic()
        p1, t1 = read_proc()
        time.sleep(0.2)
        p2, t2 = read_proc()
        if t2 > t1:
            cpu = round(max(0, p2 - p1) * 100 / os.sysconf("SC_CLK_TCK") / (t2 - t1), 2)
    except Exception:
        pass
    return {"mem_usage": mem_usage, "cpu": cpu}
