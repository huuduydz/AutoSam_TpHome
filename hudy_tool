def check_package_log_status(pkg):
    log_dir = f"/data/data/{pkg}/files/logs"
    try:
        files = [os.path.join(log_dir, f) for f in os.listdir(log_dir) if f.endswith(".log")]
        if not files:
            return "ok"
        latest_file = max(files, key=os.path.getmtime)
        with open(latest_file, "rb") as f:
            stat = os.fstat(f.fileno())
            previous = _log_offsets.get(pkg)
            start = max(0, stat.st_size - 8192)
            if previous and previous[:2] == (latest_file, stat.st_ino) and previous[2] <= stat.st_size:
                if previous[2:] == (stat.st_size, stat.st_mtime_ns):
                    return "ok"
                if previous[2] < stat.st_size:
                    start = max(start, previous[2])
            f.seek(start)
            raw = f.read(8192).decode("utf-8", errors="ignore")
            _log_offsets[pkg] = (latest_file, stat.st_ino, stat.st_size, stat.st_mtime_ns)
        if time.time() - stat.st_mtime > 40:
            return "ok"
        if re.search(r"(?i)\b(?:disconnected|disconnecting|connectionlost|lost connection)\b|\b(?:kicked|kick|disconnect)\b[^\n]{0,100}\b(?:reason|code|error|idle|afk|timeout)\b|\berror\s*(?:code)?\s*[:=]\s*(?:267|268|273|277|278|279)\b", raw):
