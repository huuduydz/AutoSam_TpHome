def _custom_popen(args, *pargs, **kwargs):
    env = kwargs.pop("env", None)
    env = dict(os.environ if env is None else env)
    cmd = args if isinstance(args, (str, bytes, os.PathLike)) else (args[0] if args else "")
    cmd = os.fsdecode(cmd)
    try:
        cmd_first = shlex.split(cmd)[0] if cmd.strip() else ""
    except ValueError:
        cmd_first = cmd.split()[0] if cmd.strip() else ""
    is_system = cmd_first.startswith("/system/") or os.path.basename(cmd_first) in system_cmds
    if is_system:
        env.pop("LD_LIBRARY_PATH", None)
        env.pop("LD_PRELOAD", None)
        if os.path.isdir("/system/bin"):
            env["PATH"] = "/system/bin:/system/xbin:/vendor/bin:" + env.get("PATH", "")
    return _orig_popen(args, *pargs, env=env, **kwargs)
