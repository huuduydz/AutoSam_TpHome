    rows = max(1, math.ceil(tab_count / cols))
    tab_width = int(screen_width / cols)
    tab_height = int(screen_height / rows)
    positions = []
    for row in range(rows):
        for col in range(cols):
            if len(positions) < tab_count:
                left = col * tab_width
                top = row * tab_height
                right = left + tab_width
                bottom = top + tab_height
                positions.append((left, top, right, bottom))
