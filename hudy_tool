def _token_error(data, token):
    if not isinstance(data, dict):
        return ""
    detail = data.get("error") or data.get("message") or data.get("detail")
    if isinstance(detail, dict):
        detail = detail.get("message") or detail.get("code")
    if not isinstance(detail, str):
        return ""
    if token:
        detail = detail.replace(token, "[REDACTED]")
    detail = re.sub(r"\x1b(?:\[[0-?]*[ -/]*[@-~]|\][^\x07]*(?:\x07|$))", "", detail)
    detail = re.sub(r"[\x00-\x1f\x7f-\x9f]", " ", detail)
    detail = re.sub(r"(?i)(token|api[_ -]?key|password)(\s*[:=]\s*)[^\s]+", r"\1\2[REDACTED]", detail)
    return " ".join(detail.split())[:240]
