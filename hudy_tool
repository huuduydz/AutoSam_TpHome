def handle_auto_rejoin():
    global _zm_stop_main_event_ref
    accounts = load_accounts()
    server_links = load_server_links()
    if not accounts or not server_links:
        msg(_tr('Chua co UID hoac Link Server! Vao lenh 2 de setup.'), "err")
        wait_back_menu()
        return
    slmap = {pkg: lnk for pkg, lnk in server_links}
    if len(server_links) == 1:
        slmap["__all__"] = server_links[0][1]
    stop_event = threading.Event()
    _zm_stop_main_event_ref = stop_event
    threads = [
        threading.Thread(target=loop_captcha, args=(stop_event,), daemon=True),
        threading.Thread(target=loop_block, args=(stop_event,), daemon=True),
        threading.Thread(target=rotate_loop, args=(slmap, stop_event), daemon=True),
    ]
    try:
        for thread in threads:
            thread.start()
        banner()
        while not stop_event.is_set() and not _zm_stop.is_set():
            try:
                auto_rejoin_loop(accounts, slmap, stop_event)
            except KeyboardInterrupt:
                msg(_tr('Dung auto rejoin.'), "warn")
                break
            except Exception as e:
                msg('Auto Rejoin crash: ' + f'{e}' + _tr('. Tap trung khoi dong lai...'), "err")
                if stop_event.wait(2):
                    break
    finally:
        stop_event.set()
        for thread in threads:
            while thread.is_alive():
                try:
                    thread.join(0.2)
                except KeyboardInterrupt:
                    stop_event.set()
        if _zm_stop_main_event_ref is stop_event:
            _zm_stop_main_event_ref = None
    wait_back_menu()
