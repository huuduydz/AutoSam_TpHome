#!/data/data/com.termux/files/usr/bin/bash

# =====================================================================
# HUDY TOOL REJOIN SETUP SCRIPT FOR TERMUX (HIGH-SPEED & VISIBLE PROGRESS)
# =====================================================================

C_CYAN="\033[1;36m"
C_GREEN="\033[1;32m"
C_YELLOW="\033[1;33m"
C_RED="\033[1;31m"
C_RESET="\033[0m"

echo -e "${C_CYAN}[*] Đang kiểm tra & khởi tạo môi trường Termux cho HuDy Tool...${C_RESET}"

# 1. Dọn dẹp tiến trình apt/dpkg bị treo & xóa file lock cũ
killall -9 apt apt-get dpkg dpkg-deb >/dev/null 2>&1 || true
rm -f /data/data/com.termux/files/usr/var/lib/dpkg/lock*
rm -f /data/data/com.termux/files/usr/var/cache/apt/archives/lock
rm -f /data/data/com.termux/files/usr/var/lib/apt/lists/lock

# 2. Đảm bảo có curl trước khi tải mirror/script
if ! command -v curl >/dev/null 2>&1; then
    echo -e "${C_CYAN}[*] Đang cài đặt gói cơ bản (curl)...${C_RESET}"
    pkg update -y -o Dpkg::Options::="--force-confold" >/dev/null 2>&1 || true
    pkg install -y -o Dpkg::Options::="--force-confold" curl || true
fi

# 3. Yêu cầu quyền bộ nhớ (Thông báo rõ ràng tránh treo chờ popup)
if [ ! -d "$HOME/storage" ]; then
    echo -e "${C_YELLOW}[!] NẾU HỆ ĐIỀU HÀNH HIỆN POPUP HỎI QUYỀN BỘ NHỚ -> HÃY BẤM 'CHO PHÉP' (ALLOW)...${C_RESET}"
    termux-setup-storage
    sleep 2
fi

# 4. Chạy script đổi mirror Termux
echo -e "${C_CYAN}[*] Đang thiết lập mirror Termux tối ưu...${C_RESET}"
MIRROR_TMP="$(mktemp)"
if curl -fsSL https://raw.githubusercontent.com/huuduydz/AutoSam_TpHome/refs/heads/main/termux-change-repo.sh -o "$MIRROR_TMP"; then
    . "$MIRROR_TMP"
fi
rm -f "$MIRROR_TMP"

# 5. Cập nhật gói hệ thống & cài đặt phụ thuộc Termux
export DEBIAN_FRONTEND=noninteractive
echo -e "${C_CYAN}[*] Đang tải & cài đặt gói hệ thống (python, sqlite, tsu, curl, procps)...${C_RESET}"
echo -e "${C_YELLOW}[i] Quá trình này tải khoảng 30-50MB, vui lòng chờ trong giây lát...${C_RESET}"

pkg update -y -o Dpkg::Options::="--force-confold"
pkg install -y -o Dpkg::Options::="--force-confold" python sqlite tsu curl ncurses-utils procps
# Cài gói Pillow/psutil build sẵn của Termux nếu có (tránh lỗi compile trên Android)
pkg install -y -o Dpkg::Options::="--force-confold" python-pillow >/dev/null 2>&1 || true
pkg install -y -o Dpkg::Options::="--force-confold" python-psutil >/dev/null 2>&1 || true

# 6. Cài đặt thư viện Python cần thiết cho HuDy Tool
echo -e "${C_CYAN}[*] Đang cài đặt thư viện Python (requests, colorama, psutil, pillow)...${C_RESET}"
pip install --no-cache-dir --upgrade pip >/dev/null 2>&1 || true
if ! pip install --no-cache-dir requests colorama; then
    echo -e "${C_RED}[✗] Cài đặt requests / colorama thất bại! Vui lòng kiểm tra mạng.${C_RESET}"
    exit 1
fi
# Thư viện tùy chọn (dùng cho thống kê hệ thống & nén ảnh screenshot webhook)
pip install --no-cache-dir psutil pillow >/dev/null 2>&1 || true

# 7. Tải HuDy Tool mới nhất (hudy_tool là file Python chính)
echo -e "${C_CYAN}[*] Đang tải file script HuDy Tool (hudy.py)...${C_RESET}"
if ! curl -fLs https://raw.githubusercontent.com/huuduydz/AutoSam_TpHome/refs/heads/main/hudy_tool -o ~/hudy.py || [ ! -s ~/hudy.py ]; then
    echo -e "${C_RED}[✗] Không thể tải HuDy Tool từ GitHub (file trống hoặc lỗi mạng).${C_RESET}"
    exit 1
fi
if head -n 1 ~/hudy.py | grep -q '^#!.*bash'; then
    echo -e "${C_RED}[✗] File tải về là bash script chứ không phải Python! Kiểm tra lại URL trên GitHub.${C_RESET}"
    exit 1
fi
chmod +x ~/hudy.py

# 8. Thiết lập Alias tự động
if ! grep -q 'alias hudy=' ~/.bashrc 2>/dev/null; then
    echo 'alias hudy="cd ~ && python ~/hudy.py"' >> ~/.bashrc
fi
if ! grep -q 'alias hudy4=' ~/.bashrc 2>/dev/null; then
    echo 'alias hudy4="cd ~ && python ~/hudy.py"' >> ~/.bashrc
fi

# Nạp alias vào phiên làm việc hiện tại
alias hudy="cd ~ && python ~/hudy.py" 2>/dev/null || true
alias hudy4="cd ~ && python ~/hudy.py" 2>/dev/null || true

echo -e "\n${C_GREEN}[✓] SETUP HUDY TOOL THÀNH CÔNG HOÀN TẤT!${C_RESET}"
echo -e "${C_YELLOW}[i] Bạn có thể gõ ngay lệnh: ${C_CYAN}hudy${C_YELLOW} (hoặc ${C_CYAN}python ~/hudy.py${C_YELLOW}) để mở tool.${C_RESET}\n"
